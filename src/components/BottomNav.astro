---
import Icon from './Icon.astro';
import { NAV, BOOKMARKS, type NavKey } from '../lib/nav';
import { url } from '../lib/posts';
interface Props { active?: NavKey }
const { active } = Astro.props;
const items = [NAV[0], NAV[1], BOOKMARKS, NAV[4]];
---
<nav class="bottom-nav" aria-label="주 메뉴">
  {items.map((n) => (
    <a href={url(n.path)} class:list={['item', { active: active === n.key }]} aria-current={active === n.key ? 'page' : undefined}>
      <Icon name={n.icon} size={22} />
      <span class="label">{n.label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: flex;
    height: calc(64px + env(safe-area-inset-bottom));
    padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--sidebar) 92%, transparent);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--sidebar-border);
  }
  @media (min-width: 1024px) { .bottom-nav { display: none; } }
  .item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border-radius: var(--radius-md); color: var(--muted-foreground); }
  .item.active { color: var(--sidebar-primary); }
  .label { font-size: 11px; font-weight: 600; }
</style>
