---
import { NAV, type NavKey } from '../lib/nav';
import { url } from '../lib/posts';
interface Props { active?: NavKey }
const { active } = Astro.props;
---
<nav class="bottom-nav" aria-label="주 메뉴">
  {NAV.map((n) => (
    <a href={url(n.path)} class:list={['item', { active: active === n.key }]} aria-current={active === n.key ? 'page' : undefined}>
      <span class="indicator state"><span class:list={['msr', { fill: active === n.key }]}>{n.icon}</span></span>
      <span class="label-m">{n.label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: flex;
    height: calc(80px + env(safe-area-inset-bottom));
    padding: 12px 8px calc(16px + env(safe-area-inset-bottom));
    background: var(--md-surface-container);
    box-shadow: 0 -1px 0 var(--md-outline-variant);
  }
  @media (min-width: 840px) { .bottom-nav { display: none; } }

  .item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--md-on-surface-variant); }
  .indicator { display: grid; place-items: center; width: 64px; height: 32px; border-radius: var(--md-shape-full); }
  .item.active { color: var(--md-on-surface); }
  .item.active .indicator { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
  .item.active .label-m { font-weight: 700; }
</style>
