---
import { SITE } from '../site.config';
const g = SITE.giscus;
const enabled = Boolean(g.repoId && g.categoryId);
---
{enabled && (
  <section class="comments" aria-label="댓글">
    <h2 class="title-l">댓글</h2>
    <div data-giscus data-repo={g.repo} data-repo-id={g.repoId} data-category={g.category} data-category-id={g.categoryId}></div>
  </section>
)}

<script>
  const host = document.querySelector<HTMLElement>('[data-giscus]');
  // giscus 는 커스텀 테마를 iframe 안에서 CORS 로 불러온다. 절대 URL 이어야 하고 파일은 public/giscus 에 있다.
  // ⚠️ 로컬 dev 서버는 giscus.app 에 CORS 를 열어 주지 않아 테마가 깨진다 → dev 에서는 기본 테마로 대체.
  const themeOf = () => {
    const mode = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    if (import.meta.env.DEV) return mode;
    return new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/giscus/${mode}.css`, location.origin).href;
  };
  if (host) {
    const d = host.dataset;
    const s = document.createElement('script');
    const attrs: Record<string, string> = {
      'data-repo': d.repo!,
      'data-repo-id': d.repoId!,
      'data-category': d.category!,
      'data-category-id': d.categoryId!,
      'data-mapping': 'pathname',
      'data-strict': '1',
      'data-reactions-enabled': '1',
      'data-input-position': 'top',
      'data-theme': themeOf(),
      'data-lang': 'ko',
      'data-loading': 'lazy',
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    s.src = 'https://giscus.app/client.js';
    s.crossOrigin = 'anonymous';
    s.async = true;
    host.append(s);

    // 사이트 테마를 바꾸면 giscus iframe 도 따라가게 한다
    const sync = () =>
      document
        .querySelector<HTMLIFrameElement>('iframe.giscus-frame')
        ?.contentWindow?.postMessage({ giscus: { setConfig: { theme: themeOf() } } }, 'https://giscus.app');
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    // ⚠️ 로딩 중에 보낸 setConfig 는 버려진다. giscus 가 첫 메시지를 보내면(준비 완료) 한 번 더 맞춘다.
    const onReady = (e: MessageEvent) => {
      if (e.origin !== 'https://giscus.app') return;
      removeEventListener('message', onReady);
      sync();
    };
    addEventListener('message', onReady);
  }
</script>

<style>
  .comments { margin-top: 56px; }
  h2 { margin: 0 0 16px; }
</style>
