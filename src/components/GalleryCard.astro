---
import Icon from './Icon.astro';
import Thumbnail from './Thumbnail.astro';
import { postUrl, readingMinutes, type Post } from '../lib/posts';

// 글 카드: 모든 카드가 같은 크기. 위에 16:9 썸네일, 아래에 분류·제목·요약·날짜(일반적인 기술 블로그 목록 형태)
interface Props {
  post: Post;
  eager?: boolean;
  hidden?: boolean;
}
const { post, eager = false, hidden } = Astro.props;
const { title, description, date, category, pinned, draft } = post.data;
const ymd = date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
const minutes = readingMinutes(post.body);
---
<article class="card-post" data-card data-id={post.id} data-category={category} data-date={date.valueOf()} data-minutes={minutes} hidden={hidden}>
  <a class="thumb-wrap" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    <Thumbnail post={post} text={false} eager={eager} sizes="(min-width: 1200px) 380px, (min-width: 640px) 45vw, 100vw" />
    <span class="flags">
      {draft && <span class="flag draft">초안</span>}
      {pinned && !draft && <span class="flag"><Icon name="pin" size={11} />고정</span>}
      <span class="flag clear"><Icon name="check" size={11} stroke={3} />읽음</span>
    </span>
  </a>
  <div class="body">
    <span class="cat">{category}</span>
    <h3 class="title"><a href={postUrl(post)}>{title}</a></h3>
    <p class="desc">{description}</p>
    <div class="foot">
      <span class="meta"><time datetime={date.toISOString()}>{ymd}</time><span aria-hidden="true">·</span>{minutes}분 읽기</span>
      <button class="bm" type="button" data-bookmark={post.id} aria-label="북마크" aria-pressed="false"><Icon name="bookmark" size={17} /></button>
    </div>
  </div>
</article>

<style>
  .card-post {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    overflow: hidden;
    transition: translate 250ms var(--ease-out), box-shadow 250ms var(--ease-out), border-color 250ms;
  }
  .card-post:hover { translate: 0 -4px; border-color: color-mix(in srgb, var(--brand) 55%, var(--border)); box-shadow: 0 18px 36px -18px rgb(0 0 0 / 0.55), 0 0 28px -12px var(--glow); }
  .card-post:hover :global(.thumb img) { transform: scale(1.04); }

  .thumb-wrap { position: relative; display: block; border-bottom: 1px solid var(--border); }
  .flags { position: absolute; left: 10px; top: 10px; display: flex; gap: 6px; }
  .flag { display: inline-flex; align-items: center; gap: 3px; padding: 3px 8px; border-radius: 6px; background: rgb(17 21 34 / 0.78); color: #e7ebf5; font-size: 11.5px; font-weight: 600; backdrop-filter: blur(6px); }
  .flag.draft { background: var(--amber); color: #111522; }
  .flag.clear { display: none; background: var(--mint); color: #111522; }
  :global(.is-read) .flag.clear { display: inline-flex; }

  .body { display: flex; flex-direction: column; gap: 8px; flex: 1; padding: 16px 18px 14px; }
  .cat { align-self: flex-start; font-size: 12.5px; font-weight: 700; color: var(--brand); }
  .title { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.45; letter-spacing: -0.02em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.9em; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .card-post:hover .title a { color: var(--brand); }
  .desc { margin: 0; font-size: 14px; line-height: 1.6; color: var(--muted-foreground); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3.2em; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--border); }
  .meta { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted-foreground); }
  .bm { position: relative; z-index: 1; display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--muted-foreground); cursor: pointer; transition: background var(--dur), color var(--dur); }
  .bm:hover { background: var(--accent); color: var(--foreground); }
  .bm[aria-pressed='true'] { color: var(--amber); }
</style>
