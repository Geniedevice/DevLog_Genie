---
import Icon from './Icon.astro';
import Thumbnail from './Thumbnail.astro';
import { postUrl, readingMinutes, type Post } from '../lib/posts';
import type { TileSize } from '../lib/gallery';

interface Props {
  post: Post;
  size?: TileSize;
  eager?: boolean;
  hidden?: boolean;
}
const { post, size = '', eager = false, hidden } = Astro.props;
const { title, description, date, category, pinned, draft } = post.data;
const md = date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' }).replace(/\s/g, '').replace(/\.$/, '');
const minutes = readingMinutes(post.body);
---
<article class:list={['tile', size]} data-card data-id={post.id} data-category={category} data-date={date.valueOf()} data-minutes={minutes} hidden={hidden}>
  <a class="tile-link" href={postUrl(post)} data-tilt>
    <Thumbnail post={post} fill text={false} eager={eager} sizes="(min-width: 1100px) 50vw, (min-width: 640px) 50vw, 100vw" />
    <span class="shade" aria-hidden="true"></span>
    <span class="flags" aria-hidden="true">
      {draft && <span class="flag draft pixel-font">DRAFT</span>}
      {pinned && !draft && <span class="flag pixel-font"><Icon name="pin" size={11} />PINNED</span>}
      <span class="flag clear pixel-font"><Icon name="check" size={11} stroke={3} />CLEAR</span>
    </span>
    <span class="body">
      <span class="cat">{category}</span>
      <h3 class="title">{title}</h3>
      <span class="desc">{description}</span>
      <span class="meta"><time datetime={date.toISOString()}>{md}</time><span aria-hidden="true">·</span>{minutes}분 읽기<span class="go pixel-font" aria-hidden="true">▶ OPEN</span></span>
    </span>
  </a>
  <button class="bm" type="button" data-bookmark={post.id} aria-label="북마크" aria-pressed="false"><Icon name="bookmark" size={17} /></button>
</article>

<style>
  .tile { position: relative; min-width: 0; perspective: 1000px; }
  .tile-link {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background: var(--muted);
    transform-style: preserve-3d;
    transition: border-color 250ms, box-shadow 300ms var(--ease-out);
  }
  .tile-link :global(.thumb) { position: absolute; inset: 0; }
  .tile-link :global(img) { transition: transform 700ms var(--ease-out), filter 400ms; }
  .tile:hover .tile-link { border-color: color-mix(in srgb, var(--brand) 70%, transparent); box-shadow: 0 24px 44px -20px rgb(0 0 0 / 0.75), 0 0 34px -10px var(--glow); }
  .tile:hover .tile-link :global(img) { transform: scale(1.07); }
  /* 빛 반사(기울기와 함께, src/scripts/micro.ts) */
  .tile-link::after { content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none; background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.14), transparent 55%); opacity: var(--glare, 0); transition: opacity 250ms; }

  /* 제목이 올라앉는 아래쪽 그늘. 올리면 더 짙어져 설명까지 읽힌다 */
  .shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgb(10 12 22 / 0.92) 0%, rgb(10 12 22 / 0.55) 38%, transparent 68%); transition: opacity 300ms; }
  .tile:hover .shade { background: linear-gradient(to top, rgb(10 12 22 / 0.95) 0%, rgb(10 12 22 / 0.7) 55%, rgb(10 12 22 / 0.15) 100%); }

  .flags { position: absolute; left: 12px; top: 12px; z-index: 2; display: flex; flex-wrap: wrap; gap: 6px; }
  .flag { display: inline-flex; align-items: center; gap: 4px; padding: 4px 7px; border-radius: 4px; background: var(--primary); color: var(--primary-foreground); font-size: 10px; letter-spacing: 0.12em; }
  .flag.draft { background: var(--amber); color: #111522; }
  .flag.clear { display: none; background: var(--mint); color: #111522; }
  :global(.is-read) .flag.clear { display: inline-flex; }

  .body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; flex-direction: column; gap: 6px; padding: 18px 18px 16px; color: #e7ebf5; transition: translate 400ms var(--ease-out); }
  .cat { align-self: flex-start; padding: 3px 9px; border-radius: 999px; background: rgb(169 155 232 / 0.22); border: 1px solid rgb(169 155 232 / 0.4); color: #d6ceff; font-size: 11.5px; font-weight: 600; backdrop-filter: blur(6px); }
  .title { margin: 0; font-size: 18px; font-weight: 800; line-height: 1.3; letter-spacing: -0.02em; text-shadow: 0 2px 12px rgb(0 0 0 / 0.6); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .desc { max-height: 0; overflow: hidden; opacity: 0; font-size: 13.5px; line-height: 1.55; color: rgb(231 235 245 / 0.8); transition: max-height 450ms var(--ease-out), opacity 300ms; }
  .tile:hover .desc, .tile-link:focus-visible .desc { max-height: 4.8em; opacity: 1; }
  .meta { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: rgb(231 235 245 / 0.7); }
  .go { margin-left: auto; font-size: 10px; letter-spacing: 0.16em; color: #8fd4c1; opacity: 0; translate: -6px 0; transition: opacity 250ms, translate 300ms var(--ease-out); }
  .tile:hover .go { opacity: 1; translate: 0 0; }

  /* 큰 타일: 제목·설명을 처음부터 크게 */
  .big .title { font-size: clamp(22px, 2.6vw, 32px); -webkit-line-clamp: 3; }
  .big .desc { max-height: 4.8em; opacity: 1; font-size: 15px; }
  .big .body { padding: 24px 24px 22px; }
  .wide .title { font-size: 20px; }

  .bm { position: absolute; top: 10px; right: 10px; z-index: 4; display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: var(--radius-md); background: rgb(10 12 22 / 0.65); backdrop-filter: blur(6px); color: #fff; cursor: pointer; opacity: 0; transition: opacity var(--dur), background var(--dur); }
  .tile:hover .bm, .bm:focus-visible, .bm[aria-pressed='true'] { opacity: 1; }
  .bm[aria-pressed='true'] { color: var(--amber); }
  @media (hover: none) { .bm { opacity: 1; } .desc { max-height: 4.8em; opacity: 1; } }
</style>
