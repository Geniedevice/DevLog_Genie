---
import Icon from './Icon.astro';
import Thumbnail from './Thumbnail.astro';
import { postUrl, readingMinutes, type Post } from '../lib/posts';

// 글 카드: 모든 카드가 같은 크기. 위에 16:9 썸네일, 아래에 분류·제목·요약·날짜(일반적인 기술 블로그 목록 형태)
interface Props {
  post: Post;
  eager?: boolean;
  hidden?: boolean;
  sizes?: string;
}
const { post, eager = false, hidden, sizes = '(min-width: 1200px) 400px, (min-width: 640px) 34vw, 100vw' } = Astro.props;
const { title, description, date, category, pinned, draft } = post.data;
const ymd = date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' });
const minutes = readingMinutes(post.body);
---
<article class="card-post" data-card data-id={post.id} data-category={category} data-date={date.valueOf()} data-minutes={minutes} hidden={hidden}>
  <a class="thumb-wrap" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    <Thumbnail post={post} text={false} eager={eager} sizes={sizes} />
    <span class="flags">
      {draft && <span class="flag draft">초안</span>}
      {pinned && !draft && <span class="flag"><Icon name="pin" size={11} />고정</span>}
      <span class="flag clear"><Icon name="check" size={11} stroke={3} />읽음</span>
    </span>
  </a>
  <div class="body">
    <h3 class="title"><a href={postUrl(post)}>{title}</a></h3>
    <p class="desc">{description}</p>
    <div class="foot">
      <span class="meta"><span class="cat">{category}</span><span aria-hidden="true">·</span><time datetime={date.toISOString()}>{ymd}</time><span aria-hidden="true">·</span>{minutes}분 읽기</span>
      <button class="bm" type="button" data-bookmark={post.id} aria-label="북마크" aria-pressed="false"><Icon name="bookmark" size={17} /></button>
    </div>
  </div>
</article>

<style>
  /* 한 줄에 글 하나: 사진(16:9) 왼쪽 · 제목과 요약 오른쪽. 상자 없이 줄 사이 가는 선으로 나눈다 */
  .card-post {
    position: relative;
    display: grid;
    gap: 14px;
    min-width: 0;
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 640px) { .card-post { grid-template-columns: minmax(200px, 34%) minmax(0, 1fr); gap: 28px; align-items: start; } }

  .thumb-wrap { position: relative; display: block; overflow: hidden; border-radius: var(--radius-lg); }
  .thumb-wrap :global(.thumb img) { transition: transform 600ms var(--ease-out); }
  .card-post:hover .thumb-wrap :global(.thumb img) { transform: scale(1.03); }
  .flags { position: absolute; left: 10px; top: 10px; display: flex; gap: 6px; }
  .flag { display: inline-flex; align-items: center; gap: 3px; padding: 3px 8px; border-radius: 6px; background: var(--night-scrim); color: var(--night-text); font-size: 13px; font-weight: 600; }
  .flag.draft { background: var(--night-amber); color: var(--night); }
  .flag.clear { display: none; background: var(--night-mint); color: var(--night); }
  :global(.is-read) .flag.clear { display: inline-flex; }

  .body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .cat { color: var(--brand); }
  .title { margin: 0; font-size: 20px; font-weight: 700; line-height: 1.4; letter-spacing: -0.01em; }
  .title a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 420ms var(--ease-out), color var(--dur); }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .card-post:hover .title a { background-size: 100% 1px; color: var(--brand); }
  .desc { margin: 0; font-size: 15px; line-height: 1.65; color: var(--muted-foreground); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  /* 날짜 · 분류가 제목 위(패치노트처럼 언제 무엇인지 먼저) */
  .foot { order: -1; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 13px; color: var(--muted-foreground); }
  .bm { position: relative; z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; margin: -6px -10px -6px 0; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--muted-foreground); cursor: pointer; transition: background var(--dur), color var(--dur); }
  .bm:hover { background: var(--accent); color: var(--foreground); }
  .bm[aria-pressed='true'] { color: var(--brand); }
</style>
