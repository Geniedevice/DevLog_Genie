---
// 키네틱 타이포 띠: 다루는 주제(태그)와 만든 게임 이름이 큰 글자로 왼쪽으로 흐른다.
// 기본 속도에 스크롤 속도가 더해지고, 빠를수록 글자가 기운다(애프터 이펙트의 속도 기반 기울기).
// 방향은 사이트 기본 흐름인 왼쪽 하나뿐이라 위로 스크롤해도 거꾸로 돌지 않는다.
interface Props { rows: string[][] }
const { rows } = Astro.props;
---
<section class="kinetic" aria-label="다루는 주제" data-kinetic>
  {rows.map((row, i) => (
    <div class:list={['row', `r${i}`]}>
      <div class="track" data-track>
        {[0, 1, 2].map((dup) => (
          <ul class="set" aria-hidden={dup ? 'true' : undefined}>
            {row.map((w) => <li>{w}<i class="sep" aria-hidden="true"></i></li>)}
          </ul>
        ))}
      </div>
    </div>
  ))}
</section>

<script>
  import { reduced } from '../scripts/fx';

  const root = document.querySelector<HTMLElement>('[data-kinetic]');
  const tracks = [...(root?.querySelectorAll<HTMLElement>('[data-track]') ?? [])];
  if (root && tracks.length && !reduced()) {
    const BASE = [0.55, 0.9]; // 줄마다 다른 기본 속도(px/16ms) — 가까운 줄이 빠르다
    const x = tracks.map(() => 0);
    let widths = tracks.map((t) => (t.firstElementChild as HTMLElement).offsetWidth);
    let v = 0, lastY = scrollY, last = performance.now(), raf = 0;

    const tick = (now: number) => {
      const dt = Math.min(48, now - last) / 16;
      last = now;
      v += (scrollY - lastY - v) * 0.12; // 부드럽게 만든 스크롤 속도
      lastY = scrollY;
      const skew = Math.max(-14, Math.min(14, -v * 0.35));
      tracks.forEach((t, i) => {
        x[i] = (x[i] - (BASE[i % BASE.length] + Math.abs(v) * 0.5) * dt) % (widths[i] || 1);
        t.style.transform = `translate3d(${x[i]}px,0,0) skewX(${skew}deg)`;
      });
      raf = requestAnimationFrame(tick);
    };
    // 화면에 있을 때만 돈다
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      if (e.isIntersecting) { last = performance.now(); lastY = scrollY; raf = requestAnimationFrame(tick); }
    }).observe(root);
    new ResizeObserver(() => (widths = tracks.map((t) => (t.firstElementChild as HTMLElement).offsetWidth))).observe(root);
  }
</script>

<style>
  .kinetic { overflow: hidden; padding: clamp(28px, 5vw, 64px) 0; border-block: 1px solid var(--border); user-select: none; }
  .row { overflow: hidden; }
  .track { display: flex; width: max-content; will-change: transform; }
  .set { display: flex; margin: 0; padding: 0; list-style: none; }
  .set li { display: flex; align-items: center; gap: 0.32em; padding-right: 0.32em; white-space: nowrap; font-size: clamp(44px, 8vw, 116px); font-weight: 700; line-height: 1.12; letter-spacing: -0.03em; }
  .sep { width: 0.16em; height: 0.16em; background: var(--brand); rotate: 45deg; flex: none; }
  /* 두 번째 줄: 외곽선 글자. 포인터가 닿은 단어만 채워진다 */
  .r1 .set li { color: transparent; -webkit-text-stroke: 1.5px var(--muted-foreground); transition: color var(--dur), -webkit-text-stroke-color var(--dur); }
  .r1 .set li:hover { color: var(--brand); -webkit-text-stroke-color: var(--brand); }
  .r1 .sep { background: var(--muted-foreground); }
  @media (prefers-reduced-motion: reduce) { .track { transform: none !important; } }
</style>
