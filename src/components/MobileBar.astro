---
import { SITE } from '../site.config';
import { url } from '../lib/posts';
---
<header class="mbar" data-top-bar>
  <a class="brand" href={url()}>
    <svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><use href="#logo" /></svg>
    <span>{SITE.title.toUpperCase()}</span>
  </a>
  <div class="actions">
    <button class="btn btn-ghost btn-icon" type="button" data-open-search aria-label="검색"><span class="msr">search</span></button>
    <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="낮·밤 전환">
      <span class="msr theme-night">dark_mode</span><span class="msr theme-day">light_mode</span>
    </button>
  </div>
</header>

<style>
  .mbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    padding: 0 8px 0 16px;
    background: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur);
  }
  .mbar.scrolled { border-bottom-color: var(--border); }
  @media (min-width: 1024px) { .mbar { display: none; } }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 800; letter-spacing: 0.06em; font-size: 15px; }
  .logo { width: 22px; height: 22px; color: var(--amber); }
  .actions { display: flex; gap: 2px; }
  .theme-day { display: none; }
  :global([data-theme='dark']) .theme-night { display: none; }
  :global([data-theme='dark']) .theme-day { display: inline-block; }
</style>
