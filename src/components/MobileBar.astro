---
import Icon from './Icon.astro';
import { SITE } from '../site.config';
import { url } from '../lib/posts';
---
<header class="mbar" data-top-bar>
  <a class="brand" href={url()}>
    <Icon name="moon" size={22} fill class="logo" />
    <span>{SITE.title}</span>
  </a>
  <div class="actions">
    <button class="btn btn-ghost btn-icon" type="button" data-open-search aria-label="검색"><Icon name="search" /></button>
    <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="낮·밤 전환">
      <span class="theme-night"><Icon name="moon" /></span><span class="theme-day"><Icon name="sun" /></span>
    </button>
  </div>
</header>

<style>
  .mbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    padding: 0 8px 0 16px;
    background: color-mix(in srgb, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur);
  }
  .mbar.scrolled { border-bottom-color: var(--border); }
  @media (min-width: 1024px) { .mbar { display: none; } }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 800; letter-spacing: -0.015em; font-size: 18px; }
  .brand :global(.logo) { color: var(--brand); }
  .actions { display: flex; gap: 2px; }
  .theme-day { display: none; }
  :global([data-theme='dark']) .theme-night { display: none; }
  :global([data-theme='dark']) .theme-day { display: inline-flex; }
</style>
