---
import { NAV, type NavKey } from '../lib/nav';
import { url } from '../lib/posts';
interface Props { active?: NavKey }
const { active } = Astro.props;
---
<nav class="rail" aria-label="주 메뉴">
  <a class="rail-logo" href={url()} aria-label="길드 홀로">
    <svg viewBox="0 0 48 48" aria-hidden="true"><use href="#emblem" /></svg>
  </a>
  <button class="orb" type="button" data-open-search aria-label="수정구슬 검색">
    <span class="msr">search</span>
  </button>
  <ul class="items">
    {NAV.map((n) => (
      <li>
        <a href={url(n.path)} class:list={['item', { active: active === n.key }]} aria-current={active === n.key ? 'page' : undefined}>
          <span class="indicator"><span class:list={['msr', { fill: active === n.key }]}>{n.icon}</span></span>
          <span class="label">{n.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100dvh;
    width: 92px;
    flex: none;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 20px 0;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.015) 0 2px, transparent 2px 6px),
      var(--sidebar);
    color: var(--sidebar-foreground);
    border-right: 1px solid color-mix(in srgb, var(--gold) 35%, transparent);
    box-shadow: inset -8px 0 20px -12px rgb(0 0 0 / 0.6);
  }
  @media (min-width: 900px) { .rail { display: flex; } }

  .rail-logo svg { width: 48px; height: 48px; filter: drop-shadow(0 4px 10px var(--glow)); transition: transform 400ms var(--ease-out); }
  .rail-logo:hover svg { transform: rotate(-8deg) scale(1.08); }

  /* 수정구슬 */
  .orb {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 14px;
    border: 1px solid color-mix(in srgb, var(--arcane) 60%, transparent);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff8 0 6%, transparent 18%), radial-gradient(circle at 50% 60%, var(--arcane), #2a1860 75%);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 0 18px -2px color-mix(in srgb, var(--arcane) 70%, transparent);
    animation: orb 4s ease-in-out infinite;
  }
  .orb:hover { box-shadow: 0 0 28px 2px color-mix(in srgb, var(--arcane) 80%, transparent); }
  @keyframes orb { 50% { box-shadow: 0 0 26px 2px color-mix(in srgb, var(--arcane) 60%, transparent); } }

  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .item { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 80px; color: color-mix(in srgb, var(--sidebar-foreground) 70%, transparent); transition: color var(--dur); }
  .indicator { display: grid; place-items: center; width: 52px; height: 34px; border-radius: var(--radius-md); border: 1px solid transparent; transition: background var(--dur), border-color var(--dur); }
  .item:hover { color: var(--sidebar-foreground); }
  .item:hover .indicator { background: var(--sidebar-accent); }
  .item.active { color: var(--sidebar-primary); }
  .item.active .indicator { background: var(--sidebar-accent); border-color: color-mix(in srgb, var(--gold) 60%, transparent); box-shadow: 0 0 14px -4px var(--glow); }
  .label { font: 600 12px/1 var(--font-serif); }
</style>
