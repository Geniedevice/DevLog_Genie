---
interface Props { title: string; subtitle?: string; icon: string }
const { title, subtitle, icon } = Astro.props;
---
<header class="page-header">
  <span class="icon" aria-hidden="true"><span class="msr">{icon}</span></span>
  <div>
    <h1 class="headline-l">{title}</h1>
    {subtitle && <p class="body-l">{subtitle}</p>}
  </div>
</header>

<style>
  .page-header { display: flex; align-items: center; gap: 20px; padding: 24px 0 32px; }
  .icon { display: grid; place-items: center; width: 64px; height: 64px; flex: none; border-radius: var(--md-shape-lg); background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); }
  .icon .msr { font-size: 32px; }
  h1 { margin: 0; }
  p { margin: 4px 0 0; color: var(--md-on-surface-variant); }
</style>
