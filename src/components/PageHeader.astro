---
interface Props { title: string; subtitle?: string }
const { title, subtitle } = Astro.props;
---
<header class="page-header">
  <h1 data-headline>{title}</h1>
  {subtitle && <p class="sub" data-reveal>{subtitle}</p>}
</header>

<script>
  import { headline } from '../scripts/fx';
  headline(document.querySelector('.page-header [data-headline]'), 50);
</script>

<style>
  .page-header { padding: 40px 0 28px; }
  h1 { margin: 0; font-size: clamp(30px, 4vw, 42px); font-weight: 800; letter-spacing: -0.018em; line-height: 1.2; }
  .sub { margin: 8px 0 0; color: var(--muted-foreground); font-size: 16px; }
</style>
