---
import Thumbnail from './Thumbnail.astro';
import { postUrl, formatDate, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
  hidden?: boolean;
  featured?: boolean;
  eager?: boolean;
}
const { post, hidden, featured = false, eager = false } = Astro.props;
const { title, description, date, category, tags, pinned, draft } = post.data;
---
<article
  class:list={['post-card', { featured }]}
  data-category={category}
  data-featured={featured ? '' : undefined}
  hidden={hidden}
>
  <a href={postUrl(post)} class="hit state" aria-label={title}></a>
  <div class="media">
    <Thumbnail
      post={post}
      eager={eager}
      sizes={featured ? '(min-width: 1200px) 640px, (min-width: 840px) 55vw, 100vw' : '(min-width: 1200px) 360px, (min-width: 600px) 50vw, 100vw'}
    />
    {(draft || pinned) && (
      <span class="badge label-m">
        {draft ? <><span class="msr">edit</span>초안 · 로컬 전용</> : <><span class="msr fill">push_pin</span>고정</>}
      </span>
    )}
  </div>
  <div class="content">
    <p class="meta label-m">
      <span class="cat">{category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <h3 class:list={[featured ? 'headline-m' : 'title-l']}>{title}</h3>
    <p class:list={['desc', featured ? 'body-l' : 'body-m']}>{description}</p>
    <div class="foot body-s">
      <span class="read"><span class="msr">schedule</span>{readingMinutes(post.body)}분</span>
      {tags.slice(0, featured ? 5 : 3).map((t) => <span class="tag">#{t}</span>)}
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px 8px 16px;
    margin: -8px;
    border-radius: var(--md-shape-xl);
    color: var(--md-on-surface);
  }
  .post-card[hidden] { display: none; }

  /* 카드 전체가 하나의 링크: 겹친 투명 앵커가 클릭과 상태 레이어를 맡는다 */
  .hit { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .post-card:hover :global(.thumb img),
  .post-card:hover :global(.thumb svg) { transform: scale(1.04); }
  .post-card:hover h3 { color: var(--md-primary); }

  .media { position: relative; }
  .media :global(.thumb) { box-shadow: 0 0 0 1px var(--md-outline-variant); }
  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 28px;
    padding: 0 12px 0 8px;
    border-radius: var(--md-shape-sm);
    background: var(--md-surface-container-lowest);
    color: var(--md-on-surface);
    box-shadow: var(--md-elev-1);
  }
  .badge .msr { font-size: 16px; }

  .content { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
  .meta { display: flex; gap: 6px; margin: 0; color: var(--md-on-surface-variant); }
  .cat { color: var(--md-primary); }
  h3 {
    margin: 0;
    font-weight: 500;
    transition: color var(--md-dur-short);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .desc {
    margin: 0;
    color: var(--md-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; color: var(--md-on-surface-variant); margin-top: 4px; }
  .read { display: inline-flex; align-items: center; gap: 4px; }
  .read .msr { font-size: 16px; }
  .tag { color: var(--md-secondary); }

  /* Featured: 넓은 화면에서 썸네일 | 본문 가로 배치 */
  .featured { padding: 12px; margin: 0; background: var(--md-surface-container-low); }
  .featured .content { padding: 4px 12px 12px; gap: 12px; }
  .featured .desc { -webkit-line-clamp: 3; }
  @media (min-width: 840px) {
    .featured { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px; align-items: center; padding: 16px; }
    .featured .content { padding: 8px 16px 8px 0; }
  }
</style>
