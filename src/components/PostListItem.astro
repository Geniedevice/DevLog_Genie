---
import Thumbnail from './Thumbnail.astro';
import { postUrl, formatDate, readingMinutes, type Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, category } = post.data;
---
<li>
  <a class="item state" href={postUrl(post)}>
    <Thumbnail post={post} sizes="160px" class="list-thumb" />
    <span class="body">
      <span class="label-m meta"><span class="cat">{category}</span> · <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingMinutes(post.body)}분</span>
      <span class="title-m headline">{title}</span>
      <span class="body-m support">{description}</span>
    </span>
  </a>
</li>

<style>
  .item { display: flex; align-items: center; gap: 20px; padding: 12px 16px; border-radius: var(--md-shape-lg); color: var(--md-on-surface); }
  .item :global(.list-thumb) { width: 160px; flex: none; border-radius: var(--md-shape-md); box-shadow: 0 0 0 1px var(--md-outline-variant); }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .meta { color: var(--md-on-surface-variant); }
  .cat { color: var(--md-primary); }
  .headline { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .item:hover .headline { color: var(--md-primary); }
  .support { color: var(--md-on-surface-variant); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 599px) {
    .item { gap: 14px; align-items: flex-start; }
    .item :global(.list-thumb) { width: 104px; }
    .support { display: none; }
  }
</style>
