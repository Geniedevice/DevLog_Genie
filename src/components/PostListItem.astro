---
import Thumbnail from './Thumbnail.astro';
import { postUrl, readingMinutes, type Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, category } = post.data;
const md = date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' }).replace(/\s/g, '').replace(/\.$/, '');
---
<li>
  <a class="item" href={postUrl(post)}>
    <Thumbnail post={post} duration sizes="(min-width: 640px) 240px, 128px" class="list-thumb" />
    <span class="body">
      <span class="headline">{title}</span>
      <span class="meta">{category} · <time datetime={date.toISOString()}>{md}</time> · {readingMinutes(post.body)}분 읽기</span>
      <span class="support">{description}</span>
    </span>
  </a>
</li>

<style>
  .item { display: flex; gap: 16px; padding: 8px; border-radius: var(--radius-lg); transition: background var(--dur); }
  .item:hover { background: var(--accent); }
  .item :global(.list-thumb) { width: 240px; flex: none; border-radius: var(--radius-md); box-shadow: 0 0 0 1px var(--border); }
  .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; padding-top: 2px; }
  .headline { font-size: 17px; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .item:hover .headline { color: var(--brand); }
  .meta { font-size: 13px; color: var(--muted-foreground); }
  .support { margin-top: 4px; font-size: 14px; color: var(--muted-foreground); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 639px) {
    .item { gap: 12px; }
    .item :global(.list-thumb) { width: 128px; }
    .headline { font-size: 15px; }
    .support { display: none; }
  }
</style>
