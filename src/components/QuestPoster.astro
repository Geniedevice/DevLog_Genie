---
import Thumbnail from './Thumbnail.astro';
import { postUrl, formatDate, readingMinutes, type Post } from '../lib/posts';
import { rankOf, expOf, questNo, tiltOf, RANK_LABEL } from '../lib/quest';
import { categoryStyle } from '../lib/categories';

interface Props {
  post: Post;
  all: Post[];
  urgent?: boolean;
  eager?: boolean;
}
const { post, all, urgent = false, eager = false } = Astro.props;
const { title, description, date, category, tags, draft } = post.data;
const rank = rankOf(post);
const style = categoryStyle(category);
---
<article class:list={['poster', { urgent }]} style={`--tilt:${tiltOf(post)}deg`} data-poster>
  <span class="pin" aria-hidden="true"></span>
  {urgent && <span class="ribbon">긴급 의뢰</span>}

  <a href={postUrl(post)} class="hit" aria-label={`${title} 의뢰서 열기`}></a>

  <header class="head">
    <span class="label">토벌 의뢰 · No.{questNo(post, all)}</span>
    <span class:list={['rank', `rank-${rank}`]} title={`${RANK_LABEL[rank]} 등급`}>{rank}</span>
  </header>

  <div class="portrait">
    <Thumbnail
      post={post}
      eager={eager}
      sizes={urgent ? '(min-width: 1200px) 560px, (min-width: 900px) 50vw, 100vw' : '(min-width: 1200px) 340px, (min-width: 640px) 45vw, 100vw'}
    />
  </div>

  <h3 class="title">{title}</h3>
  <p class="desc">{description}</p>

  <dl class="facts">
    <div><dt><span class="msr">{style.icon}</span>분류</dt><dd>{category}</dd></div>
    <div><dt><span class="msr">event</span>게시</dt><dd>{formatDate(date)}</dd></div>
    <div><dt><span class="msr">hourglass_top</span>소요</dt><dd>{readingMinutes(post.body)}분</dd></div>
  </dl>

  <footer class="foot">
    <div class="loot">
      <span class="reward"><span class="msr fill">paid</span>{expOf(post).toLocaleString('ko-KR')} EXP</span>
      {tags.length > 0 && <span class="weak">약점 {tags.slice(0, 3).map((t) => `#${t}`).join(' ')}</span>}
    </div>
    <span class:list={['stamp', { open: draft }]} data-stamp aria-hidden="true">{draft ? '모집 중' : '토벌 완료'}</span>
  </footer>
</article>

<style>
  .poster {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 18px 18px;
    border-radius: 3px 3px 6px 6px;
    rotate: var(--tilt);
    transition: rotate 300ms var(--ease-out), translate 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
    /* 양피지 */
    background:
      radial-gradient(ellipse at 50% 0%, rgb(255 255 255 / 0.4), transparent 60%),
      radial-gradient(ellipse at 100% 100%, rgb(110 70 20 / 0.28), transparent 50%),
      radial-gradient(ellipse at 0% 100%, rgb(110 70 20 / 0.2), transparent 45%),
      var(--parchment);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(90 60 20 / 0.25), inset 0 0 30px rgb(120 80 30 / 0.35), 0 10px 24px -8px rgb(0 0 0 / 0.55);
  }
  .poster:hover,
  .poster:focus-within {
    rotate: 0deg;
    translate: 0 -6px;
    box-shadow: inset 0 0 0 1px rgb(90 60 20 / 0.25), inset 0 0 30px rgb(120 80 30 / 0.35), 0 22px 40px -10px rgb(0 0 0 / 0.65), 0 0 0 2px var(--gold-bright);
  }
  .hit { position: absolute; inset: 0; z-index: 3; border-radius: inherit; }
  .hit:focus-visible { outline-offset: 4px; }

  /* 압정 */
  .pin {
    position: absolute;
    top: 8px;
    left: calc(50% - 8px);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffb3a8, #b0302e 55%, #5c1312);
    box-shadow: 0 3px 4px rgb(0 0 0 / 0.5);
    z-index: 2;
  }

  .ribbon {
    position: absolute;
    top: 14px;
    right: -8px;
    padding: 4px 14px 4px 12px;
    background: var(--seal);
    color: #fff3e0;
    font: 700 12px/1.2 var(--font-serif);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.4);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 8px 50%);
    z-index: 2;
  }
  .ribbon::after { content: ''; position: absolute; right: 0; bottom: -6px; border: 3px solid #5c1312; border-right-color: transparent; border-bottom-color: transparent; }

  .head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .label { font: 700 12px/1 var(--font-serif); letter-spacing: 0.08em; color: var(--ink-muted); }
  .urgent .label { margin-right: 76px; }

  /* 등급 방패 */
  .rank {
    display: grid;
    place-items: center;
    width: 30px;
    height: 34px;
    font: 700 16px/1 var(--font-display);
    color: #fff;
    clip-path: polygon(50% 100%, 0 72%, 0 0, 100% 0, 100% 72%);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.5);
    flex: none;
  }
  .urgent .rank { display: none; }
  .rank-S { background: linear-gradient(var(--rank-s), color-mix(in srgb, var(--rank-s) 60%, #000)); }
  .rank-A { background: linear-gradient(var(--rank-a), color-mix(in srgb, var(--rank-a) 60%, #000)); }
  .rank-B { background: linear-gradient(var(--rank-b), color-mix(in srgb, var(--rank-b) 60%, #000)); }
  .rank-C { background: linear-gradient(var(--rank-c), color-mix(in srgb, var(--rank-c) 60%, #000)); }

  /* 초상화 틀 */
  .portrait { padding: 4px; background: linear-gradient(135deg, #3b2a18, #6b4a2a); box-shadow: 0 2px 6px rgb(0 0 0 / 0.35); }
  .portrait :global(.thumb) { box-shadow: inset 0 0 30px rgb(0 0 0 / 0.5); }
  .poster:hover .portrait :global(img) { transform: scale(1.05); }

  .title {
    margin: 4px 0 0;
    font-size: 20px;
    line-height: 1.3;
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .urgent .title { font-size: clamp(22px, 2.6vw, 28px); }
  .desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-muted);
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 4px 0 0; padding: 10px 0; border-top: 1px dashed rgb(90 60 20 / 0.4); border-bottom: 1px dashed rgb(90 60 20 / 0.4); }
  .facts div { display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 0; }
  dt { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; color: var(--ink-muted); }
  dt .msr { font-size: 14px; }
  dd { margin: 0; font: 700 13px/1.3 var(--font-serif); text-align: center; }

  .foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12px; min-height: 44px; }
  .loot { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .reward { display: inline-flex; align-items: center; gap: 4px; font: 700 14px/1 var(--font-serif); color: #7a4d06; }
  .reward .msr { font-size: 18px; color: #c48a1c; }
  .weak { color: var(--ink-muted); }

  /* 도장: 보상 줄 오른쪽에 찍혀 본문 글자를 가리지 않는다 */
  .stamp {
    flex: none;
    margin-right: 2px;
    padding: 4px 10px;
    border: 3px double var(--seal);
    border-radius: 6px;
    color: var(--seal);
    font: 700 18px/1 var(--font-serif);
    letter-spacing: 0.1em;
    rotate: -12deg;
    opacity: 0.85;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .stamp.open { color: #2f5fa8; border-color: #2f5fa8; }

  /* 긴급 의뢰: 넓은 화면에서 가로 배치 */
  @media (min-width: 900px) {
    .urgent {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas: 'portrait head' 'portrait title' 'portrait desc' 'portrait facts' 'portrait foot';
      grid-template-rows: auto auto 1fr auto auto;
      column-gap: 28px;
      padding: 30px 28px 26px;
    }
    .urgent .portrait { grid-area: portrait; align-self: center; }
    .urgent .head { grid-area: head; }
    .urgent .title { grid-area: title; text-align: left; -webkit-line-clamp: 3; }
    .urgent .desc { grid-area: desc; text-align: left; -webkit-line-clamp: 4; }
    .urgent .facts { grid-area: facts; }
    .urgent .foot { grid-area: foot; }
    .urgent .stamp { font-size: 22px; }
  }
</style>
