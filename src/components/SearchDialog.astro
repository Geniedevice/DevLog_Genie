---
import { url } from '../lib/posts';
---
<dialog class="search" data-search-dialog data-index={url('search.json')} aria-label="글 검색">
  <div class="search-bar">
    <button class="icon-btn state" type="button" data-close-search aria-label="닫기"><span class="msr">arrow_back</span></button>
    <input type="search" placeholder="제목, 태그, 내용으로 검색" autocomplete="off" spellcheck="false" data-search-input class="body-l" />
    <button class="icon-btn state" type="button" data-clear-search aria-label="지우기" hidden><span class="msr">close</span></button>
  </div>
  <hr class="divider" />
  <ul class="results" data-search-results role="listbox"></ul>
  <p class="empty body-m" data-search-empty hidden>검색 결과가 없습니다.</p>
</dialog>

<script>
  type Entry = { title: string; description: string; tags: string[]; category: string; date: string; url: string; text: string };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
  const empty = dialog.querySelector<HTMLElement>('[data-search-empty]')!;
  const clear = dialog.querySelector<HTMLButtonElement>('[data-clear-search]')!;
  let index: Entry[] | null = null;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  // 여러 검색어를 한 정규식으로 묶어야 앞서 넣은 <mark> 태그 안을 다시 치환하지 않는다
  const mark = (s: string, terms: string[]) => {
    if (!terms.length) return esc(s);
    const re = new RegExp(`(${terms.map((t) => esc(t).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
    return esc(s).replace(re, '<mark>$1</mark>');
  };

  async function open() {
    dialog.showModal();
    input.focus();
    index ??= await fetch(dialog.dataset.index!).then((r) => r.json());
    render();
  }

  function render() {
    const q = input.value.trim().toLowerCase();
    clear.hidden = !q;
    const terms = q.split(/\s+/).filter(Boolean);
    const scored = (index ?? [])
      .map((e) => {
        if (!terms.length) return { e, s: 0 };
        let s = 0;
        for (const t of terms) {
          const hit = [e.title.toLowerCase().includes(t) && 10, e.tags.some((x) => x.toLowerCase().includes(t)) && 6, e.description.toLowerCase().includes(t) && 4, e.text.toLowerCase().includes(t) && 1].filter(Boolean) as number[];
          if (!hit.length) return null;
          s += hit.reduce((a, b) => a + b, 0);
        }
        return { e, s };
      })
      .filter((x): x is { e: Entry; s: number } => !!x)
      .sort((a, b) => b.s - a.s)
      .slice(0, 20);

    empty.hidden = scored.length > 0 || !q;
    list.innerHTML = scored
      .map(({ e }) => `<li><a class="result state" href="${e.url}">
          <span class="msr">article</span>
          <span class="result-body">
            <span class="title-m">${mark(e.title, terms)}</span>
            <span class="body-m desc">${mark(e.description, terms)}</span>
            <span class="label-s meta">${esc(e.category)} · ${esc(e.date)}${e.tags.length ? ' · #' + e.tags.map(esc).join(' #') : ''}</span>
          </span></a></li>`)
      .join('');
  }

  input.addEventListener('input', render);
  clear.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
  dialog.querySelector('[data-close-search]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea');
    if ((e.key === '/' && !typing) || (e.key === 'k' && (e.ctrlKey || e.metaKey))) { e.preventDefault(); open(); }
  });
</script>

<style>
  .search {
    width: min(720px, 100vw);
    max-width: 100vw;
    max-height: min(640px, 100dvh);
    margin: 72px auto auto;
    padding: 0;
    border: 0;
    border-radius: var(--md-shape-xl);
    background: var(--md-surface-container-high);
    color: var(--md-on-surface);
    box-shadow: var(--md-elev-3);
    overflow: hidden;
  }
  .search[open] { display: flex; flex-direction: column; animation: enter var(--md-dur-medium) var(--md-ease-emphasized-decel); }
  .search::backdrop { background: rgb(0 0 0 / 0.32); }
  @keyframes enter { from { opacity: 0; transform: translateY(-16px) scale(0.98); } }
  @media (max-width: 599px) {
    .search { margin: 0; width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; }
  }

  .search-bar { display: flex; align-items: center; gap: 4px; height: 72px; padding: 0 12px; flex: none; }
  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--md-on-surface);
    font-family: var(--md-font);
    outline: none;
  }
  input::placeholder { color: var(--md-on-surface-variant); }
  input::-webkit-search-cancel-button { display: none; }

  .results { list-style: none; margin: 0; padding: 8px 0; overflow-y: auto; }
  .results :global(.result) { display: flex; gap: 16px; padding: 12px 24px; color: var(--md-on-surface); }
  .results :global(.result > .msr) { color: var(--md-on-surface-variant); margin-top: 2px; }
  .results :global(.result-body) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .results :global(.desc) { color: var(--md-on-surface-variant); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .results :global(.meta) { color: var(--md-outline); }
  .results :global(mark) { background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); border-radius: 2px; }
  .empty { padding: 24px; margin: 0; color: var(--md-on-surface-variant); text-align: center; }
</style>
