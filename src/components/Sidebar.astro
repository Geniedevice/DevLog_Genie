---
import { NAV, BOOKMARKS, type NavKey } from '../lib/nav';
import { url } from '../lib/posts';
import { SITE } from '../site.config';

interface Props { active?: NavKey; level: number }
const { active, level } = Astro.props;
const cls = (key: NavKey) => ['item', { active: active === key }];
const cur = (key: NavKey) => (active === key ? 'page' : undefined);
---
<aside class="sidebar" aria-label="사이드바">
  <a class="brand" href={url()}>
    <img class="logo" src={url('favicon.svg')} alt="" width="36" height="36" />
    <span class="brand-text">
      <span class="brand-name">{SITE.title}</span>
      <span class="brand-sub">by JINY</span>
    </span>
  </a>

  <nav aria-label="주 메뉴">
    <ul class="list">
      {NAV.map((n) => (
        <li><a href={url(n.path)} class:list={cls(n.key)} aria-current={cur(n.key)}><span class="msr">{n.icon}</span>{n.label}</a></li>
      ))}
    </ul>
    <hr class="separator" />
    <ul class="list">
      <li><a href={url(BOOKMARKS.path)} class:list={cls(BOOKMARKS.key)} aria-current={cur(BOOKMARKS.key)}><span class="msr">{BOOKMARKS.icon}</span>{BOOKMARKS.label}</a></li>
      <li>
        <button class="item" type="button" data-open-search>
          <span class="msr">search</span>검색<span class="kbds"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd></span>
        </button>
      </li>
    </ul>
  </nav>

  <div class="profile">
    <img class="avatar" src={url('images/jiny-avatar.webp')} alt="" width="40" height="40" />
    <div class="who">
      <p class="name">{SITE.author}</p>
      <p class="role">Lv. {level} · Unreal Client Developer</p>
    </div>
    <button class="btn btn-ghost btn-icon btn-sm" type="button" data-theme-toggle aria-label="낮·밤 전환">
      <span class="msr theme-night">dark_mode</span><span class="msr theme-day">light_mode</span>
    </button>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100dvh;
    width: var(--sidebar-width);
    flex: none;
    display: none;
    flex-direction: column;
    gap: 18px;
    padding: 24px 16px 16px;
    background: var(--sidebar);
    color: var(--sidebar-foreground);
    border-right: 1px solid var(--sidebar-border);
  }
  @media (min-width: 1024px) { .sidebar { display: flex; } }

  .brand { display: flex; align-items: center; gap: 12px; padding: 0 8px 8px; }
  .logo { width: 36px; height: 36px; filter: drop-shadow(0 0 10px var(--glow)); transition: rotate 500ms var(--ease-out); }
  .brand:hover .logo { rotate: -10deg; }
  .brand-text { display: flex; flex-direction: column; gap: 3px; }
  .brand-name { font-size: 21px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .brand-sub { font: 500 11px/1 var(--font-mono); letter-spacing: 0.2em; color: var(--brand); }

  nav { display: flex; flex-direction: column; gap: 12px; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: color-mix(in srgb, var(--sidebar-foreground) 78%, transparent);
    font: 500 15px/1 var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition: background var(--dur), color var(--dur);
  }
  .item .msr { font-size: 22px; }
  .item:hover { background: var(--sidebar-accent); color: var(--sidebar-foreground); }
  .item.active { background: var(--sidebar-accent); color: var(--sidebar-primary); font-weight: 700; }
  .item.active::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 3px; background: var(--sidebar-primary); box-shadow: 0 0 10px var(--glow); }
  .kbds { display: flex; gap: 2px; margin-left: auto; }

  .profile { display: flex; align-items: center; gap: 10px; margin-top: auto; padding: 14px 6px 0; border-top: 1px solid var(--sidebar-border); }
  .avatar { width: 40px; height: 40px; border-radius: 50%; flex: none; box-shadow: 0 0 0 2px var(--brand), 0 0 12px var(--glow); }
  .who { flex: 1; min-width: 0; }
  .who p { margin: 0; }
  .name { font-size: 14px; font-weight: 700; }
  .role { font-size: 11.5px; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .theme-day { display: none; }
  :global([data-theme='dark']) .theme-night { display: none; }
  :global([data-theme='dark']) .theme-day { display: inline-block; }
</style>
