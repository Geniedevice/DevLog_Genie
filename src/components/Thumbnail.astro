---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { categoryStyle } from '../lib/categories';

interface Props {
  post: Post;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { post, sizes, eager = false, class: className } = Astro.props;
const { cover, coverAlt, title, category } = post.data;
const style = categoryStyle(category);
---
<div class:list={['thumb', className]}>
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? title}
      widths={[480, 800, 1200, 1600].filter((w) => w <= cover.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  ) : (
    // 커버가 없는 글: 분류 색의 밤하늘 위 문양
    <div class:list={['art', `tone-${style.tone}`]} role="img" aria-label={title}>
      <svg class="sigil" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="44" />
        <circle cx="50" cy="50" r="36" stroke-dasharray="2 3" />
        <path d="M50 8 86 71H14Z" />
        <path d="M50 92 14 29h72Z" />
      </svg>
      <span class="msr" aria-hidden="true">{style.icon}</span>
    </div>
  )}
</div>

<style>
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--muted); container-type: inline-size; }
  .thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease-out); }

  .art { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; }
  .sigil { position: absolute; width: 78%; fill: none; stroke-width: 0.8; opacity: 0.5; animation: turn 40s linear infinite; }
  @keyframes turn { to { rotate: 360deg; } }
  .art .msr { position: relative; font-size: clamp(32px, 14cqw, 80px); filter: drop-shadow(0 0 12px currentColor); }

  .tone-gold { background: radial-gradient(circle at 50% 40%, #6b4a17, #1c1208 75%); color: #f4cf78; }
  .tone-arcane { background: radial-gradient(circle at 50% 40%, #4a2f8c, #140c26 75%); color: #c9b3ff; }
  .tone-ember { background: radial-gradient(circle at 50% 40%, #8c2f1e, #1f0a07 75%); color: #ffb08a; }
  .tone-emerald { background: radial-gradient(circle at 50% 40%, #1f6b4c, #07170f 75%); color: #8ee6bb; }
  .art .sigil { stroke: currentColor; }
</style>
