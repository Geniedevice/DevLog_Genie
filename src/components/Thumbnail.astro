---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { categoryStyle } from '../lib/categories';
import shapes from '../lib/shapes.json';

interface Props {
  post: Post;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { post, sizes, eager = false, class: className } = Astro.props;
const { cover, coverAlt, title, category } = post.data;
const style = categoryStyle(category);
---
<div class:list={['thumb', className]}>
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? title}
      widths={[480, 800, 1200, 1600].filter((w) => w <= cover.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  ) : (
    // 커버가 없는 글: 카테고리 톤으로 만든 셰이프 아트
    <div class:list={['art', `tone-${style.tone}`]} role="img" aria-label={title}>
      <svg class="s1" viewBox="0 0 48 48" aria-hidden="true"><path d={shapes[style.shape]} /></svg>
      <svg class="s2" viewBox="0 0 48 48" aria-hidden="true"><path d={shapes.clover4} /></svg>
      <span class="msr" aria-hidden="true">{style.icon}</span>
    </div>
  )}
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--md-shape-lg);
    background: var(--md-surface-container-high);
    isolation: isolate;
  }
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--md-dur-medium) var(--md-ease-standard);
  }

  .art { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; }
  .art svg { position: absolute; transition: transform var(--md-dur-medium) var(--md-ease-standard); }
  .s1 { width: 70%; right: -18%; top: -32%; }
  .s2 { width: 42%; left: -10%; bottom: -24%; }
  .art .msr { position: relative; font-size: clamp(36px, 9cqw, 72px); }
  .thumb { container-type: inline-size; }

  .tone-primary { background: var(--md-primary-container); color: var(--md-on-primary-container); }
  .tone-primary .s1 { fill: color-mix(in srgb, var(--md-primary) 24%, transparent); }
  .tone-primary .s2 { fill: color-mix(in srgb, var(--md-tertiary) 22%, transparent); }
  .tone-secondary { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
  .tone-secondary .s1 { fill: color-mix(in srgb, var(--md-secondary) 24%, transparent); }
  .tone-secondary .s2 { fill: color-mix(in srgb, var(--md-primary) 20%, transparent); }
  .tone-tertiary { background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); }
  .tone-tertiary .s1 { fill: color-mix(in srgb, var(--md-tertiary) 24%, transparent); }
  .tone-tertiary .s2 { fill: color-mix(in srgb, var(--md-primary) 20%, transparent); }
</style>
