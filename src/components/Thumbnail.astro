---
import { Image } from 'astro:assets';
import { readingMinutes, type Post } from '../lib/posts';
import { categoryStyle } from '../lib/categories';

interface Props {
  post: Post;
  sizes: string;
  eager?: boolean;
  /** 썸네일 문구(thumbText) 표시 — 작은 썸네일에서는 끈다 */
  text?: boolean;
  /** 우하단 "N분" 칩 */
  duration?: boolean;
  class?: string;
}
const { post, sizes, eager = false, text = true, duration = false, class: className } = Astro.props;
const { cover, coverAlt, title, category, thumbText, pixelArt } = post.data;
const style = categoryStyle(category);
// 커버가 없으면 제목을 문구로 써서 텅 빈 썸네일이 없게 한다
const lines = (thumbText ?? (cover ? '' : title)).split('\n').filter(Boolean);
---
<div class:list={['thumb', className, { pixel: pixelArt }]}>
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? title}
      widths={[400, 720, 1080, 1536].filter((w) => w <= cover.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  ) : (
    <div class:list={['art', `tone-${style.tone}`]} role="img" aria-label={title}>
      <span class="msr" aria-hidden="true">{style.icon}</span>
    </div>
  )}
  {text && lines.length > 0 && (
    <p class:list={['caption', { long: !thumbText }]} aria-hidden="true">
      {lines.map((l, i) => <span class:list={{ hl: i === 1 }}>{l}</span>)}
    </p>
  )}
  {duration && <span class="dur" aria-hidden="true">{readingMinutes(post.body)}분</span>}
</div>

<style>
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--muted); container-type: inline-size; isolation: isolate; }
  .thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out), filter 300ms; }
  .pixel :global(img) { image-rendering: pixelated; }

  .art { position: absolute; inset: 0; display: grid; place-items: end; padding: 6%; }
  .art .msr { font-size: 30cqw; opacity: 0.18; line-height: 0.8; }
  .tone-gold { background: radial-gradient(circle at 80% 90%, #5a4410, #110e08 80%); color: #ffd84a; }
  .tone-arcane { background: radial-gradient(circle at 80% 90%, #4a3aa8, #110e22 80%); color: #c9bdff; }
  .tone-ember { background: radial-gradient(circle at 80% 90%, #8a2458, #1a0812 80%); color: #ff9cc8; }
  .tone-emerald { background: radial-gradient(circle at 80% 90%, #146a8a, #07131a 80%); color: #8fe3ff; }

  /* 유튜브 썸네일식 문구: 굵게, 테두리 + 그림자, 둘째 줄은 강조색 */
  .caption {
    position: absolute;
    left: 6%;
    top: 7%;
    right: 6%;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: 11.5cqw;
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: #fff;
    -webkit-text-stroke: 0.9cqw #0b120e;
    paint-order: stroke fill;
    text-shadow: 0 0.6cqw 0 #0b120e, 0 1cqw 3cqw rgb(0 0 0 / 0.6);
    rotate: -2deg;
    transform-origin: left top;
  }
  .caption .hl { color: #a99be8; }
  .caption.long { font-size: 8cqw; rotate: 0deg; }
  .caption.long span { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .dur {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 1;
    padding: 3px 6px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.78);
    color: #fff;
    font: 600 12px/1 var(--font-sans);
  }
</style>
