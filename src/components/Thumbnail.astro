---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { readingMinutes, type Post } from '../lib/posts';
import { categoryStyle } from '../lib/categories';

interface Props {
  post: Post;
  sizes: string;
  eager?: boolean;
  /** 썸네일 문구(thumbText) 표시 — 작은 썸네일에서는 끈다 */
  text?: boolean;
  /** 우하단 "N분" 칩 */
  duration?: boolean;
  class?: string;
}
const { post, sizes, eager = false, text = true, duration = false, class: className } = Astro.props;
const { cover, coverAlt, title, category, thumbText, pixelArt } = post.data;
const style = categoryStyle(category);
// 커버가 없으면 제목을 문구로 써서 텅 빈 썸네일이 없게 한다.
// `*강조*` 로 감싼 부분은 라벤더색(레퍼런스의 "타격감의 *비밀*"), 줄바꿈은 \n
const lines = (thumbText ?? (cover ? '' : title))
  .split('\n')
  .filter(Boolean)
  .map((l) => l.split(/(\*[^*]+\*)/).filter(Boolean).map((seg) => (seg.startsWith('*') ? { hl: true, t: seg.slice(1, -1) } : { hl: false, t: seg })));
---
<div class:list={['thumb', className, { pixel: pixelArt }]}>
  {cover ? (
    <Image
      src={cover}
      alt={coverAlt ?? title}
      widths={[400, 720, 1080, 1536].filter((w) => w <= cover.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  ) : (
    <div class:list={['art', `tone-${style.tone}`]} role="img" aria-label={title}>
      <Icon name={style.icon} size={120} stroke={1.2} />
    </div>
  )}
  {text && lines.length > 0 && (
    <p class:list={['caption', { long: !thumbText }]} aria-hidden="true">
      {lines.map((segs) => <span class="line">{segs.map((s) => (s.hl ? <em>{s.t}</em> : s.t))}</span>)}
    </p>
  )}
  {duration && <span class="dur" aria-hidden="true">{readingMinutes(post.body)}분</span>}
</div>

<style>
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--muted); container-type: inline-size; isolation: isolate; }
  .thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out), filter 300ms; }
  .pixel :global(img) { image-rendering: pixelated; }

  .art { position: absolute; inset: 0; display: grid; place-items: end; padding: 5%; }
  .art :global(.icon) { width: 34cqw; height: 34cqw; opacity: 0.22; }
  .tone-gold { background: radial-gradient(circle at 80% 85%, #4a3f1f, #111522 80%); color: #f2cf7a; }
  .tone-arcane { background: radial-gradient(circle at 80% 85%, #3d3478, #111522 80%); color: #a99be8; }
  .tone-ember { background: radial-gradient(circle at 80% 85%, #5a2645, #111522 80%); color: #f29cc8; }
  .tone-emerald { background: radial-gradient(circle at 80% 85%, #1d4a44, #111522 80%); color: #8fd4c1; }

  /* 문구 아래를 살짝 어둡게 해서 어떤 커버 위에서도 읽히게 */
  .thumb:has(.caption)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 12 22 / 0.78), rgb(10 12 22 / 0.2) 45%, transparent 70%);
    pointer-events: none;
  }
  .caption {
    position: absolute;
    left: 5.5%;
    right: 18%;
    bottom: 7%;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: 10.5cqw;
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.022em;
    color: #fff;
    text-shadow: 0 0.35cqw 0 #0b0e1a, 0 0 2.4cqw rgb(0 0 0 / 0.55);
  }
  .caption em { font-style: normal; color: #b9adff; text-shadow: 0 0.35cqw 0 #0b0e1a, 0 0 3cqw rgb(169 155 232 / 0.55); }
  .caption.long { font-size: 7.4cqw; }
  .caption.long .line { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .dur {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 2;
    padding: 3px 7px;
    border-radius: 5px;
    background: rgb(10 12 22 / 0.82);
    color: #e7ebf5;
    font: 700 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
  }
</style>
