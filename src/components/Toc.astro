---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
---
<nav class="toc card" aria-label="목차">
  <p class="toc-title"><span class="msr">explore</span>탐험 지도</p>
  <ul>
    {headings.map((h) => (
      <li class:list={[`d${h.depth}`]}><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
    ))}
  </ul>
</nav>

<script>
  // 화면 상단 30% 선을 지난 마지막 제목을 "지금 읽는 구역"으로 본다
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = links.map((l) => document.getElementById(l.dataset.tocLink!)).filter((t): t is HTMLElement => !!t);
  const update = () => {
    const line = innerHeight * 0.3;
    let current = targets[0];
    for (const t of targets) if (t.getBoundingClientRect().top < line) current = t;
    links.forEach((l) => l.classList.toggle('active', l.dataset.tocLink === current?.id));
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .toc { position: sticky; top: 88px; max-height: calc(100dvh - 120px); overflow-y: auto; padding: 16px 12px 14px; }
  .toc-title { display: flex; align-items: center; gap: 6px; margin: 0 0 10px; padding-left: 6px; font: 700 14px/1 var(--font-serif); }
  .toc-title .msr { color: var(--gold); font-size: 18px; }
  ul { list-style: none; margin: 0; padding: 0; }
  a {
    position: relative;
    display: block;
    padding: 6px 8px 6px 22px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted-foreground);
    transition: color var(--dur), background var(--dur);
  }
  a::before { content: '◇'; position: absolute; left: 6px; top: 6px; font-size: 10px; color: var(--border); transition: color var(--dur); }
  .d3 a { padding-left: 34px; font-size: 12.5px; }
  .d3 a::before { left: 20px; }
  a:hover { color: var(--foreground); background: var(--muted); }
  a.active { color: var(--foreground); background: var(--accent); font-weight: 600; }
  a.active::before { content: '◆'; color: var(--gold); }
</style>
