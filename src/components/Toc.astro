---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
---
<nav class="toc" aria-label="목차">
  <p class="toc-title"><span class="msr">toc</span>목차</p>
  <ul>
    {headings.map((h) => (
      <li class:list={[`d${h.depth}`]}><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
    ))}
  </ul>
</nav>

<script>
  // 화면 상단 30% 선을 지난 마지막 제목을 "지금 읽는 구역"으로 본다
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = links.map((l) => document.getElementById(l.dataset.tocLink!)).filter((t): t is HTMLElement => !!t);
  const update = () => {
    const line = innerHeight * 0.3;
    let current = targets[0];
    for (const t of targets) if (t.getBoundingClientRect().top < line) current = t;
    links.forEach((l) => l.classList.toggle('active', l.dataset.tocLink === current?.id));
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .toc { max-height: calc(100dvh - 48px); overflow-y: auto; padding: 14px 10px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); }
  .toc-title { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; padding: 0 8px; font-size: 14px; font-weight: 700; }
  .toc-title .msr { color: var(--brand); font-size: 19px; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { display: block; padding: 6px 10px; border-left: 2px solid transparent; font-size: 13.5px; line-height: 1.45; color: var(--muted-foreground); transition: color var(--dur), border-color var(--dur), background var(--dur); }
  .d3 a { padding-left: 22px; font-size: 13px; }
  a:hover { color: var(--foreground); }
  a.active { color: var(--brand); border-left-color: var(--brand); background: var(--brand-soft); font-weight: 600; }
</style>
