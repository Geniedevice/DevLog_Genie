---
import { SITE } from '../site.config';
import { url } from '../lib/posts';
---
<header class="top-bar" data-top-bar>
  <a class="brand" href={url()}>
    <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><use href="#logo-shape" /></svg>
    <span class="title-l">{SITE.title}</span>
  </a>
  <div class="actions">
    <button class="icon-btn state search-btn" type="button" data-open-search aria-label="검색">
      <span class="msr">search</span>
    </button>
    <button class="icon-btn state" type="button" data-theme-toggle aria-label="테마 전환">
      <span class="msr theme-icon-dark">dark_mode</span>
      <span class="msr theme-icon-light">light_mode</span>
    </button>
    <a class="icon-btn state" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
    </a>
  </div>
</header>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 8px 0 16px;
    background: var(--md-surface);
    transition: background var(--md-dur-medium) var(--md-ease-standard);
  }
  /* 스크롤되면 M3 "on scroll" 상태처럼 한 단계 높은 컨테이너 색으로 올라간다 */
  .top-bar.scrolled { background: var(--md-surface-container); }
  @media (min-width: 840px) {
    .top-bar { border-radius: var(--md-shape-xl) var(--md-shape-xl) 0 0; padding: 0 16px 0 28px; }
    .brand { visibility: hidden; }
  }

  .brand { display: flex; align-items: center; gap: 12px; color: var(--md-on-surface); }
  .brand-mark { width: 28px; height: 28px; color: var(--md-primary); }
  .actions { display: flex; gap: 4px; }

  .theme-icon-light { display: none; }
  :global([data-theme='dark']) .theme-icon-dark { display: none; }
  :global([data-theme='dark']) .theme-icon-light { display: inline-block; }
</style>
