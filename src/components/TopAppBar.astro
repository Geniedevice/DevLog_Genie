---
import { SITE } from '../site.config';
import { url } from '../lib/posts';
---
<header class="top-bar" data-top-bar>
  <a class="brand" href={url()}>
    <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><use href="#emblem" /></svg>
    <span class="font-display">{SITE.title}</span>
  </a>
  <div class="actions">
    <button class="search-trigger" type="button" data-open-search>
      <span class="msr">search</span>
      <span class="hint">수정구슬에 묻기…</span>
      <span class="kbds"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd></span>
    </button>
    <button class="btn btn-ghost btn-icon mobile-search" type="button" data-open-search aria-label="검색"><span class="msr">search</span></button>
    <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="낮·밤 전환">
      <span class="msr theme-night">dark_mode</span>
      <span class="msr theme-day">light_mode</span>
    </button>
    <a class="btn btn-ghost btn-icon" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
    </a>
  </div>
</header>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 64px;
    padding: 0 12px 0 16px;
    transition: background var(--dur), border-color var(--dur), backdrop-filter var(--dur);
    border-bottom: 1px solid transparent;
  }
  .top-bar.scrolled {
    background: color-mix(in srgb, var(--background) 80%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }
  @media (min-width: 900px) {
    .top-bar { padding: 0 24px 0 32px; }
    .brand { visibility: hidden; }
  }

  .brand { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 700; }
  .brand-mark { width: 30px; height: 30px; }
  .actions { display: flex; align-items: center; gap: 4px; }

  /* shadcn 문서 사이트의 검색 트리거 모양 */
  .search-trigger {
    display: none;
    align-items: center;
    gap: 8px;
    width: 260px;
    height: 36px;
    padding: 0 6px 0 10px;
    margin-right: 6px;
    border: 1px solid var(--input);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--card) 70%, transparent);
    color: var(--muted-foreground);
    font: 400 14px/1 var(--font-sans);
    cursor: pointer;
    transition: border-color var(--dur), background var(--dur);
  }
  .search-trigger:hover { border-color: var(--gold); background: var(--accent); }
  .search-trigger .msr { font-size: 18px; }
  .hint { flex: 1; text-align: left; }
  .kbds { display: flex; gap: 2px; }
  @media (min-width: 700px) {
    .search-trigger { display: flex; }
    .mobile-search { display: none; }
  }

  .theme-day { display: none; }
  :global([data-theme='dark']) .theme-night { display: none; }
  :global([data-theme='dark']) .theme-day { display: inline-block; }
</style>
