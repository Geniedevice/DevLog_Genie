---
import Icon from './Icon.astro';
import Thumbnail from './Thumbnail.astro';
import { postUrl, readingMinutes, type Post } from '../lib/posts';

interface Props {
  post: Post;
  eager?: boolean;
  hidden?: boolean;
}
const { post, eager = false, hidden } = Astro.props;
const { title, date, category, pinned, draft } = post.data;
const md = date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' }).replace(/\s/g, '').replace(/\.$/, '');
const minutes = readingMinutes(post.body);
---
<article class="vcard" data-card data-category={category} data-date={date.valueOf()} data-minutes={minutes} hidden={hidden}>
  <a class="media" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    <Thumbnail post={post} eager={eager} duration sizes="(min-width: 1400px) 420px, (min-width: 1024px) 30vw, (min-width: 640px) 48vw, 100vw" />
    {(pinned || draft) && (
      <span class:list={['flag', { draft }]}>{draft ? 'DRAFT' : <><Icon name="pin" size={11} />PINNED</>}</span>
    )}
    <span class="press pixel-font" aria-hidden="true">▶ PRESS START</span>
  </a>
  <button class="bm" type="button" data-bookmark={post.id} aria-label="북마크" aria-pressed="false"><Icon name="bookmark" size={17} /></button>
  <h3 class="title"><a href={postUrl(post)}>{title}</a></h3>
  <p class="meta">
    <span>{category}</span><span class="dot" aria-hidden="true">·</span>
    <time datetime={date.toISOString()}>{md}</time><span class="dot" aria-hidden="true">·</span>
    <span>{minutes}분 읽기</span>
  </p>
</article>

<style>
  .vcard { position: relative; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .media {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: border-color 250ms, box-shadow 300ms var(--ease-out), translate 300ms var(--ease-out);
  }
  .vcard:hover .media {
    translate: 0 -4px;
    border-color: color-mix(in srgb, var(--brand) 70%, transparent);
    box-shadow: 0 18px 36px -16px rgb(0 0 0 / 0.7), 0 0 0 1px color-mix(in srgb, var(--brand) 40%, transparent), 0 0 30px -8px var(--glow);
  }
  .vcard:hover .media :global(img) { transform: scale(1.05); }

  /* 게임 타이틀 화면처럼: 올리면 깜빡이는 PRESS START */
  .press {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 2;
    padding: 5px 8px;
    border-radius: 4px;
    background: rgb(10 12 22 / 0.75);
    color: var(--mint);
    font-size: 10px;
    letter-spacing: 0.14em;
    opacity: 0;
    transition: opacity 150ms;
  }
  .vcard:hover .press { opacity: 1; animation: blink 0.9s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .flag {
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 7px;
    border-radius: 4px;
    background: var(--primary);
    color: var(--primary-foreground);
    font: 700 10px/1 var(--font-pixel);
    letter-spacing: 0.12em;
  }
  .flag.draft { background: var(--mint); color: #111522; }

  .bm {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: var(--radius-md);
    background: rgb(10 12 22 / 0.7);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur), background var(--dur);
  }
  .vcard:hover .bm, .bm:focus-visible, .bm[aria-pressed='true'] { opacity: 1; }
  .vcard:hover .press { right: 50px; }
  .bm[aria-pressed='true'] { color: var(--amber); }
  .bm:hover { background: rgb(10 12 22 / 0.9); }
  @media (hover: none) { .bm { opacity: 1; } }

  .title { margin: 2px 2px 0; font-size: 17px; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .title a { transition: color var(--dur); }
  .title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .vcard:hover .title a { color: var(--brand); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 2px; font-size: 14px; color: var(--muted-foreground); }
  .dot { opacity: 0.6; }
</style>
