---
import { niceScale, smoothPath } from '../../lib/chart';
interface Props { data: { label: string; value: number }[]; unit: string; name: string; color?: string; id: string }
const { data, unit, name, color = 'var(--chart-1)', id } = Astro.props;
const W = 640, H = 220, L = 30, R = 12, T = 12, B = 26;
const { max, step } = niceScale(Math.max(...data.map((d) => d.value), 1));
const x = (i: number) => L + (i * (W - L - R)) / Math.max(1, data.length - 1);
const y = (v: number) => T + (H - T - B) * (1 - v / max);
const pts = data.map((d, i) => [x(i), y(d.value)] as [number, number]);
const line = smoothPath(pts);
const area = `${line} L${x(data.length - 1)} ${H - B} L${x(0)} ${H - B}Z`;
const ticks = Array.from({ length: max / step + 1 }, (_, i) => i * step);
---
<svg class="chart area-chart" viewBox={`0 0 ${W} ${H}`} data-chart="area" style={`--c:${color}`} role="img" aria-label={`${name} 추이: ${data.map((d) => `${d.label} ${d.value}${unit}`).join(', ')}`}>
  <defs>
    <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={color} stop-opacity=".45" />
      <stop offset="1" stop-color={color} stop-opacity="0" />
    </linearGradient>
  </defs>
  {ticks.map((t) => (
    <g class="grid">
      <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} />
      <text x={L - 8} y={y(t) + 4} text-anchor="end">{t}</text>
    </g>
  ))}
  <path class="fill" d={area} fill={`url(#${id}-fill)`} />
  <path class="line" d={line} fill="none" stroke={color} stroke-width="2.5" stroke-linecap="round" />
  {data.map((d, i) => (
    <g>
      <text class="xlabel" x={x(i)} y={H - 6} text-anchor="middle">{d.label}</text>
      <rect class="hit" x={x(i) - (W - L - R) / data.length / 2} y={T} width={(W - L - R) / data.length} height={H - T - B}
        data-tip={JSON.stringify({ t: d.label, r: [[name, `${d.value}${unit}`, color]] })} />
      <circle class="dot" cx={x(i)} cy={y(d.value)} r={d.value ? 4 : 2.5} fill={d.value ? color : 'var(--muted-foreground)'} />
    </g>
  ))}
</svg>

<style>
  .chart { width: 100%; height: auto; display: block; overflow: visible; }
  .grid line { stroke: var(--border); stroke-dasharray: 3 4; }
  .grid text, .xlabel { fill: var(--muted-foreground); font-size: 11px; font-family: var(--font-sans); }
  .hit { fill: transparent; cursor: crosshair; }
  .hit:hover + .dot { r: 6; }
  .dot { pointer-events: none; transition: r 150ms; stroke: var(--card); stroke-width: 2; transform-box: fill-box; transform-origin: center; }
</style>
