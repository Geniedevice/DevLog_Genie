---
// 기록 띠의 숫자 한 칸: 큰 숫자 + 이름 + 덧말. 눌리는 것이 아니라 상자 · 아이콘 · 호버가 없다
interface Props { label: string; value: number; unit?: string; hint?: string }
const { label, value, unit = '', hint } = Astro.props;
---
<div class="kpi">
  <p class="value"><span data-count={value}>{value.toLocaleString('ko-KR')}</span>{unit && <small>{unit}</small>}</p>
  <p class="label">{label}</p>
  {hint && <p class="hint">{hint}</p>}
</div>

<style>
  .kpi { display: flex; flex-direction: column; gap: 2px; padding: 20px 24px 22px 0; }
  .value { margin: 0 0 6px; font-size: clamp(36px, 4vw, 52px); font-weight: 700; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .value small { margin-left: 4px; font-size: 0.36em; font-weight: 400; color: var(--muted-foreground); }
  .label { margin: 0; font-size: 15px; font-weight: 700; }
  .hint { margin: 0; font-size: 13px; color: var(--muted-foreground); }
</style>
