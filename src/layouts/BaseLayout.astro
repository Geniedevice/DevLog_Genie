---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import MobileBar from '../components/MobileBar.astro';
import BottomNav from '../components/BottomNav.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';
import { getPosts, url } from '../lib/posts';
import { levelOf } from '../lib/quest';
import type { NavKey } from '../lib/nav';

interface Props {
  title?: string;
  description?: string;
  active?: NavKey;
  type?: 'website' | 'article';
  /** 링크 미리보기 이미지. 사이트 기준 경로 또는 절대 URL */
  image?: string;
}
const { title, description = SITE.description, active, type = 'website', image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('images/og.png'), Astro.site).href;
const { level } = levelOf(await getPosts());
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111522" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&display=block" />

    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = 'dark';
        d.dataset.theme = t;
        // 등장 연출용 초기 숨김은 JS 가 돌고 모션을 허용할 때만 건다
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('js-fx');
      })();
    </script>
  </head>
  <body>
    <a class="skip sr-only" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <Sidebar active={active} level={level} />
      <div class="pane">
        <MobileBar />
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <BottomNav active={active} />
    <CommandPalette />

    <script>
      import { revealOnScroll, countUp } from '../scripts/fx';
      import { animateCharts } from '../scripts/charts';

      const root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
        }),
      );

      const bar = document.querySelector('[data-top-bar]');
      const onScroll = () => bar?.classList.toggle('scrolled', scrollY > 4);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      revealOnScroll();
      countUp();
      animateCharts();
    </script>
  </body>
</html>

<style is:global>
  .js-fx [data-reveal],
  .js-fx [data-reveal-group] > *,
  .js-fx [data-card],
  .js-fx [data-headline],
  .js-fx [data-scramble] { opacity: 0; }
  .char { display: inline-block; }
</style>

<style>
  .shell { display: flex; min-height: 100dvh; }
  .pane { flex: 1; min-width: 0; display: flex; flex-direction: column; padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  @media (min-width: 1024px) { .pane { padding-bottom: 0; } }
  main { flex: 1; }
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; z-index: 100; padding: 8px 16px; background: var(--primary); color: var(--primary-foreground); border-radius: var(--radius-md); }
</style>
