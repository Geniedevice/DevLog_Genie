---
import '../styles/global.css';
import NavRail from '../components/NavRail.astro';
import BottomNav from '../components/BottomNav.astro';
import TopAppBar from '../components/TopAppBar.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Footer from '../components/Footer.astro';
import shapes from '../lib/shapes.json';
import { SITE } from '../site.config';
import { url } from '../lib/posts';
import type { NavKey } from '../lib/nav';

interface Props {
  title?: string;
  description?: string;
  active?: NavKey;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, active, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fef7ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141218" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,700&family=Roboto+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&display=block" />

    <!-- 첫 페인트 전에 테마를 정해야 깜빡임이 없다 -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="logo-shape" viewBox="0 0 48 48"><path d={shapes.cookie9} fill="currentColor" /><path d="M17 17h7a7 7 0 0 1 0 14h-7z" fill="none" stroke="var(--md-surface)" stroke-width="3.2" stroke-linejoin="round" /></symbol>
    </svg>

    <a class="skip sr-only" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <NavRail active={active} />
      <div class="pane">
        <TopAppBar />
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <BottomNav active={active} />
    <SearchDialog />

    <script>
      const root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
        }),
      );

      const bar = document.querySelector('[data-top-bar]');
      const onScroll = () => bar?.classList.toggle('scrolled', scrollY > 4);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style>
  .shell { display: flex; min-height: 100dvh; }
  .pane {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--md-surface);
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
  }
  /* 확장 레이아웃: 레일 옆 콘텐츠를 surface 판 위에 얹는다(M3 웹 앱 캔버스 구성) */
  @media (min-width: 840px) {
    .pane { margin: 16px 16px 16px 0; border-radius: var(--md-shape-xl); padding-bottom: 0; }
  }
  main { flex: 1; }
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; z-index: 100; padding: 8px 16px; background: var(--md-primary); color: var(--md-on-primary); border-radius: var(--md-shape-full); }
</style>
