---
// 폰트는 npm 으로 받아 함께 번들한다(외부 CDN 없음)
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css'; // 본문 폰트에 없는 글자 대비 예비
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import BootScreen from '../components/BootScreen.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileBar from '../components/MobileBar.astro';
import BottomNav from '../components/BottomNav.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';
import { getPosts, url } from '../lib/posts';
import { levelOf } from '../lib/quest';
import type { NavKey } from '../lib/nav';

interface Props {
  title?: string;
  description?: string;
  active?: NavKey;
  type?: 'website' | 'article';
  /** 링크 미리보기 이미지. 사이트 기준 경로 또는 절대 URL */
  image?: string;
}
const { title, description = SITE.description, active, type = 'website', image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('images/og.png'), Astro.site).href;
const published = await getPosts();
const { level } = levelOf(published);
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f4f5fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111522" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href={url('fonts/heir-of-light-regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/heir-of-light-bold.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/galmuri11-bold-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Galmuri11';src:url('${url('fonts/galmuri11-bold-latin.woff2')}') format('woff2');font-weight:100 900;font-display:swap}@font-face{font-family:'HeirofLight';src:url('${url('fonts/heir-of-light-regular.woff2')}') format('woff2');font-weight:400;font-display:swap}@font-face{font-family:'HeirofLight';src:url('${url('fonts/heir-of-light-bold.woff2')}') format('woff2');font-weight:700;font-display:swap}`}></style>

    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        // 등장 연출용 초기 숨김은 JS 가 돌고 모션을 허용할 때만 건다
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('js-fx');
      })();
    </script>
  </head>
  <body>
    <BootScreen />
    <!-- 페이지 전체 배경: 깊이 3단 별 + 성운(스크롤 시차). 내용보다 뒤에 깔린다 -->
    <canvas class="backdrop" data-backdrop aria-hidden="true"></canvas>
    <a class="skip sr-only" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <Sidebar active={active} level={level} ids={published.map((p) => p.id)} />
      <div class="pane">
        <MobileBar />
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <BottomNav active={active} />
    <CommandPalette />

    <script>
      import { revealOnScroll, countUp } from '../scripts/fx';
      import { animateCharts } from '../scripts/charts';
      import { soundOn, setSound, wireUiSounds } from '../scripts/sfx';
      import { startBackdrop } from '../scripts/backdrop';
      import { wireMicro } from '../scripts/micro';

      const backdrop = document.querySelector<HTMLCanvasElement>('[data-backdrop]');
      if (backdrop) startBackdrop(backdrop);
      wireMicro();

      wireUiSounds();
      document.querySelectorAll('[data-sound-toggle]').forEach((b) => b.addEventListener('click', () => setSound(!soundOn())));

      const root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
        }),
      );

      const bar = document.querySelector('[data-top-bar]');
      const onScroll = () => bar?.classList.toggle('scrolled', scrollY > 4);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      revealOnScroll();
      countUp();
      animateCharts();
    </script>
  </body>
</html>

<style is:global>
  .js-fx [data-reveal],
  .js-fx [data-reveal-group] > *,
  .js-fx [data-card],
  .js-fx [data-headline] { opacity: 0; }
  .char { display: inline-block; }
</style>

<style>
  .backdrop { position: fixed; inset: 0; z-index: 0; width: 100vw; height: 100vh; pointer-events: none; }
  .shell { position: relative; z-index: 1; display: flex; min-height: 100dvh; }
  .pane { flex: 1; min-width: 0; display: flex; flex-direction: column; padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  @media (min-width: 1024px) { .pane { padding-bottom: 0; } }
  main { flex: 1; }
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; z-index: 100; padding: 8px 16px; background: var(--primary); color: var(--primary-foreground); border-radius: var(--radius-md); }
</style>
