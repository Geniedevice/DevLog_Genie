---
// 폰트는 npm 으로 받아 함께 번들한다(외부 CDN 없음)
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css'; // 본문 폰트에 없는 글자 대비 예비
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';
import { url } from '../lib/posts';
import type { NavKey } from '../lib/nav';

interface Props {
  title?: string;
  description?: string;
  active?: NavKey;
  type?: 'website' | 'article';
  /** 링크 미리보기 이미지. 사이트 기준 경로 또는 절대 URL */
  image?: string;
}
const { title, description = SITE.description, active, type = 'website', image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('images/og.png'), Astro.site).href;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121318" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href={url('fonts/heir-of-light-regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/heir-of-light-bold.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/galmuri11-bold-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Galmuri11';src:url('${url('fonts/galmuri11-bold-latin.woff2')}') format('woff2');font-weight:100 900;font-display:swap}@font-face{font-family:'HeirofLight';src:url('${url('fonts/heir-of-light-regular.woff2')}') format('woff2');font-weight:400;font-display:swap}@font-face{font-family:'HeirofLight';src:url('${url('fonts/heir-of-light-bold.woff2')}') format('woff2');font-weight:700;font-display:swap}`}></style>

    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        // 등장 연출용 초기 숨김은 JS 가 돌고 모션을 허용할 때만 건다
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('js-fx');
      })();
      // 페이지 이동(View Transitions): 앞으로 가면 왼쪽으로 흐르고, 뒤로 가기면 반대로 — 방향에 원인이 있을 때만 바꾼다.
      // 시작 메뉴 · 스테이지([data-iris])를 눌러 왔으면 누른 자리에서 다음 화면이 원으로 열린다(아이리스 와이프)
      addEventListener('pagereveal', (e) => {
        let iris = null;
        try { iris = JSON.parse(sessionStorage.getItem('iris') || 'null'); sessionStorage.removeItem('iris'); } catch {}
        if (!e.viewTransition) return;
        if (iris && Date.now() - iris.t < 5000) {
          document.documentElement.style.setProperty('--iris-x', iris.x + '%');
          document.documentElement.style.setProperty('--iris-y', iris.y + '%');
          e.viewTransition.types.add('iris');
          return;
        }
        const a = window.navigation && navigation.activation;
        if (!a || !a.from || !a.entry) return;
        if (a.navigationType === 'traverse' && a.entry.index < a.from.index) e.viewTransition.types.add('back');
      });
    </script>
  </head>
  <body>
    <a class="skip sr-only" href="#main">본문으로 건너뛰기</a>
    <SiteHeader active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette />

    <script>
      import { countUp } from '../scripts/fx';
      import { animateCharts } from '../scripts/charts';
      import { soundOn, setSound, wireUiSounds } from '../scripts/sfx';
      import { wireMicro } from '../scripts/micro';

      wireMicro();

      // 아이리스 와이프의 중심: 누른 자리(키보드로 눌렀으면 링크 가운데)를 다음 페이지에 넘긴다
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.<HTMLElement>('a[data-iris]');
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
        const r = a.getBoundingClientRect();
        const x = e.detail ? e.clientX : r.left + r.width / 2;
        const y = e.detail ? e.clientY : r.top + r.height / 2;
        try { sessionStorage.setItem('iris', JSON.stringify({ x: (x / innerWidth) * 100, y: (y / innerHeight) * 100, t: Date.now() })); } catch {}
      });

      wireUiSounds();
      document.querySelectorAll('[data-sound-toggle]').forEach((b) => b.addEventListener('click', () => setSound(!soundOn())));

      const root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
        }),
      );

      countUp();
      animateCharts();
    </script>
  </body>
</html>

<style is:global>
  .char { display: inline-block; }
</style>

<style>
  body { display: flex; flex-direction: column; }
  main { flex: 1; }
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; z-index: 100; padding: 8px 16px; background: var(--primary); color: var(--primary-foreground); border-radius: var(--radius-md); }
</style>
