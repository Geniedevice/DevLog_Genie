---
import BaseLayout from '../layouts/BaseLayout.astro';
import Jiny from '../components/Jiny.astro';
import { url } from '../lib/posts';
---
<BaseLayout title="페이지를 찾을 수 없음">
  <div class="nf">
    <div class="art"><Jiny id="lost" /></div>
    <p class="code">404</p>
    <h1>여긴 아무것도 없어요</h1>
    <p class="msg">JINY도 못 찾은 페이지예요. 주소가 바뀌었거나 사라졌을 수 있어요.</p>
    <div class="actions">
      <a class="btn btn-default" href={url()}><span class="msr">home</span>개발 일지로</a>
      <button class="btn btn-outline" type="button" data-open-search><span class="msr">search</span>검색</button>
    </div>
  </div>
</BaseLayout>

<style>
  .nf { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 24px 16px 80px; }
  .art { width: min(300px, 70vw); }
  .code { margin: 0; font: 800 64px/1 var(--font-mono); letter-spacing: -0.04em; background: linear-gradient(120deg, var(--chart-1), var(--chart-3)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  h1 { margin: 10px 0 8px; font-size: clamp(24px, 3vw, 30px); font-weight: 800; }
  .msg { margin: 0 0 24px; color: var(--muted-foreground); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
</style>
