---
import BaseLayout from '../layouts/BaseLayout.astro';
import shapes from '../lib/shapes.json';
import { url } from '../lib/posts';
---
<BaseLayout title="페이지를 찾을 수 없음">
  <div class="nf">
    <svg viewBox="0 0 48 48" aria-hidden="true"><path d={shapes.clover4} /></svg>
    <p class="display-l">404</p>
    <p class="body-l">찾으시는 페이지가 없거나 옮겨졌습니다.</p>
    <div class="actions">
      <a class="btn btn-filled state" href={url()}><span class="msr">home</span>홈으로</a>
      <button class="btn btn-tonal state" type="button" data-open-search><span class="msr">search</span>검색</button>
    </div>
  </div>
</BaseLayout>

<style>
  .nf { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 80px 16px; }
  svg { width: 160px; fill: var(--md-tertiary-container); margin-bottom: -96px; }
  .display-l { position: relative; margin: 0 0 16px; font-weight: 500; color: var(--md-on-tertiary-container); }
  .body-l { margin: 24px 0; color: var(--md-on-surface-variant); }
  .actions { display: flex; gap: 8px; }
</style>
