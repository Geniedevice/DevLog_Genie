---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/posts';
---
<BaseLayout title="페이지를 찾을 수 없음">
  <div class="nf">
    <img class="pixel art" src={url('images/hero-camp.png')} alt="" aria-hidden="true" />
    <p class="eyebrow">404 · Lost in the woods</p>
    <h1 data-headline>길을 잃었어요</h1>
    <p class="msg">찾는 페이지가 없거나 옮겨졌어요. 캠프로 돌아가 볼까요?</p>
    <div class="actions">
      <a class="btn btn-default" href={url()}><span class="msr">home</span>개발 일지로</a>
      <button class="btn btn-outline" type="button" data-open-search><span class="msr">search</span>검색</button>
    </div>
  </div>
</BaseLayout>

<script>
  import { headline } from '../scripts/fx';
  headline(document.querySelector('[data-headline]'), 200);
</script>

<style>
  .nf { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 40px 16px 80px; }
  .art { width: min(560px, 100%); aspect-ratio: 2.4; object-fit: cover; object-position: 50% 80%; border-radius: var(--radius-xl); margin-bottom: 28px; box-shadow: 0 0 0 1px var(--border); }
  h1 { margin: 12px 0 8px; font-size: clamp(30px, 4vw, 40px); font-weight: 800; }
  .msg { margin: 0 0 24px; color: var(--muted-foreground); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
</style>
