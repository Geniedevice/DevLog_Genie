---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { getPosts, url } from '../lib/posts';
import { levelOf, streakOf } from '../lib/quest';

// 소개 페이지 내용은 여기서 직접 고친다
const posts = await getPosts();
const lv = levelOf(posts);
const topics = [
  { icon: 'gamepad-2', title: 'Unreal Engine', body: '게임플레이 프레임워크, GAS, 네트워크 복제처럼 엔진이 실제로 어떻게 돌아가는지.' },
  { icon: 'bug', title: '트러블슈팅', body: '크래시·버그를 추적한 과정과, 원인이 왜 거기 숨어 있었는지.' },
  { icon: 'git-branch', title: '설계 결정', body: '여러 선택지 중 무엇을 골랐고 왜 그렇게 갈렸는지.' },
  { icon: 'history', title: '회고', body: '프로젝트를 마치며 남기는 기록과 다음엔 다르게 할 것들.' },
];
const projects = [
  { name: 'Gears of Deceit', meta: 'Unreal · 5인 팀' },
  { name: 'Crawlescape', meta: 'Unreal · 6인 팀' },
  { name: 'DESTINATION', meta: 'Unreal · 개인' },
];
---
<BaseLayout title="소개" active="about">
  <div class="page">
    <section class="profile" data-reveal>
      <div class="cover" aria-hidden="true"></div>
      <div class="info">
        <img class="avatar" src={url('images/jiny.webp')} alt="대표 캐릭터 JINY" width="96" height="96" />
        <div class="who">
          <h1 data-headline>{SITE.author}</h1>
          <p class="role">Unreal Engine 게임 클라이언트 개발자</p>
        </div>
        <div class="links">
          <a class="btn btn-default" href={SITE.portfolio} target="_blank" rel="noopener"><Icon name="briefcase" />포트폴리오</a>
          <a class="btn btn-outline" href={SITE.github} target="_blank" rel="noopener"><Icon name="code" />GitHub</a>
        </div>
      </div>
      <p class="motto">구현을 넘어 동작 원리를 집요하게 파고듭니다. 무엇을 했는지보다 <strong>왜 그렇게 갈렸는지</strong>를 기록합니다.</p>
      <dl class="numbers">
        <div><dt>레벨</dt><dd>Lv. <span data-count={lv.level}>{lv.level}</span></dd></div>
        <div><dt>누적 XP</dt><dd data-count={lv.total}>{lv.total.toLocaleString('ko-KR')}</dd></div>
        <div><dt>기록</dt><dd data-count={posts.length}>{posts.length}</dd></div>
        <div><dt>연속 기록</dt><dd><span data-count={streakOf(posts)}>{streakOf(posts)}</span>일</dd></div>
      </dl>
    </section>

    <h2 class="section-title"><Icon name="compass" />다루는 주제</h2>
    <div class="grid" data-reveal-group>
      {topics.map((t) => (
        <div class="card topic">
          <Icon name={t.icon} size={26} />
          <h3 class="card-title">{t.title}</h3>
          <p class="card-description">{t.body}</p>
        </div>
      ))}
    </div>

    <h2 class="section-title"><Icon name="folder-open" />프로젝트</h2>
    <ul class="projects" data-reveal-group>
      {projects.map((p) => (
        <li class="card"><Icon name="box" /><span class="p-name">{p.name}</span><span class="p-meta">{p.meta}</span></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  import { headline } from '../scripts/fx';
  headline(document.querySelector('.profile [data-headline]'), 150);
</script>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 24px 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 32px 40px 72px; } }

  .profile { margin-bottom: 48px; border: 1px solid var(--border); border-radius: var(--radius-xl); background: var(--card); overflow: hidden; }
  .cover { height: 150px; background: radial-gradient(circle at 75% 30%, var(--hero-glow), transparent 60%), radial-gradient(color-mix(in srgb, var(--foreground) 12%, transparent) 1px, transparent 1.4px) 0 0 / 20px 20px, linear-gradient(135deg, color-mix(in srgb, var(--chart-1) 25%, var(--card)), var(--card)); }
  .info { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px; padding: 0 24px; margin-top: -40px; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 4px var(--card), 0 0 24px var(--glow); flex: none; }
  .who { flex: 1; min-width: 200px; }
  h1 { margin: 0; font-size: clamp(26px, 3.4vw, 34px); font-weight: 800; letter-spacing: -0.015em; }
  .role { margin: 2px 0 0; color: var(--muted-foreground); font-size: 14px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 4px; }
  .motto { margin: 20px 24px 0; font-size: 16px; line-height: 1.75; }
  .numbers { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1px; margin: 20px 0 0; background: var(--border); border-top: 1px solid var(--border); }
  .numbers div { padding: 16px 24px; background: var(--card); }
  .numbers dt { font-size: 12px; color: var(--muted-foreground); }
  .numbers dd { margin: 4px 0 0; font-size: 24px; font-weight: 800; font-variant-numeric: tabular-nums; }

  .section-title { margin-bottom: 16px; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin-bottom: 48px; }
  .topic { padding: 20px; display: flex; flex-direction: column; gap: 6px; transition: border-color var(--dur), translate var(--dur); }
  .topic:hover { border-color: var(--brand); translate: 0 -3px; }
  .topic > .icon { color: var(--brand); margin-bottom: 6px; }
  .projects { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .projects li { display: flex; align-items: center; gap: 14px; padding: 16px 20px; }
  .projects .icon { color: var(--brand); }
  .p-name { font-weight: 700; }
  .p-meta { margin-left: auto; font-size: 13px; color: var(--muted-foreground); }
</style>
