---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { url } from '../lib/posts';
import { getGames } from '../lib/games';
import { layerMoon, layerFar, layerNear } from '../lib/scene.mjs';

// 소개 페이지 내용은 여기서 직접 고친다(프로젝트 목록은 게임 글에서 자동으로)
const topics = [
  { title: 'Unreal Engine', body: '게임플레이 프레임워크, GAS, 네트워크 복제처럼 엔진이 실제로 어떻게 돌아가는지.' },
  { title: '트러블슈팅', body: '크래시·버그를 추적한 과정과, 원인이 왜 거기 숨어 있었는지.' },
  { title: '설계 결정', body: '여러 선택지 중 무엇을 골랐고 왜 그렇게 갈렸는지.' },
  { title: '회고', body: '프로젝트를 마치며 남기는 기록과 다음엔 다르게 할 것들.' },
];
const games = await getGames();
// 표지: 히어로 창밖 레이어(달 · 먼 산맥 · 지면)를 그대로 쓰고, 하늘~지면 띠만 보이게 viewBox 를 자른다
const cover = [layerMoon(), layerFar(), layerNear()].map((s) => s.replace('viewBox="0 0 1200 520"', 'viewBox="0 20 1200 260"')).join('');
---
<BaseLayout title="소개" active="about">
  <div class="page">
    <section class="profile" data-reveal>
      <div class="cover" aria-hidden="true"><Fragment set:html={cover} /></div>
      <div class="info">
        <img class="avatar" src={url('images/jiny-face.webp')} alt="대표 캐릭터 JINY" width="96" height="96" />
        <div class="who">
          <h1 data-headline>{SITE.author}</h1>
          <p class="role">Unreal Engine 게임 클라이언트 개발자</p>
        </div>
        <div class="links">
          <a class="btn btn-default" href={SITE.portfolio} target="_blank" rel="noopener"><Icon name="briefcase" />포트폴리오</a>
          <a class="btn btn-outline" href={SITE.github} target="_blank" rel="noopener"><Icon name="code" />GitHub</a>
        </div>
      </div>
      <p class="motto">만든 기능의 동작 원리까지 파고듭니다. 무엇을 했는지와 <strong>왜 그렇게 정했는지</strong>를 같이 적어 둡니다.</p>
    </section>

    <h2 class="section-title"><Icon name="compass" />다루는 주제</h2>
    <dl class="topics">
      {topics.map((t) => (
        <div class="topic">
          <dt>{t.title}</dt>
          <dd>{t.body}</dd>
        </div>
      ))}
    </dl>

    <h2 class="section-title"><Icon name="folder-open" />프로젝트</h2>
    <ul class="projects" data-reveal-group>
      {games.map(({ data: { game } }) => (
        <li>
          <a class="card" href={url(`projects/?stage=${game.order}`)}>
            <Icon name="box" /><span class="p-name">{game.title}</span>
            <span class="p-meta">{game.engine.replace('Unreal Engine', 'UE')} · {game.team === 1 ? '개인' : `${game.team}인 팀`}</span>
            <Icon name="chevron-right" size={16} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: var(--content-max); margin: 0 auto; padding: 24px 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 32px 32px 72px; } }

  .profile { margin-bottom: 48px; border: 1px solid var(--border); border-radius: var(--radius-xl); background: var(--card); overflow: hidden; }
  /* 표지는 히어로처럼 테마와 상관없이 늘 밤 */
  .cover { position: relative; height: clamp(168px, 15vw, 210px); background: linear-gradient(var(--night-deep), var(--night)); }
  .cover :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .info { position: relative; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px; padding: 0 24px; margin-top: -40px; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 4px var(--card), var(--shadow-md); flex: none; }
  .who { flex: 1; min-width: 200px; }
  h1 { margin: 0; font-size: clamp(26px, 3.4vw, 34px); font-weight: 800; letter-spacing: -0.015em; }
  .role { margin: 2px 0 0; color: var(--muted-foreground); font-size: 14px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 4px; }
  .motto { margin: 20px 24px 24px; font-size: 16px; line-height: 1.75; }

  .section-title { margin-bottom: 16px; }
  /* 주제는 눌리는 것이 아니라서 카드 대신 줄로 나눈 목록 */
  .topics { display: grid; gap: 0 40px; margin: 0 0 48px; }
  @media (min-width: 640px) { .topics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .topic { padding: 16px 0 18px; border-top: 1px solid var(--border); }
  .topic dt { margin-bottom: 4px; font-size: 17px; font-weight: 700; }
  .topic dd { margin: 0; color: var(--muted-foreground); font-size: 15px; line-height: 1.7; }
  .projects { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .projects a { display: flex; align-items: center; gap: 14px; padding: 16px 20px; transition: border-color var(--dur); }
  .projects a:hover { border-color: var(--brand); }
  .projects .icon { color: var(--brand); }
  .projects .icon:last-child { color: var(--muted-foreground); }
  .p-name { font-weight: 700; }
  .p-meta { margin-left: auto; font-size: 13px; color: var(--muted-foreground); }
</style>
