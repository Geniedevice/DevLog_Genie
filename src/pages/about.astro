---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../site.config';
import { url } from '../lib/posts';

// 소개 페이지 내용은 여기서 직접 고친다
const topics = [
  { icon: 'sports_esports', title: 'Unreal Engine', body: '게임플레이 프레임워크, GAS, 네트워크 복제처럼 엔진이 실제로 어떻게 돌아가는지.' },
  { icon: 'build', title: '트러블슈팅', body: '크래시·버그를 추적한 과정과, 원인이 왜 거기 있었는지.' },
  { icon: 'architecture', title: '설계 결정', body: '여러 선택지 중 무엇을 골랐고 왜 그렇게 갈렸는지.' },
  { icon: 'history_edu', title: '회고', body: '프로젝트를 마치며 남기는 기록과 다음에 다르게 할 것들.' },
];
const projects = [
  { name: 'Gears of Deceit', meta: 'Unreal · 5인 팀' },
  { name: 'Crawlescape', meta: 'Unreal · 6인 팀' },
  { name: 'DESTINATION', meta: 'Unreal · 개인' },
];
---
<BaseLayout title="소개" active="about">
  <div class="page">
    <PageHeader title={SITE.author} subtitle="Unreal Engine 게임 클라이언트 개발자" icon="person" />

    <p class="body-l intro">
      구현을 넘어 동작 원리를 집요하게 파고듭니다. 이 데브로그에는 무엇을 만들었는지보다
      <strong>왜 그렇게 만들었는지</strong>를 기록합니다.
    </p>

    <div class="links">
      <a class="btn btn-filled state" href={SITE.portfolio} target="_blank" rel="noopener"><span class="msr">work</span>포트폴리오</a>
      <a class="btn btn-tonal state" href={SITE.github} target="_blank" rel="noopener"><span class="msr">code</span>GitHub</a>
      <a class="btn btn-outlined state" href={url('rss.xml')}><span class="msr">rss_feed</span>RSS 구독</a>
    </div>

    <h2 class="title-l">다루는 주제</h2>
    <div class="grid">
      {topics.map((t) => (
        <div class="card card-filled topic">
          <span class="msr">{t.icon}</span>
          <h3 class="title-m">{t.title}</h3>
          <p class="body-m">{t.body}</p>
        </div>
      ))}
    </div>

    <h2 class="title-l">프로젝트</h2>
    <ul class="projects">
      {projects.map((p) => (
        <li class="card card-outlined">
          <span class="msr">deployed_code</span>
          <span class="title-m">{p.name}</span>
          <span class="label-m meta">{p.meta}</span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: 960px; margin: 0 auto; padding: 16px 16px 64px; }
  @media (min-width: 840px) { .page { padding: 16px 28px 64px; } }
  .intro { margin: 0 0 24px; max-width: 680px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 48px; }
  h2 { margin: 0 0 16px; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin-bottom: 48px; }
  .topic { padding: 20px; }
  .topic .msr { color: var(--md-primary); margin-bottom: 12px; }
  .topic h3 { margin: 0 0 4px; }
  .topic p { margin: 0; color: var(--md-on-surface-variant); }
  .projects { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .projects li { display: flex; align-items: center; gap: 16px; padding: 16px 20px; }
  .projects .msr { color: var(--md-tertiary); }
  .projects .meta { margin-left: auto; color: var(--md-on-surface-variant); }
</style>
