---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostListItem from '../components/PostListItem.astro';
import { getPosts, type Post } from '../lib/posts';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---
<BaseLayout title="연대기" active="archive">
  <div class="page">
    <PageHeader title="모험 연대기" eyebrow="Chronicle" subtitle={`지금까지 완수한 의뢰 ${posts.length}건`} icon="auto_stories" />
    <div class="timeline">
      {[...byYear].map(([year, list]) => (
        <section class="era" aria-labelledby={`y${year}`}>
          <h2 class="year" id={`y${year}`} data-reveal><span class="gem" aria-hidden="true"></span>{year}년<span class="count">{list.length}건</span></h2>
          <ul class="list" data-reveal-group>
            {list.map((p) => <PostListItem post={p} />)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { max-width: 1000px; margin: 0 auto; padding: 8px 16px 72px; }
  @media (min-width: 900px) { .page { padding: 8px 40px 72px; } }
  .timeline { position: relative; padding-left: 28px; }
  .timeline::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 0; width: 2px; background: linear-gradient(180deg, var(--gold), transparent); }
  .era + .era { margin-top: 40px; }
  .year { position: relative; display: flex; align-items: baseline; gap: 10px; margin: 0 0 14px; font-size: 24px; }
  .gem { position: absolute; left: -28px; top: 8px; width: 16px; height: 16px; rotate: 45deg; background: linear-gradient(135deg, var(--gold-bright), var(--gold)); box-shadow: 0 0 12px var(--glow); }
  .count { font: 500 13px var(--font-sans); color: var(--muted-foreground); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
</style>
