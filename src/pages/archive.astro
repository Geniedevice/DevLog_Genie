---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostListItem from '../components/PostListItem.astro';
import { getPosts, type Post } from '../lib/posts';

const posts = await getPosts();
// 연·월 단위로 묶는다(한국 시간 기준)
const groups = new Map<string, Post[]>();
for (const p of posts) {
  const key = p.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', timeZone: 'Asia/Seoul' });
  groups.set(key, [...(groups.get(key) ?? []), p]);
}
---
<BaseLayout title="연대기" active="archive">
  <div class="page">
    <PageHeader eyebrow="Chronicle" title="연대기" subtitle={`지금까지 남긴 기록 ${posts.length}개`} />
    <div class="timeline">
      {[...groups].map(([month, list]) => (
        <section class="era" aria-label={month}>
          <h2 class="month" data-reveal><span class="dot" aria-hidden="true"></span>{month}<span class="n">{list.length}</span></h2>
          <ul class="list" data-reveal-group>{list.map((p) => <PostListItem post={p} />)}</ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 0 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 0 40px 72px; } }
  .timeline { position: relative; padding-left: 24px; }
  .timeline::before { content: ''; position: absolute; left: 5px; top: 10px; bottom: 0; width: 2px; background: linear-gradient(180deg, var(--brand), transparent); opacity: 0.5; }
  .era + .era { margin-top: 36px; }
  .month { position: relative; display: flex; align-items: baseline; gap: 10px; margin: 0 0 12px; font-size: 19px; font-weight: 800; }
  .dot { position: absolute; left: -24px; top: 7px; width: 12px; height: 12px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 4px var(--brand-soft), 0 0 12px var(--glow); }
  .n { font-size: 13px; font-weight: 500; color: var(--muted-foreground); }
  .list { list-style: none; margin: 0 -8px; padding: 0; display: grid; gap: 6px; }
</style>
