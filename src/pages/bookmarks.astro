---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import VideoCard from '../components/VideoCard.astro';
import { getPosts, url } from '../lib/posts';

// 모든 글 카드를 미리 그려 두고, 브라우저에 저장된 북마크에 해당하는 것만 보여 준다
const posts = await getPosts();
---
<BaseLayout title="북마크" active="bookmarks">
  <div class="page">
    <PageHeader eyebrow="Bookmarks" title="북마크" subtitle="저장한 기록은 이 브라우저에만 보관돼요." />
    <div class="grid" data-grid>
      {posts.map((p) => <VideoCard post={p} hidden />)}
    </div>
    <div class="empty" data-empty hidden>
      <Icon name="bookmark-plus" />
      <p>아직 저장한 기록이 없어요.<br />카드에 마우스를 올리고 북마크 버튼을 눌러 보세요.</p>
      <a class="btn btn-outline" href={url()}>기록 둘러보기</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { getBookmarks, wireBookmarks } from '../scripts/bookmarks';
  import { cardsIn } from '../scripts/fx';

  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function render() {
    const saved = getBookmarks();
    const shown = cards.filter((c) => saved.includes(c.querySelector<HTMLElement>('[data-bookmark]')!.dataset.bookmark!));
    cards.forEach((c) => (c.hidden = !shown.includes(c)));
    empty.hidden = shown.length > 0;
    return shown;
  }

  wireBookmarks();
  cardsIn(render());
  // 여기서 북마크를 해제하면 바로 목록에서 빠지게
  document.addEventListener('bookmarks:change', render);
</script>

<style>
  .page { max-width: 1440px; margin: 0 auto; padding: 0 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 0 40px 72px; } }
  .grid { display: grid; gap: 34px 22px; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .empty { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 64px 16px; border: 1px dashed var(--border); border-radius: var(--radius-xl); text-align: center; color: var(--muted-foreground); }
  .empty .icon { width: 40px; height: 40px; color: var(--brand); }
  .empty p { margin: 0; line-height: 1.7; }
</style>
