---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { getPosts, url } from '../lib/posts';
import { levelOf, streakOf } from '../lib/quest';
import { SITE } from '../site.config';

const PAGE = 12;
const posts = await getPosts();
// 기본 정렬(최신순)에서는 고정 글이 맨 앞
const ordered = [...posts.filter((p) => p.data.pinned), ...posts.filter((p) => !p.data.pinned)];
const categories = [...new Set(posts.map((p) => p.data.category))];
const lv = levelOf(posts);
const streak = streakOf(posts);
const pct = Math.round((lv.xp / lv.next) * 100);
const owner = SITE.author.split(' ')[0].toUpperCase();
---
<BaseLayout active="home">
  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      <img class="pixel" src={url('images/hero-camp.png')} alt="" width="1600" height="640" fetchpriority="high" />
      <div class="fireflies" data-fireflies></div>
    </div>
    <div class="hero-text">
      <p class="eyebrow" data-scramble>{owner}'S DEV JOURNAL</p>
      <h1 data-headline>구현을 넘어, 원리까지.</h1>
      <p class="sub" data-reveal>크래시 추적부터 설계 결정까지, Unreal 개발 모험의 기록.</p>
      <div class="status" data-reveal>
        <span class="lv">Lv. {lv.level}</span>
        <span class="xp" data-xp data-pct={pct} role="progressbar" aria-valuemin="0" aria-valuemax={lv.next} aria-valuenow={lv.xp} aria-label="경험치">
          <span class="xp-fill" data-xp-fill style={`width:${pct}%`}></span>
        </span>
        <span class="xp-text"><span data-xp-num data-value={lv.xp}>{lv.xp.toLocaleString('ko-KR')}</span> / {lv.next.toLocaleString('ko-KR')} XP</span>
        <span class="vsep" aria-hidden="true"></span>
        <span class="streak"><span class="flame" aria-hidden="true">🔥</span>{streak}일 연속 기록</span>
      </div>
    </div>
  </section>

  <section class="feed" aria-labelledby="feed-title">
    <div class="toolbar">
      <h2 id="feed-title" class="feed-title">모든 기록 <span class="count" data-count={posts.length}>{posts.length}</span></h2>
      <span class="vsep wide-only" aria-hidden="true"></span>
      <div class="tabs-line" role="tablist" aria-label="분류" data-tabs>
        <button class="tab" type="button" role="tab" aria-selected="true" data-filter="">전체</button>
        {categories.map((c) => <button class="tab" type="button" role="tab" aria-selected="false" data-filter={c}>{c}</button>)}
        <span class="tab-indicator" data-indicator></span>
      </div>
      <div class="tools">
        <button class="search-box" type="button" data-open-search>
          <span class="msr">search</span><span class="ph">기록 검색…</span><kbd class="kbd">Ctrl K</kbd>
        </button>
        <span class="vsep wide-only" aria-hidden="true"></span>
        <label class="sort">
          <span class="sr-only">정렬</span>
          <select data-sort>
            <option value="new">최신순</option>
            <option value="old">오래된순</option>
            <option value="short">짧은 글부터</option>
            <option value="long">긴 글부터</option>
          </select>
          <span class="msr" aria-hidden="true">expand_more</span>
        </label>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="empty">아직 기록이 없어요.</p>
    ) : (
      <div class="grid" data-grid>
        {ordered.map((post, i) => <VideoCard post={post} eager={i < 3} hidden={i >= PAGE} />)}
      </div>
    )}
    <p class="empty" data-empty hidden>이 분류의 기록은 아직 없어요.</p>
    <div class="more">
      <button class="btn btn-outline" type="button" data-more hidden={ordered.length <= PAGE}><span class="msr">expand_more</span>더 보기</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { headline, scramble, xpBar, fireflies, cardsIn, moveIndicator } from '../scripts/fx';
  import { wireBookmarks } from '../scripts/bookmarks';

  scramble(document.querySelector('[data-scramble]'));
  headline(document.querySelector('[data-headline]'), 250);
  xpBar(document.querySelector('[data-xp]'));
  fireflies(document.querySelector('[data-fireflies]'));
  wireBookmarks();

  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const indicator = document.querySelector<HTMLElement>('[data-indicator]');
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const PAGE = 12;
  let filter = '';
  let limit = PAGE;

  // 서버가 내려준 순서(고정 글 → 최신순)를 기억해 두어야 다른 정렬 뒤에 되돌릴 수 있다
  const original = new Map(cards.map((c, i) => [c, i]));
  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => original.get(a)! - original.get(b)!,
    old: (a, b) => Number(a.dataset.date) - Number(b.dataset.date),
    short: (a, b) => Number(a.dataset.minutes) - Number(b.dataset.minutes),
    long: (a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes),
  };

  function apply(animateAll: boolean) {
    const before = new Set(cards.filter((c) => !c.hidden));
    const sorted = [...cards].sort(sorters[sortSel?.value ?? 'new']);
    sorted.forEach((c) => grid?.append(c));
    const matched = sorted.filter((c) => !filter || c.dataset.category === filter);
    cards.forEach((c) => (c.hidden = true));
    const shown = matched.slice(0, limit);
    shown.forEach((c) => (c.hidden = false));
    if (more) more.hidden = matched.length <= limit;
    if (empty) empty.hidden = matched.length > 0;
    cardsIn(animateAll ? shown : shown.filter((c) => !before.has(c)));
  }

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      filter = tab.dataset.filter ?? '';
      limit = PAGE;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      moveIndicator(indicator, tab);
      apply(true);
    }),
  );
  sortSel?.addEventListener('change', () => { limit = PAGE; apply(true); });
  more?.addEventListener('click', () => { limit += PAGE; apply(false); });

  // 첫 화면: 인디케이터를 제자리에 두고, 카드가 보일 때 차례로 등장
  moveIndicator(indicator, tabs[0], true);
  addEventListener('resize', () => moveIndicator(indicator, tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? null, true));
  document.fonts?.ready.then(() => moveIndicator(indicator, tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? null, true));
  if (grid) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      cardsIn(cards.filter((c) => !c.hidden));
    }, { rootMargin: '0px 0px -5% 0px' });
    io.observe(grid);
  }

  // 글 페이지의 분류 배지에서 ?category= 로 넘어온다
  const initial = new URLSearchParams(location.search).get('category');
  tabs.find((t) => initial && t.dataset.filter === initial)?.click();
</script>

<style>
  /* ── Hero ── */
  .hero { position: relative; min-height: 340px; display: flex; align-items: center; overflow: hidden; }
  .hero-art { position: absolute; inset: 0 0 0 auto; width: min(78%, 1100px); }
  .hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 60%;
    /* 캠프(텐트·모닥불)가 주인공이 되도록 살짝 당겨 본다 */
    scale: 1.3;
    transform-origin: 48% 78%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%), linear-gradient(0deg, transparent 0%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0%, #000 45%), linear-gradient(0deg, transparent 0%, #000 22%);
    mask-composite: intersect;
  }
  :global([data-theme='light']) .hero-art img { opacity: 0.92; }
  .fireflies { position: absolute; inset: 0; pointer-events: none; }
  .fireflies :global(.firefly) { position: absolute; border-radius: 50%; opacity: 0; background: #fff3b0; box-shadow: 0 0 8px 3px rgb(255 214 110 / 0.55); }

  .hero-text { position: relative; z-index: 1; padding: 56px 24px 36px; max-width: 720px; }
  @media (min-width: 1024px) { .hero-text { padding: 64px 40px 40px; } }
  .eyebrow { margin-bottom: 18px; }
  h1 { margin: 0 0 10px; font-size: clamp(34px, 5vw, 56px); font-weight: 800; line-height: 1.15; letter-spacing: -0.035em; text-shadow: 0 2px 20px var(--hero-fade); }
  .sub { margin: 0 0 30px; font-size: clamp(16px, 1.8vw, 20px); color: color-mix(in srgb, var(--foreground) 78%, transparent); text-shadow: 0 1px 12px var(--hero-fade); }

  .status { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; font-size: 14px; }
  .lv { font-weight: 800; }
  .xp { position: relative; width: 120px; height: 6px; border-radius: 99px; background: color-mix(in srgb, var(--foreground) 16%, transparent); overflow: hidden; }
  .xp-fill { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: linear-gradient(90deg, var(--brand), color-mix(in srgb, var(--brand) 60%, #fff)); box-shadow: 0 0 10px var(--glow); }
  .xp-text { color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
  .vsep { width: 1px; height: 18px; background: var(--border); }
  .streak { display: inline-flex; align-items: center; gap: 6px; color: var(--amber); font-weight: 700; }
  .flame { display: inline-block; animation: flicker 1.6s ease-in-out infinite; transform-origin: 50% 90%; }
  @keyframes flicker { 30% { scale: 1.12 0.94; rotate: -4deg; } 60% { scale: 0.95 1.08; rotate: 3deg; } }

  @media (max-width: 767px) {
    .hero { min-height: 0; flex-direction: column; align-items: stretch; }
    .hero-art { position: relative; inset: auto; width: 100%; aspect-ratio: 2.4; }
    .hero-art img { scale: 1; object-position: 50% 80%; -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 40%); mask-image: linear-gradient(0deg, transparent 0%, #000 40%); }
    .hero-text { padding: 0 16px 28px; margin-top: -24px; }
    .eyebrow { font-size: 10.5px; letter-spacing: 0.24em; }
  }

  /* ── Feed ── */
  .feed { padding: 0 16px 56px; }
  @media (min-width: 1024px) { .feed { padding: 0 40px 72px; } }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 24px; border-bottom: 1px solid var(--border); }
  .feed-title { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 19px; font-weight: 700; height: 44px; }
  .count { display: inline-grid; place-items: center; min-width: 32px; height: 26px; padding: 0 8px; border-radius: var(--radius-sm); background: var(--secondary); color: var(--secondary-foreground); font-size: 14px; font-variant-numeric: tabular-nums; }
  .tabs-line { flex: 1; min-width: 0; margin-bottom: -1px; }
  .tools { display: flex; align-items: center; gap: 12px; padding-bottom: 6px; }

  .search-box { display: flex; align-items: center; gap: 10px; width: 250px; height: 40px; padding: 0 8px 0 12px; border: 1px solid var(--input); border-radius: var(--radius-md); background: var(--card); color: var(--muted-foreground); font: 400 14px/1 var(--font-sans); cursor: text; transition: border-color var(--dur); }
  .search-box:hover { border-color: var(--brand); }
  .search-box .msr { font-size: 19px; }
  .ph { flex: 1; text-align: left; }

  .sort { position: relative; display: inline-flex; align-items: center; }
  .sort select { appearance: none; height: 40px; padding: 0 30px 0 10px; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--foreground); font: 700 14px var(--font-sans); cursor: pointer; }
  .sort select:hover { background: var(--accent); }
  .sort select option { background: var(--popover); color: var(--popover-foreground); }
  .sort .msr { position: absolute; right: 6px; pointer-events: none; font-size: 20px; }

  @media (max-width: 1199px) {
    .toolbar { border-bottom: 0; }
    .tabs-line { order: 3; flex-basis: 100%; border-bottom: 1px solid var(--border); }
    .tools { margin-left: auto; padding-bottom: 0; }
    .wide-only { display: none; }
  }
  @media (max-width: 599px) {
    .search-box { width: 40px; padding: 0; justify-content: center; }
    .search-box .ph, .search-box .kbd { display: none; }
  }

  .grid { display: grid; gap: 34px 22px; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  @media (min-width: 1400px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 639px) { .grid { grid-template-columns: 1fr; } }
  .empty { margin: 32px 0; text-align: center; color: var(--muted-foreground); }
  .more { display: flex; justify-content: center; margin-top: 36px; }
</style>
