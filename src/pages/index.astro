---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, tagCounts, url } from '../lib/posts';
import shapes from '../lib/shapes.json';
import { SITE } from '../site.config';

const PAGE = 12;
const posts = await getPosts();
// 대표 글: 고정 글이 있으면 그중 최신, 없으면 가장 최근 글
const featured = posts.find((p) => p.data.pinned) ?? posts[0];
const categories = [...new Set(posts.map((p) => p.data.category))];
const tagTotal = tagCounts(posts).length;
---
<BaseLayout active="home">
  <section class="intro">
    <div class="intro-text">
      <p class="label-l eyebrow">Unreal Engine · Game Client</p>
      <h1 class="display-m">{SITE.title}</h1>
      <p class="body-l lead">{SITE.description}</p>
      <ul class="stats label-l">
        <li class="stat"><span class="msr">article</span>글 <strong>{posts.length}</strong></li>
        <li class="stat"><span class="msr">category</span>카테고리 <strong>{categories.length}</strong></li>
        <li><a class="stat state" href={url('tags/')}><span class="msr">sell</span>태그 <strong>{tagTotal}</strong></a></li>
      </ul>
    </div>
    <div class="intro-art" aria-hidden="true">
      <svg class="a1" viewBox="0 0 48 48"><path d={shapes.flower8} /></svg>
      <svg class="a2" viewBox="0 0 48 48"><path d={shapes.clover4} /></svg>
      <svg class="a3" viewBox="0 0 48 48"><path d={shapes.cookie12} /></svg>
      <svg class="a4" viewBox="0 0 48 48"><use href="#logo-shape" /></svg>
    </div>
  </section>

  {featured && (
    <section class="featured-wrap" data-featured-section aria-label="대표 글">
      <PostCard post={featured} featured eager />
    </section>
  )}

  <section class="posts" id="posts" aria-labelledby="posts-title">
    <div class="section-head">
      <h2 class="headline-s" id="posts-title">최근 글</h2>
      <div class="filters" role="toolbar" aria-label="카테고리 필터">
        <button class="chip state" type="button" data-filter="" aria-pressed="true"><span class="msr">done</span>전체</button>
        {categories.map((c) => (
          <button class="chip state" type="button" data-filter={c} aria-pressed="false">{c}</button>
        ))}
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="body-l empty">아직 글이 없습니다.</p>
    ) : (
      <div class="grid" data-grid>
        {posts.map((post, i) => (
          <div class="cell" data-cell data-category={post.data.category} data-dup={post === featured ? '' : undefined} hidden={post === featured || i > PAGE}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    )}
    <p class="body-m empty" data-grid-empty hidden>이 카테고리의 다른 글이 아직 없습니다.</p>
    <div class="more">
      <button class="btn btn-outlined state" type="button" data-more hidden={posts.length - 1 <= PAGE}>
        <span class="msr">expand_more</span>더 보기
      </button>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ PAGE }}>
  const cells = [...document.querySelectorAll('[data-cell]')];
  const chips = [...document.querySelectorAll('[data-filter]')];
  const more = document.querySelector('[data-more]');
  const featuredSection = document.querySelector('[data-featured-section]');
  const emptyMsg = document.querySelector('[data-grid-empty]');
  let filter = '';
  let limit = PAGE;

  // "전체"일 때는 대표 글이 위에 크게 있으니 목록에서는 뺀다. 카테고리를 고르면 대표 영역을 접고 목록에 합친다.
  function apply() {
    if (featuredSection) featuredSection.hidden = !!filter;
    const matched = cells.filter((c) => (filter ? c.dataset.category === filter : !('dup' in c.dataset)));
    cells.forEach((c) => (c.hidden = true));
    matched.slice(0, limit).forEach((c) => (c.hidden = false));
    if (more) more.hidden = matched.length <= limit;
    if (emptyMsg) emptyMsg.hidden = matched.length > 0 || !cells.length;
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter;
      limit = PAGE;
      chips.forEach((c) => {
        const on = c === chip;
        c.setAttribute('aria-pressed', String(on));
        const icon = c.querySelector('.msr');
        if (on && !icon) c.insertAdjacentHTML('afterbegin', '<span class="msr">done</span>');
        if (!on && icon) icon.remove();
      });
      apply();
    }),
  );
  more?.addEventListener('click', () => { limit += PAGE; apply(); });
  apply();

  // 글 상단의 카테고리 칩에서 ?category= 로 넘어온다
  const initial = new URLSearchParams(location.search).get('category');
  chips.find((c) => initial && c.dataset.filter === initial)?.click();
</script>

<style>
  .intro,
  .featured-wrap,
  .posts { max-width: 1168px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
  @media (min-width: 840px) {
    .intro, .featured-wrap, .posts { padding-left: 32px; padding-right: 32px; }
  }

  /* ── Intro ── */
  .intro { display: flex; align-items: center; gap: 32px; padding-top: 24px; padding-bottom: 40px; }
  .intro-text { flex: 1; min-width: 0; }
  .eyebrow { margin: 0 0 8px; color: var(--md-primary); }
  h1 { margin: 0 0 12px; font-weight: 500; }
  .lead { margin: 0 0 24px; max-width: 560px; color: var(--md-on-surface-variant); }
  .stats { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .stat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 14px 0 10px;
    border-radius: var(--md-shape-sm);
    background: var(--md-surface-container-high);
    color: var(--md-on-surface-variant);
  }
  .stats .msr { font-size: 18px; color: var(--md-primary); }
  .stats strong { color: var(--md-on-surface); }

  .intro-art { position: relative; width: 280px; height: 220px; flex: none; }
  .intro-art svg { position: absolute; }
  .a1 { width: 200px; right: 0; top: 0; fill: var(--md-primary-container); animation: spin 50s linear infinite; }
  .a2 { width: 120px; left: 0; bottom: 0; fill: var(--md-tertiary-container); animation: spin 40s linear infinite reverse; }
  .a3 { width: 64px; left: 60px; top: 10px; fill: var(--md-secondary-container); }
  .a4 { width: 96px; right: 52px; top: 52px; color: var(--md-primary); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 839px) { .intro-art { display: none; } }

  /* ── Featured ── */
  .featured-wrap { padding-bottom: 16px; }

  /* ── List ── */
  .posts { padding-top: 40px; padding-bottom: 64px; }
  .section-head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
  @media (min-width: 840px) { .section-head { flex-direction: row; align-items: center; justify-content: space-between; } }
  .section-head h2 { margin: 0; font-weight: 500; }
  .filters { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px; }
  .filters::-webkit-scrollbar { display: none; }

  .grid { display: grid; gap: 40px 24px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  @media (max-width: 599px) { .grid { grid-template-columns: 1fr; } }
  .empty { color: var(--md-on-surface-variant); }
  .more { display: flex; justify-content: center; margin-top: 40px; }
</style>
