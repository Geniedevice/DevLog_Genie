---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuestPoster from '../components/QuestPoster.astro';
import MagicCircle from '../components/MagicCircle.astro';
import { getPosts, tagCounts } from '../lib/posts';
import { expOf } from '../lib/quest';
import { SITE } from '../site.config';

const PAGE = 9;
const posts = await getPosts();
// 긴급 의뢰: 고정 글 중 최신, 없으면 가장 최근 글
const featured = posts.find((p) => p.data.pinned) ?? posts[0];
const ordered = featured ? [featured, ...posts.filter((p) => p !== featured)] : [];
const categories = [...new Set(posts.map((p) => p.data.category))];
const totalExp = posts.reduce((n, p) => n + expOf(p), 0);
const stats = [
  { icon: 'assignment', label: '등록된 의뢰', value: posts.length },
  { icon: 'diamond', label: '각인', value: tagCounts(posts).length },
  { icon: 'paid', label: '누적 보상 EXP', value: totalExp },
];
---
<BaseLayout active="home">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow" data-rune>Adventurer's Guild</p>
      <h1 class="font-display title" data-hero-title>{SITE.title}</h1>
      <p class="lead" data-reveal>Unreal Engine 세계를 누비며 마주친 버그를 토벌하고, 그 전투의 기록을 게시판에 남깁니다.</p>
      <div class="cta" data-reveal>
        <a class="btn btn-default" href="#board"><span class="msr">swords</span>토벌 게시판 보기</a>
        <button class="btn btn-outline" type="button" data-open-search><span class="msr">blur_on</span>수정구슬 검색</button>
      </div>
      <dl class="stats" data-reveal-group>
        {stats.map((s) => (
          <div class="stat">
            <dt><span class="msr">{s.icon}</span>{s.label}</dt>
            <dd data-count={s.value}>{s.value.toLocaleString('ko-KR')}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="hero-art" aria-hidden="true">
      <MagicCircle class="circle" />
      <svg class="emblem" viewBox="0 0 48 48"><use href="#emblem" /></svg>
    </div>
  </section>

  <section class="board-section" id="board" aria-labelledby="board-title">
    <div class="board-head">
      <div class="sign wood" data-reveal>
        <span class="chain l" aria-hidden="true"></span><span class="chain r" aria-hidden="true"></span>
        <h2 id="board-title"><span class="msr">swords</span>토벌 게시판</h2>
      </div>
      <div class="tabs" role="tablist" aria-label="의뢰 분류" data-reveal>
        <button class="tab" type="button" role="tab" aria-selected="true" data-filter=""><span class="msr">select_all</span>전체</button>
        {categories.map((c) => <button class="tab" type="button" role="tab" aria-selected="false" data-filter={c}>{c}</button>)}
      </div>
    </div>

    <div class="board wood" data-board data-page={PAGE}>
      {ordered.length === 0 ? (
        <p class="empty">아직 게시된 의뢰가 없습니다.</p>
      ) : (
        <div class="grid">
          {ordered.map((post, i) => (
            <div class:list={['cell', { wide: post === featured }]} data-cell data-category={post.data.category} data-featured={post === featured ? '' : undefined} hidden={i > PAGE}>
              <QuestPoster post={post} all={posts} urgent={post === featured} eager={i === 0} />
            </div>
          ))}
        </div>
      )}
      <p class="empty" data-empty hidden>이 분류의 의뢰는 아직 없습니다.</p>
    </div>
    <div class="more">
      <button class="btn btn-outline" type="button" data-more hidden={ordered.length <= PAGE + 1}><span class="msr">expand_more</span>의뢰 더 보기</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { titleIntro, runeScramble, drawMagicCircle, boardIntro, reshuffle } from '../scripts/fx';

  titleIntro(document.querySelector('[data-hero-title]'));
  runeScramble(document.querySelector('[data-rune]'));
  drawMagicCircle(document.querySelector('[data-magic-circle]'));
  boardIntro(document.querySelector('[data-board]'));

  const PAGE = Number(document.querySelector<HTMLElement>('[data-board]')?.dataset.page ?? 9);
  const cells = [...document.querySelectorAll<HTMLElement>('[data-cell]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let filter = '';
  let limit = PAGE + 1; // 긴급 의뢰 한 장 + PAGE

  function apply(animate: boolean) {
    const matched = cells.filter((c) => !filter || c.dataset.category === filter);
    cells.forEach((c) => (c.hidden = true));
    matched.slice(0, limit).forEach((c) => {
      c.hidden = false;
      // 분류를 좁히면 긴급 의뢰도 일반 칸 크기로
      c.classList.toggle('wide', 'featured' in c.dataset && !filter);
    });
    if (more) more.hidden = matched.length <= limit;
    if (empty) empty.hidden = matched.length > 0;
    if (animate) reshuffle(cells.filter((c) => !c.hidden).map((c) => c.querySelector<HTMLElement>('[data-poster]')!));
  }

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      filter = tab.dataset.filter ?? '';
      limit = PAGE + 1;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      apply(true);
    }),
  );
  more?.addEventListener('click', () => {
    const before = new Set(cells.filter((c) => !c.hidden));
    limit += PAGE;
    apply(false);
    reshuffle(cells.filter((c) => !c.hidden && !before.has(c)).map((c) => c.querySelector<HTMLElement>('[data-poster]')!));
  });

  // 글 상단의 분류 배지에서 ?category= 로 넘어온다
  const initial = new URLSearchParams(location.search).get('category');
  tabs.find((t) => initial && t.dataset.filter === initial)?.click();
</script>

<style>
  .hero,
  .board-section { max-width: 1200px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
  @media (min-width: 900px) { .hero, .board-section { padding-left: 40px; padding-right: 40px; } }

  /* ── Hero ── */
  .hero { display: grid; align-items: center; gap: 24px; padding-top: 24px; padding-bottom: 56px; }
  @media (min-width: 900px) { .hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); padding-top: 32px; padding-bottom: 72px; } }
  .title {
    margin: 12px 0 16px;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 1.02;
    --title-fill: linear-gradient(180deg, var(--gold-bright), var(--gold) 60%, color-mix(in srgb, var(--gold) 60%, #000));
    filter: drop-shadow(0 4px 18px var(--glow));
  }
  /* ⚠️ splitText 가 글자를 단어 span 안에 한 번 더 감싸서 background: inherit 로는 h1 의 그라디언트가 안 내려온다.
     쪼개기 전(h1)과 후(.char) 양쪽에 직접 칠한다. */
  .title,
  .title :global(.char) {
    background: var(--title-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .title:has(:global(.char)) { background: none; }
  .lead { margin: 0 0 28px; max-width: 520px; font-size: 17px; color: var(--muted-foreground); }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; }

  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; max-width: 540px; }
  .stat { padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--card) 75%, transparent); backdrop-filter: blur(6px); }
  .stat dt { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted-foreground); }
  .stat dt .msr { font-size: 16px; color: var(--gold); }
  .stat dd { margin: 6px 0 0; font: 700 clamp(20px, 3vw, 28px)/1 var(--font-display); color: var(--foreground); font-variant-numeric: tabular-nums; }
  @media (max-width: 599px) {
    .stat { padding: 10px; }
    .stat dt { font-size: 11px; white-space: nowrap; }
    .stat dt .msr { display: none; }
  }

  .hero-art { position: relative; display: grid; place-items: center; aspect-ratio: 1; max-width: 440px; width: 100%; justify-self: center; }
  .hero-art :global(.circle) { position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 0 12px var(--glow)); }
  .emblem { position: relative; width: 38%; filter: drop-shadow(0 12px 30px var(--glow)); animation: float 6s ease-in-out infinite; }
  @keyframes float { 50% { translate: 0 -12px; } }
  @media (max-width: 899px) { .hero-art { max-width: 260px; order: -1; } }

  /* ── Board ── */
  .board-section { padding-bottom: 72px; }
  .board-head { display: flex; flex-direction: column; align-items: center; gap: 20px; margin-bottom: 28px; }
  .sign {
    position: relative;
    margin-top: 30px;
    padding: 14px 36px;
    border-radius: var(--radius-md);
    border: 2px solid var(--wood-dark);
    box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.15);
    transform-origin: 50% -30px;
  }
  .sign h2 { display: flex; align-items: center; gap: 10px; margin: 0; font-size: clamp(22px, 3vw, 30px); color: #f7e3b0; text-shadow: 0 2px 0 rgb(0 0 0 / 0.5); }
  .sign .msr { color: #f4cf78; font-size: 28px; }
  .chain { position: absolute; top: -30px; width: 2px; height: 30px; background: repeating-linear-gradient(180deg, #8a7a5a 0 4px, #4a3e2a 4px 6px); }
  .chain.l { left: 24px; rotate: 10deg; transform-origin: bottom; }
  .chain.r { right: 24px; rotate: -10deg; transform-origin: bottom; }
  .sign:hover { animation: swing 1.2s ease-in-out; }
  @keyframes swing { 25% { rotate: 3deg; } 60% { rotate: -2deg; } 85% { rotate: 1deg; } }

  .board {
    padding: clamp(20px, 3vw, 40px);
    border-radius: var(--radius-xl);
    border: 10px solid var(--wood-dark);
    box-shadow: inset 0 0 40px rgb(0 0 0 / 0.55), 0 30px 60px -20px rgb(0 0 0 / 0.6), 0 0 0 1px color-mix(in srgb, var(--gold) 30%, transparent);
  }
  .grid { display: grid; gap: clamp(22px, 3vw, 36px) clamp(18px, 2.4vw, 28px); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .cell.wide { grid-column: 1 / -1; }
  @media (min-width: 900px) { .cell.wide { max-width: 980px; justify-self: center; width: 100%; } }
  .empty { margin: 24px 0; text-align: center; color: #f1e2bf; font-family: var(--font-serif); }
  .more { display: flex; justify-content: center; margin-top: 32px; }
</style>
