---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import GalleryCard from '../components/GalleryCard.astro';
import HeroScene from '../components/HeroScene.astro';
import KpiCard from '../components/charts/KpiCard.astro';
import Heatmap from '../components/charts/Heatmap.astro';
import { getPosts, url } from '../lib/posts';
import { monthly, heatmap, totals } from '../lib/stats';
import { getGames } from '../lib/games';
import Thumbnail from '../components/Thumbnail.astro';

const games = await getGames();

const PAGE = 12;
const posts = await getPosts();
// 기본 정렬(최신순)에서는 고정 글이 맨 앞
const ordered = [...posts.filter((p) => p.data.pinned), ...posts.filter((p) => !p.data.pinned)];
const categories = [...new Set(posts.map((p) => p.data.category))];
const t = totals(posts);
const months = monthly(posts, 8);
const SEGMENTS = 10;
const filled = Math.round((t.xp / t.next) * SEGMENTS);
---
<BaseLayout active="home">
  <section class="hero" data-hero>
    <div class="hero-art"><HeroScene /></div>
    <div class="hero-text" data-hero-text>
      <p class="eyebrow pixel-font" data-reveal>GENIE LAB</p>
      <h1 class="headline" data-type>
        <span class="l1">Dev</span><span class="l2">Log</span>
      </h1>
      <p class="sub" data-reveal>게임 개발 기록</p>
      <div class="hud pixel-font" data-reveal>
        <span class="lv">LV {t.level}</span>
        <span class="seg" data-segs role="progressbar" aria-label="경험치" aria-valuemin="0" aria-valuemax={t.next} aria-valuenow={t.xp}>
          {Array.from({ length: SEGMENTS }, (_, i) => <i class:list={{ on: i < filled }}></i>)}
        </span>
        <span class="xp">{t.xp}/{t.next} XP</span>
        <span class="streak"><Icon name="flame" size={14} fill />{t.streak} DAY</span>
      </div>
      <!-- 다이내믹 카운터: 화면에 들어오면 0 에서 차오른다 -->
      <dl class="counters" data-reveal>
        <div><dt>기록</dt><dd><span data-count={t.posts}>{t.posts}</span><small>편</small></dd></div>
        <div><dt>읽기 시간</dt><dd><span data-count={t.minutes}>{t.minutes}</span><small>분</small></dd></div>
        <div><dt>누적 XP</dt><dd><span data-count={t.total}>{t.total}</span></dd></div>
        <div><dt>태그</dt><dd><span data-count={t.tags}>{t.tags}</span><small>개</small></dd></div>
      </dl>
    </div>
    <a class="scroll-cue pixel-font" href="#feed" aria-label="기록 목록으로"><span>SCROLL</span><i></i></a>
  </section>

  {games.length > 0 && (
    <section class="games" aria-labelledby="games-title">
      <div class="games-head">
        <h2 class="section-title" id="games-title"><Icon name="gamepad-2" />게임 프로젝트</h2>
        <a class="btn btn-ghost btn-sm" href={url('projects/')}><span class="pixel-font">STAGE SELECT</span><Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="game-row" data-reveal-group>
        {games.map((g, i) => (
          <a class="game" href={url(`projects/?stage=${i + 1}`)} data-tilt>
            <span class="g-art"><Thumbnail post={g} text={false} sizes="(min-width: 1024px) 30vw, 90vw" /><span class="g-scan" aria-hidden="true"></span></span>
            <span class="g-no pixel-font">STAGE {String(i + 1).padStart(2, '0')}</span>
            <span class="g-body">
              <span class="g-title">{g.data.game.title}</span>
              <span class="g-tag">{g.data.game.tagline}</span>
              <span class="g-meta pixel-font">{g.data.game.team === 1 ? 'SOLO' : `${g.data.game.team} PLAYERS`} · {g.data.game.engine.replace('Unreal Engine', 'UE')}</span>
            </span>
            <span class="g-press pixel-font" aria-hidden="true">▶ START</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="feed" id="feed" aria-label="기록 목록">
    <div class="toolbar">
      <div class="chips" role="toolbar" aria-label="분류">
        <button class="chip" type="button" aria-pressed="true" data-filter="">전체</button>
        {categories.map((c) => <button class="chip" type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
      </div>
      <div class="tools">
        <button class="search-box" type="button" data-open-search>
          <Icon name="search" /><span class="ph">글을 검색해보세요…</span><kbd class="kbd">Ctrl K</kbd>
        </button>
        <label class="sort">
          <span class="sr-only">정렬</span>
          <select data-sort>
            <option value="new">최신순</option>
            <option value="old">오래된순</option>
            <option value="short">짧은 글부터</option>
            <option value="long">긴 글부터</option>
          </select>
          <Icon name="chevron-down" size={16} />
        </label>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="empty">아직 기록이 없어요.</p>
    ) : (
      <div class="gallery" data-grid>
        {ordered.map((post, i) => <GalleryCard post={post} eager={i < 3} hidden={i >= PAGE} />)}
      </div>
    )}
    <p class="empty" data-empty hidden>이 분류의 기록은 아직 없어요.</p>
    <div class="more">
      <button class="btn btn-outline" type="button" data-more hidden={ordered.length <= PAGE}><Icon name="chevron-down" />더 보기</button>
    </div>
  </section>

  <section class="activity" aria-labelledby="activity-title">
    <div class="sec-head">
      <h2 class="section-title" id="activity-title"><Icon name="activity" />플레이 로그</h2>
      <a class="btn btn-ghost btn-sm" href={url('stats/')}>통계 자세히<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="kpis">
      <KpiCard label="전체 기록" value={t.posts} unit="개" icon="file-text" hint="최근 8개월" spark={months.map((m) => m.count)} color="var(--chart-1)" />
      <KpiCard label="총 읽기 시간" value={t.minutes} unit="분" icon="clock" hint={`글당 평균 ${t.avgMinutes}분`} spark={months.map((m) => m.minutes)} color="var(--chart-2)" />
      <KpiCard label="누적 경험치" value={t.total} unit="XP" icon="zap" hint={`Lv. ${t.level} · 다음 레벨까지 ${t.next - t.xp} XP`} color="var(--chart-3)" />
      <KpiCard label="연속 기록" value={t.streak} unit="일" icon="flame" hint={`태그 ${t.tags}개 · 분류 ${t.categories}개`} color="var(--chart-5)" />
    </div>
    <div class="card chart-card">
      <header><div><h3>기록 잔디</h3><p>하루에 남긴 기록 수</p></div></header>
      <Heatmap cols={heatmap(posts, 26)} />
    </div>
  </section>
</BaseLayout>

<script>
  import { animate, onScroll, splitText, stagger, steps } from 'animejs';
  import { reduced, cardsIn } from '../scripts/fx';
  import { wireBookmarks } from '../scripts/bookmarks';
  import { markReadCards } from '../scripts/read';

  // 제목: 게임 대사창처럼 한 글자씩 찍히고 끝에 커서가 깜빡인다
  const head = document.querySelector<HTMLElement>('[data-type]');
  if (head && !reduced()) {
    const { chars } = splitText(head, { chars: { class: 'char' } });
    head.style.opacity = '1';
    const cursor = document.createElement('span');
    cursor.className = 'cursor';
    cursor.setAttribute('aria-hidden', 'true');
    head.querySelector('.l2')?.append(cursor);
    animate(chars, { opacity: [0, 1], translateY: ['0.2em', '0em'], duration: 60, delay: stagger(55, { start: 350 }), ease: steps(1) });
    animate(cursor, { opacity: [1, 0], duration: 520, loop: true, alternate: true, ease: steps(1) });
  }

  // XP 칸이 하나씩 켜진다
  const segs = [...document.querySelectorAll<HTMLElement>('[data-segs] i.on')];
  if (segs.length && !reduced()) animate(segs, { opacity: [0, 1], scaleY: [0.3, 1], duration: 120, delay: stagger(90, { start: 1400 }), ease: steps(2) });

  wireBookmarks();
  markReadCards();

  // 히어로 글자도 한 겹의 레이어: 스크롤하면 장면보다 빠르게 떠오르며 흐려진다
  const heroText = document.querySelector<HTMLElement>('[data-hero-text]');
  const heroEl = document.querySelector<HTMLElement>('[data-hero]');
  if (heroText && heroEl && !reduced()) {
    animate(heroText, { translateY: [0, -220], opacity: [1, 0], ease: 'linear', autoplay: onScroll({ target: heroEl, enter: 'start start', leave: 'start end', sync: 0.25 }) });
    animate('.scroll-cue i', { translateY: [0, 8], opacity: [1, 0.3], duration: 800, loop: true, alternate: true, ease: 'inOutSine' });
  }

  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const PAGE = 12;
  let filter = '';
  let limit = PAGE;

  // 서버가 내려준 순서(고정 글 → 최신순)를 기억해 두어야 다른 정렬 뒤에 되돌릴 수 있다
  const original = new Map(cards.map((c, i) => [c, i]));
  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => original.get(a)! - original.get(b)!,
    old: (a, b) => Number(a.dataset.date) - Number(b.dataset.date),
    short: (a, b) => Number(a.dataset.minutes) - Number(b.dataset.minutes),
    long: (a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes),
  };

  function apply(animateAll: boolean) {
    const before = new Set(cards.filter((c) => !c.hidden));
    const sorted = [...cards].sort(sorters[sortSel?.value ?? 'new']);
    sorted.forEach((c) => grid?.append(c));
    const matched = sorted.filter((c) => !filter || c.dataset.category === filter);
    cards.forEach((c) => (c.hidden = true));
    const shown = matched.slice(0, limit);
    shown.forEach((c) => (c.hidden = false));
    if (more) more.hidden = matched.length <= limit;
    if (empty) empty.hidden = matched.length > 0;
    cardsIn(animateAll ? shown : shown.filter((c) => !before.has(c)));
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? '';
      limit = PAGE;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      if (!reduced()) animate(chip, { scale: [0.9, 1.06, 1], duration: 380, ease: 'outBack(3)' });
      apply(true);
    }),
  );
  sortSel?.addEventListener('change', () => { limit = PAGE; apply(true); });
  more?.addEventListener('click', () => { limit += PAGE; apply(false); });

  if (grid) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      cardsIn(cards.filter((c) => !c.hidden));
    }, { rootMargin: '0px 0px -5% 0px' });
    io.observe(grid);
  }

  // 글 페이지의 분류 링크에서 ?category= 로 넘어온다
  const initial = new URLSearchParams(location.search).get('category');
  chips.find((c) => initial && c.dataset.filter === initial)?.click();
</script>

<style>
  /* ── Hero ── */
  /* ⚠️ 글과 장면을 같은 격자 칸에 겹쳐 둔다: 히어로 높이 = 둘 중 큰 쪽. 장면은 원래 비율을 지켜야 잘리지 않는다 */
  .hero { position: relative; display: grid; align-items: center; overflow: hidden; border-bottom: 1px solid var(--border); background: #111522; }
  .hero > .hero-art, .hero > .hero-text { grid-area: 1 / 1; }
  .hero-art { position: relative; justify-self: end; width: min(74%, 1080px); -webkit-mask-image: linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent); }

  /* 왼쪽 글자 쪽으로 장면이 스르르 사라지게 */
  .hero-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #111522 0%, rgb(17 21 34 / 0.85) 12%, transparent 42%); pointer-events: none; z-index: 3; }

  .hero-text { position: relative; z-index: 4; padding: 56px 24px 44px; max-width: 640px; color: #e7ebf5; }
  @media (min-width: 1024px) { .hero-text { padding: 64px 48px 52px; } }
  .eyebrow { margin: 0 0 20px; font-size: 12px; letter-spacing: 0.36em; color: #98a0b8; }
  .headline { margin: 0 0 10px; font-size: clamp(52px, 7.4vw, 104px); font-weight: 900; line-height: 1; letter-spacing: -0.055em; white-space: nowrap; text-shadow: 0 4px 30px rgb(0 0 0 / 0.6); }
  .headline .l2 { color: #a99be8; }
  .headline :global(.cursor) { display: inline-block; width: 0.42em; height: 0.9em; margin-left: 6px; vertical-align: -0.08em; background: #8fd4c1; }
  :global(.js-fx) .headline { opacity: 0; }
  .sub { margin: 0 0 26px; font-size: clamp(15px, 1.5vw, 18px); color: rgb(231 235 245 / 0.78); }

  .hud { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 10px 14px; border: 1px solid #283048; border-radius: 10px; background: rgb(17 21 34 / 0.72); backdrop-filter: blur(6px); font-size: 12px; letter-spacing: 0.1em; }
  .lv { color: #8fd4c1; }
  .seg { display: inline-flex; gap: 3px; padding: 2px; border: 1px solid #3a4466; }
  .seg i { width: 9px; height: 12px; background: #232b40; }
  .seg i.on { background: linear-gradient(#b9adff, #a99be8); box-shadow: 0 0 6px rgb(169 155 232 / 0.6); }
  .xp { color: #98a0b8; }
  .streak { display: inline-flex; align-items: center; gap: 4px; color: #f2cf7a; }

  .counters { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 22px 0 0; }
  .counters dt { font-size: 12px; color: #98a0b8; }
  .counters dd { margin: 2px 0 0; font-size: 26px; font-weight: 800; letter-spacing: -0.03em; color: #e7ebf5; font-variant-numeric: tabular-nums; }
  .counters small { margin-left: 2px; font-size: 13px; font-weight: 600; color: #98a0b8; }
  .scroll-cue { position: absolute; left: 50%; bottom: 14px; z-index: 5; display: flex; flex-direction: column; align-items: center; gap: 6px; translate: -50% 0; font-size: 9px; letter-spacing: 0.3em; color: #98a0b8; }
  .scroll-cue i { width: 2px; height: 14px; border-radius: 2px; background: #8fd4c1; }
  @media (max-width: 899px) { .scroll-cue { display: none; } }

  @media (max-width: 899px) {
    .hero > .hero-art { grid-area: 1 / 1; width: 100%; }
    .hero > .hero-text { grid-area: 2 / 1; }
    .hero-art::after { background: linear-gradient(0deg, #111522 0%, transparent 35%); }
    .hero-text { padding: 0 16px 28px; margin-top: -18px; }
  }

  /* ── 게임 프로젝트 줄 ── */
  .games { padding: 32px 16px 4px; }
  @media (min-width: 1024px) { .games { padding: 36px 40px 4px; } }
  .games-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .games-head .pixel-font { font-size: 11px; letter-spacing: 0.16em; }
  .game-row { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); perspective: 1000px; }
  .game {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    overflow: hidden;
    transform-style: preserve-3d;
    transition: border-color 250ms, box-shadow 300ms var(--ease-out), translate 300ms var(--ease-out);
  }
  .game:hover { translate: 0 -5px; border-color: var(--brand); box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.7), 0 0 30px -8px var(--glow); }
  .game::after { content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none; background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 255 255 / 0.14), transparent 55%); opacity: var(--glare, 0); transition: opacity 250ms; }
  .g-art { position: relative; display: block; }
  .g-scan { position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.14) 0 2px, transparent 2px 4px); opacity: 0.6; transition: opacity 250ms; }
  .game:hover .g-scan { opacity: 0.15; }
  .game:hover :global(img) { transform: scale(1.05); }
  .g-no { position: absolute; left: 10px; top: 10px; z-index: 2; padding: 4px 8px; border-radius: 4px; background: rgb(10 12 22 / 0.8); color: var(--mint); font-size: 10px; letter-spacing: 0.16em; }
  .g-body { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 16px; }
  .g-title { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; }
  .g-tag { font-size: 13px; color: var(--muted-foreground); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .g-meta { margin-top: 4px; font-size: 10px; letter-spacing: 0.14em; color: var(--brand); }
  .g-press { position: absolute; right: 12px; top: 10px; z-index: 2; padding: 4px 8px; border-radius: 4px; background: rgb(10 12 22 / 0.8); color: #f2cf7a; font-size: 10px; letter-spacing: 0.16em; opacity: 0; }
  .game:hover .g-press { opacity: 1; animation: blink 0.9s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }

  /* ── Feed ── */
  .feed { padding: 24px 16px 56px; }
  @media (min-width: 1024px) { .feed { padding: 28px 40px 64px; } }
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; }
  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .chips::-webkit-scrollbar { display: none; }
  /* PR #1: 좁은 화면에서 검색·정렬이 넘치지 않게 줄바꿈 */
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; max-width: 100%; }
  .search-box { display: flex; align-items: center; gap: 10px; width: 280px; height: 42px; padding: 0 8px 0 14px; border: 1px solid var(--input); border-radius: var(--radius-lg); background: var(--card); color: var(--muted-foreground); font: 400 14px/1 var(--font-sans); cursor: text; transition: border-color var(--dur), box-shadow var(--dur); }
  .search-box:hover { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .ph { flex: 1; text-align: left; }
  .sort { position: relative; display: inline-flex; align-items: center; }
  .sort select { appearance: none; height: 42px; padding: 0 30px 0 12px; border: 1px solid var(--input); border-radius: var(--radius-lg); background: var(--card); color: var(--foreground); font: 600 14px var(--font-sans); cursor: pointer; }
  .sort select option { background: var(--popover); color: var(--popover-foreground); }
  .sort :global(.icon) { position: absolute; right: 10px; pointer-events: none; }
  @media (max-width: 599px) {
    .tools { width: 100%; }
    .search-box { flex: 1; width: auto; }
    .search-box .kbd { display: none; }
  }

  .empty { margin: 32px 0; text-align: center; color: var(--muted-foreground); }
  .more { display: flex; justify-content: center; margin-top: 36px; }

  /* ── Activity ── */
  .activity { padding: 8px 16px 40px; }
  @media (min-width: 1024px) { .activity { padding: 8px 40px 48px; } }
  .sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .kpis { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 12px; }
</style>
