---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { Image } from 'astro:assets';
import lunarLab from '../assets/modern-studio.png';
import KpiCard from '../components/charts/KpiCard.astro';
import Heatmap from '../components/charts/Heatmap.astro';
import { getPosts, url } from '../lib/posts';
import { monthly, heatmap, totals } from '../lib/stats';

const PAGE = 12;
const posts = await getPosts();
// 기본 정렬(최신순)에서는 고정 글이 맨 앞
const ordered = [...posts.filter((p) => p.data.pinned), ...posts.filter((p) => !p.data.pinned)];
const categories = [...new Set(posts.map((p) => p.data.category))];
const t = totals(posts);
const months = monthly(posts, 8);
const pct = Math.round((t.xp / t.next) * 100);
---
<BaseLayout active="home">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">GAME DEV / BUILD LOG</p>
      <h1 class="title">플레이 뒤에 숨은<br /><span class="log">코드</span>를 기록하다.</h1>
      <p class="intro">게임을 만드는 과정, 실험과 발견의 기록.</p>
      <div class="status" data-reveal>
        <span class="lv">Lv. {t.level}</span>
        <span class="xp" data-xp data-pct={pct} role="progressbar" aria-valuemin="0" aria-valuemax={t.next} aria-valuenow={t.xp} aria-label="경험치">
          <span class="xp-fill" data-xp-fill style={`width:${pct}%`}></span>
        </span>
        <span class="xp-text"><span data-xp-num data-value={t.xp}>{(t.xp).toLocaleString('ko-KR')}</span> / {t.next.toLocaleString('ko-KR')} XP</span>
        <span class="vsep" aria-hidden="true"></span>
        <span class="streak"><span class="flame" aria-hidden="true">🔥</span>{t.streak}일 연속 기록</span>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <Image src={lunarLab} alt="" widths={[720, 1080, 1776]} sizes="(min-width: 1024px) 75vw, 100vw" loading="eager" fetchpriority="high" format="webp" />
      <div class="studio-light"></div>
    </div>
  </section>

  <details class="activity">
    <summary><span class="activity-label"><span class="msr" aria-hidden="true">insights</span>나의 개발 기록</span><span class="activity-summary">{t.posts}개의 기록 · Lv. {t.level}<span class="msr" aria-hidden="true">expand_more</span></span></summary>
    <div class="sec-head">
      <h2 class="section-title" id="activity-title"><span class="msr">insights</span>활동</h2>
      <a class="btn btn-ghost btn-sm" href={url('stats/')}>통계 자세히<span class="msr">arrow_forward</span></a>
    </div>
    <div class="kpis">
      <KpiCard label="전체 기록" value={t.posts} unit="개" icon="article" hint="최근 8개월" spark={months.map((m) => m.count)} color="var(--chart-1)" />
      <KpiCard label="총 읽기 시간" value={t.minutes} unit="분" icon="schedule" hint={`글당 평균 ${t.avgMinutes}분`} spark={months.map((m) => m.minutes)} color="var(--chart-2)" />
      <KpiCard label="누적 경험치" value={t.total} unit="XP" icon="bolt" hint={`Lv. ${t.level} · 다음 레벨까지 ${t.next - t.xp} XP`} color="var(--chart-3)" />
      <KpiCard label="연속 기록" value={t.streak} unit="일" icon="local_fire_department" hint={`태그 ${t.tags}개 · 분류 ${t.categories}개`} color="var(--chart-5)" />
    </div>
    <div class="card chart-card heat">
      <header>
        <div><h3>기록 잔디</h3><p>하루에 남긴 기록 수</p></div>
      </header>
      <Heatmap cols={heatmap(posts, 26)} />
    </div>
  </details>

  <section class="feed" aria-labelledby="feed-title">
    <div class="toolbar">
      <h2 id="feed-title" class="feed-title">모든 기록 <span class="count" data-count={posts.length}>{posts.length}</span></h2>
      <span class="vsep wide-only" aria-hidden="true"></span>
      <div class="tabs-line" role="tablist" aria-label="분류" data-tabs>
        <button class="tab" type="button" role="tab" aria-selected="true" data-filter="">전체</button>
        {categories.map((c) => <button class="tab" type="button" role="tab" aria-selected="false" data-filter={c}>{c}</button>)}
        <span class="tab-indicator" data-indicator></span>
      </div>
      <div class="tools">
        <button class="search-box" type="button" data-open-search aria-label="기록 검색">
          <span class="msr">search</span><span class="ph">기록 검색…</span><kbd class="kbd">Ctrl K</kbd>
        </button>
        <span class="vsep wide-only" aria-hidden="true"></span>
        <label class="sort">
          <span class="sr-only">정렬</span>
          <select data-sort>
            <option value="new">최신순</option>
            <option value="old">오래된순</option>
            <option value="short">짧은 글부터</option>
            <option value="long">긴 글부터</option>
          </select>
          <span class="msr" aria-hidden="true">expand_more</span>
        </label>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="empty">아직 기록이 없어요.</p>
    ) : (
      <div class="grid" data-grid>
        {ordered.map((post, i) => <VideoCard post={post} eager={i < 3} hidden={i >= PAGE} />)}
      </div>
    )}
    <p class="empty" data-empty hidden>이 분류의 기록은 아직 없어요.</p>
    <div class="more">
      <button class="btn btn-outline" type="button" data-more hidden={ordered.length <= PAGE}><span class="msr">expand_more</span>더 보기</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { xpBar, cardsIn, moveIndicator } from '../scripts/fx';
  import { wireBookmarks } from '../scripts/bookmarks';

  xpBar(document.querySelector('[data-xp]'));
  wireBookmarks();

  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const indicator = document.querySelector<HTMLElement>('[data-indicator]');
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const PAGE = 12;
  let filter = '';
  let limit = PAGE;

  // 서버가 내려준 순서(고정 글 → 최신순)를 기억해 두어야 다른 정렬 뒤에 되돌릴 수 있다
  const original = new Map(cards.map((c, i) => [c, i]));
  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => original.get(a)! - original.get(b)!,
    old: (a, b) => Number(a.dataset.date) - Number(b.dataset.date),
    short: (a, b) => Number(a.dataset.minutes) - Number(b.dataset.minutes),
    long: (a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes),
  };

  function apply(animateAll: boolean) {
    const before = new Set(cards.filter((c) => !c.hidden));
    const sorted = [...cards].sort(sorters[sortSel?.value ?? 'new']);
    sorted.forEach((c) => grid?.append(c));
    const matched = sorted.filter((c) => !filter || c.dataset.category === filter);
    cards.forEach((c) => (c.hidden = true));
    const shown = matched.slice(0, limit);
    shown.forEach((c) => (c.hidden = false));
    if (more) more.hidden = matched.length <= limit;
    if (empty) empty.hidden = matched.length > 0;
    cardsIn(animateAll ? shown : shown.filter((c) => !before.has(c)));
  }

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      filter = tab.dataset.filter ?? '';
      limit = PAGE;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      moveIndicator(indicator, tab);
      apply(true);
    }),
  );
  sortSel?.addEventListener('change', () => { limit = PAGE; apply(true); });
  more?.addEventListener('click', () => { limit += PAGE; apply(false); });

  const selectedTab = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? null;
  moveIndicator(indicator, tabs[0], true);
  addEventListener('resize', () => moveIndicator(indicator, selectedTab(), true));
  document.fonts?.ready.then(() => moveIndicator(indicator, selectedTab(), true));
  if (grid) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      cardsIn(cards.filter((c) => !c.hidden));
    }, { rootMargin: '0px 0px -5% 0px' });
    io.observe(grid);
  }

  // 글 페이지의 분류 링크에서 ?category= 로 넘어온다
  const initial = new URLSearchParams(location.search).get('category');
  tabs.find((t) => initial && t.dataset.filter === initial)?.click();
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 340px;
    padding: 48px 36px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--border);
    background: #111522;
    color: #e7ebf5;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, #111522 2%, #111522f2 25%, #11152299 49%, transparent 75%);
  }

  .hero-text { position: relative; z-index: 2; min-width: 0; width: min(62%, 640px); animation: settle 850ms var(--ease-out) both; }
  .eyebrow { margin: 0 0 22px; color: #c9bff1; font: 500 10px/1.5 var(--font-mono); letter-spacing: .26em; }
  .title {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 52px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.045em;
  }
  .title .log { color: #a99be8; }
  .intro { margin: 18px 0 24px; color: #bec5d8; font-size: 14px; }

  .status { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; font-size: 11px; }
  .lv { font-weight: 800; }
  .xp { position: relative; width: 80px; height: 4px; border-radius: 99px; background: #ffffff20; overflow: hidden; }
  .xp-fill { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: linear-gradient(90deg, var(--chart-2), var(--chart-1)); box-shadow: 0 0 10px var(--glow); }
  .xp-text { color: #bec5d8; font-variant-numeric: tabular-nums; }
  .vsep { width: 1px; height: 18px; background: var(--border); }
  .streak { display: inline-flex; align-items: center; gap: 6px; color: #8fd4c1; font-weight: 500; }
  .flame { display: inline-block; animation: flicker 1.6s ease-in-out infinite; transform-origin: 50% 90%; }
  @keyframes flicker { 30% { scale: 1.12 0.94; rotate: -4deg; } 60% { scale: 0.95 1.08; rotate: 3deg; } }

  .hero-art { position: absolute; inset: 0; z-index: 0; }
  .hero-art :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: right 54%; animation: arrive 1.2s ease-out both; }
  .studio-light { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 73% 55%, #8fd4c110, transparent 30%); animation: monitor-glow 8s ease-in-out infinite; }
  @keyframes monitor-glow { 0%, 100% { opacity: .3; } 50% { opacity: .8; } }
  @keyframes settle { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes arrive { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 699px) {
    .hero { padding: 180px 20px 28px; min-height: 410px; align-items: flex-end; }
    .hero-text { width: 100%; }
    .hero::before { background: linear-gradient(0deg, #111522 3%, #111522e8 48%, #11152220 100%); }
    .hero-art :global(img) { object-position: 88% top; }
    .eyebrow { margin-bottom: 12px; }
    .intro { margin: 12px 0 18px; }
  }

  /* ── Activity ── */
  .activity { margin: 0 32px; border-bottom: 1px solid var(--border); }
  .activity summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 0; cursor: pointer; list-style: none; color: var(--muted-foreground); font-size: 12px; }
  .activity summary::-webkit-details-marker { display: none; }
  .activity-label, .activity-summary { display: inline-flex; align-items: center; gap: 8px; }
  .activity summary .msr { font-size: 16px; color: var(--brand); }
  .activity[open] summary { margin-bottom: 12px; }
  .activity[open] .activity-summary .msr { rotate: 180deg; }
  .activity[open] { padding-bottom: 20px; }
  .sec-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .sec-head .btn .msr { font-size: 16px; }
  .kpis { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 12px; }

  /* ── Feed ── */
  .feed { padding: 20px 32px 56px; }
  @media (max-width: 699px) { .feed { padding: 18px 16px 36px; } .activity { margin-inline: 16px; } }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 24px; border-bottom: 1px solid var(--border); }
  .feed-title { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 19px; font-weight: 700; height: 44px; }
  .count { display: inline-grid; place-items: center; min-width: 32px; height: 26px; padding: 0 8px; border-radius: var(--radius-sm); background: var(--secondary); color: var(--secondary-foreground); font-size: 14px; font-variant-numeric: tabular-nums; }
  .tabs-line { flex: 1; min-width: 0; margin-bottom: -1px; gap: 8px; padding-block: 5px; }
  .tabs-line .tab { height: 34px; border: 1px solid var(--input); border-radius: 999px; padding-inline: 16px; font-size: 12px; }
  .tabs-line .tab[aria-selected='true'] { color: var(--primary-foreground); background: var(--primary); border-color: var(--primary); }
  .tab-indicator { display: none; }
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; max-width: 100%; padding-bottom: 6px; }

  .search-box { display: flex; align-items: center; gap: 10px; width: 250px; height: 40px; padding: 0 8px 0 12px; border: 1px solid var(--input); border-radius: var(--radius-md); background: var(--card); color: var(--muted-foreground); font: 400 14px/1 var(--font-sans); cursor: text; transition: border-color var(--dur); }
  .search-box:hover { border-color: var(--brand); }
  .search-box .msr { font-size: 19px; }
  .ph { flex: 1; text-align: left; }

  .sort { position: relative; display: inline-flex; align-items: center; }
  .sort select { appearance: none; height: 40px; padding: 0 30px 0 10px; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--foreground); font: 700 14px var(--font-sans); cursor: pointer; }
  .sort select:hover { background: var(--accent); }
  .sort select option { background: var(--popover); color: var(--popover-foreground); }
  .sort .msr { position: absolute; right: 6px; pointer-events: none; font-size: 20px; }

  @media (max-width: 1199px) {
    .toolbar { border-bottom: 0; }
    .tabs-line { order: 3; flex-basis: 100%; border-bottom: 1px solid var(--border); }
    .tools { margin-left: auto; padding-bottom: 0; }
    .wide-only { display: none; }
  }
  @media (max-width: 599px) {
    .search-box { width: 40px; padding: 0; justify-content: center; }
    .search-box .ph, .search-box .kbd { display: none; }
  }

  .grid { display: grid; gap: 28px 22px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1280px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .grid { grid-template-columns: 1fr; } }
  .empty { margin: 32px 0; text-align: center; color: var(--muted-foreground); }
  .more { display: flex; justify-content: center; margin-top: 36px; }
</style>
