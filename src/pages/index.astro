---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import GalleryCard from '../components/GalleryCard.astro';
import HeroScene from '../components/HeroScene.astro';
import { getPosts, url } from '../lib/posts';
import { getGames } from '../lib/games';
import { totals } from '../lib/stats';
import { SITE } from '../site.config';

const PAGE = 12;
// 첫 줄은 크게 보여서(styles/global.css .has-feature) 더 큰 이미지를 받는다
const FEATURE_SIZES = '(min-width: 900px) 640px, 100vw';
const posts = await getPosts();
const games = await getGames();
// 기본 정렬(최신순)에서는 고정 글이 맨 앞
const ordered = [...posts.filter((p) => p.data.pinned), ...posts.filter((p) => !p.data.pinned)];
const categories = [...new Set(posts.map((p) => p.data.category))];
const t = totals(posts);
const SEGMENTS = 10;
const filled = Math.round((t.xp / t.next) * SEGMENTS);

// 타이틀 화면 메뉴: 게임의 시작 메뉴처럼 고르고 Enter 로 들어간다
const MENU = [
  { label: '기록 보기', href: '#feed', meta: `${posts.length} LOGS` },
  { label: '게임 프로젝트', href: url('projects/'), meta: `${games.length} STAGES` },
  { label: '통계', href: url('stats/'), meta: `LV ${t.level}` },
  { label: '소개', href: url('about/'), meta: 'PROFILE' },
];
---
<BaseLayout active="home">
  <section class="title-screen" data-hero>
    <div class="stage" data-stage><HeroScene /></div>
    <div class="wrap ts-row">
      <div class="ts-text">
        <h1 class="headline" data-title>{SITE.title}</h1>
        <p class="sub" data-hero-in>{SITE.description.replace('. ', '.\n')}</p>
        <div class="hud pixel-font" data-hero-in>
          <span class="lv">LV {t.level}</span>
          <span class="seg" data-segs role="progressbar" aria-label="경험치" aria-valuemin="0" aria-valuemax={t.next} aria-valuenow={t.xp}>
            {Array.from({ length: SEGMENTS }, (_, i) => <i class:list={{ on: i < filled }}></i>)}
          </span>
          <span class="xp">{t.xp}/{t.next} XP</span>
          <span class="streak"><Icon name="flame" size={14} fill />{t.streak} DAY</span>
        </div>
      </div>
      <nav class="ts-menu" aria-label="시작 메뉴" data-ts-menu>
        <span class="ts-cursor" aria-hidden="true" data-ts-cursor>▶</span>
        <ul>
          {MENU.map((m) => (
            <li><a class="ts-item" href={m.href} data-ts-item><span class="ts-label">{m.label}</span><span class="ts-meta pixel-font">{m.meta}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section class="feed wrap" id="feed" aria-labelledby="feed-title">
    <div class="feed-head">
      <h2 class="feed-title" id="feed-title">기록 <span class="count">{posts.length}</span></h2>
      <div class="toolbar">
        <div class="chips" role="toolbar" aria-label="분류">
          <button class="chip" type="button" aria-pressed="true" data-filter="">전체</button>
          {categories.map((c) => <button class="chip" type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
        </div>
        <label class="sort">
          <span class="sr-only">정렬</span>
          <select data-sort>
            <option value="new">최신순</option>
            <option value="old">오래된순</option>
            <option value="short">짧은 글부터</option>
            <option value="long">긴 글부터</option>
          </select>
          <Icon name="chevron-down" size={16} />
        </label>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="empty">아직 기록이 없어요.</p>
    ) : (
      <div class="gallery has-feature" data-grid data-feature-sizes={FEATURE_SIZES}>
        {ordered.map((post, i) => <GalleryCard post={post} eager={i < 2} hidden={i >= PAGE} sizes={i === 0 ? FEATURE_SIZES : undefined} />)}
      </div>
    )}
    <p class="empty" data-empty hidden>이 분류의 기록은 아직 없어요.</p>
    <div class="more">
      <button class="btn btn-outline" type="button" data-more hidden={ordered.length <= PAGE}><Icon name="chevron-down" />더 보기</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { animate, createTimeline, splitText, stagger, steps } from 'animejs';
  import { reduced, cardsIn } from '../scripts/fx';
  import { wireBookmarks } from '../scripts/bookmarks';
  import { markReadCards } from '../scripts/read';

  wireBookmarks();
  markReadCards();

  // ── 타이틀 화면 메뉴: ▶ 커서 하나가 포인터 · 포커스 · 방향키를 따라 항목 사이를 옮겨 다닌다(누른 것이 원인인 움직임)
  const menu = document.querySelector<HTMLElement>('[data-ts-menu]');
  const cursor = menu?.querySelector<HTMLElement>('[data-ts-cursor]');
  const items = [...(menu?.querySelectorAll<HTMLAnchorElement>('[data-ts-item]') ?? [])];
  let sel = 0;
  const select = (i: number, instant = false) => {
    sel = (i + items.length) % items.length;
    items.forEach((it, k) => it.classList.toggle('on', k === sel));
    const y = items[sel].offsetTop + items[sel].offsetHeight / 2;
    if (!cursor) return;
    if (instant || reduced()) cursor.style.transform = `translateY(${y}px)`;
    else animate(cursor, { translateY: y, duration: 320, ease: 'outExpo' });
  };
  if (items.length) {
    select(0, true);
    items.forEach((it, k) => {
      it.addEventListener('pointerenter', () => select(k));
      it.addEventListener('focus', () => select(k));
    });
    menu?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      select(sel + (e.key === 'ArrowDown' ? 1 : -1));
      items[sel].focus();
    });
    addEventListener('resize', () => select(sel, true));
    document.fonts?.ready.then(() => select(sel, true));
  }

  // ── 첫 화면 등장(한 번만): 장면이 초점을 잡고 → 이름이 글자마다 또렷해지고 → 소개 → 메뉴가 왼쪽으로 흘러 들어오고 → 커서가 마지막에 앉는다.
  // 다음 요소는 앞 요소가 30~50% 진행됐을 때 시작한다(video-motion-craft). 도착한 뒤에는 아무것도 계속 움직이지 않는다.
  const title = document.querySelector<HTMLElement>('[data-title]');
  if (title && !reduced()) {
    const { chars } = splitText(title, { chars: { class: 'char' } });
    title.style.opacity = '1';
    const segs = document.querySelectorAll<HTMLElement>('[data-segs] i.on');
    createTimeline()
      .add('[data-stage]', { opacity: [0, 1], filter: ['blur(10px)', 'blur(0px)'], duration: 900, ease: 'outExpo' }, 0)
      .add(chars, { opacity: [0.2, 1], filter: ['blur(6px)', 'blur(0px)'], duration: 420, delay: stagger(70), ease: 'outExpo' }, 250)
      .add('[data-hero-in]', { opacity: [0, 1], filter: ['blur(8px)', 'blur(0px)'], duration: 520, delay: stagger(120), ease: 'outExpo' }, 520)
      .add(items, { opacity: [0, 1], translateX: [28, 0], duration: 560, delay: stagger(60), ease: 'outExpo' }, 640)
      .add(cursor ?? [], { opacity: [0, 1], translateX: [-10, 0], duration: 360, ease: 'outExpo' }, 1000)
      .add(segs, { opacity: [0, 1], scaleY: [0.3, 1], duration: 120, delay: stagger(70), ease: steps(2) }, 900);
  }

  // ── 기록 목록: 분류 · 정렬 · 더 보기
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const PAGE = 12;
  let filter = '';
  let limit = PAGE;

  // 서버가 내려준 순서(고정 글 → 최신순)를 기억해 두어야 다른 정렬 뒤에 되돌릴 수 있다
  const original = new Map(cards.map((c, i) => [c, i]));
  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    new: (a, b) => original.get(a)! - original.get(b)!,
    old: (a, b) => Number(a.dataset.date) - Number(b.dataset.date),
    short: (a, b) => Number(a.dataset.minutes) - Number(b.dataset.minutes),
    long: (a, b) => Number(b.dataset.minutes) - Number(a.dataset.minutes),
  };

  function apply(animateAll: boolean) {
    const before = new Set(cards.filter((c) => !c.hidden));
    const sorted = [...cards].sort(sorters[sortSel?.value ?? 'new']);
    const matched = sorted.filter((c) => !filter || c.dataset.category === filter);
    const shown = matched.slice(0, limit);
    // 보이는 카드를 앞에 둔다: 목록의 첫 줄(크게 보이는 줄)이 숨은 카드가 되지 않게
    [...shown, ...sorted.filter((c) => !shown.includes(c))].forEach((c) => {
      c.hidden = !shown.includes(c);
      grid?.append(c);
    });
    // 분류·정렬이 바뀌어 다른 카드가 첫 줄에 오면 그 카드도 큰 이미지로 바꿔 받는다
    shown[0]?.querySelector('img')?.setAttribute('sizes', grid?.dataset.featureSizes ?? '');
    if (more) more.hidden = matched.length <= limit;
    if (empty) empty.hidden = matched.length > 0;
    cardsIn(animateAll ? shown : shown.filter((c) => !before.has(c)));
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? '';
      limit = PAGE;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply(true);
    }),
  );
  sortSel?.addEventListener('change', () => { limit = PAGE; apply(true); });
  more?.addEventListener('click', () => { limit += PAGE; apply(false); });

  // 글 페이지의 분류 링크에서 ?category= 로 넘어온다
  const initial = new URLSearchParams(location.search).get('category');
  chips.find((c) => initial && c.dataset.filter === initial)?.click();
</script>

<style>
  /* ── 타이틀 화면: 테마와 상관없이 늘 밤. 위는 장면, 아래는 이름과 시작 메뉴 ── */
  .title-screen { background: var(--night); color: var(--night-text); overflow: hidden; }
  /* 장면은 원래 비율(1200:520)을 지키고, 첫 화면 안에 메뉴까지 들어오도록 화면 높이에 맞춰 폭을 줄인다 */
  .stage {
    width: min(100%, 1440px, calc((100svh - var(--header-h) - 300px) * 1200 / 520));
    min-width: min(100%, 720px);
    margin: 0 auto;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  :global(.js-fx) .stage { opacity: 0; }

  .ts-row { display: grid; gap: 28px; padding-top: 8px; padding-bottom: 44px; }
  @media (min-width: 900px) { .ts-row { grid-template-columns: minmax(0, 1fr) 340px; align-items: end; gap: 48px; padding-top: 16px; padding-bottom: 56px; } }

  .headline { margin: 0 0 22px; font-size: clamp(56px, 7.6vw, 104px); font-weight: 700; line-height: 1; letter-spacing: -0.03em; }
  :global(.js-fx) .headline { opacity: 0; }
  .sub { max-width: 30em; margin: 0 0 22px; white-space: pre-line; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.6; color: var(--night-text); }
  :global(.js-fx) [data-hero-in] { opacity: 0; }

  .hud { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: 13px; letter-spacing: 0.02em; }
  .lv { color: var(--night-mint); }
  .seg { display: inline-flex; gap: 3px; padding: 2px; border: 1px solid var(--night-line); }
  .seg i { width: 9px; height: 12px; background: var(--night-surface); }
  .seg i.on { background: var(--night-lamp); }
  .xp { color: var(--night-muted); }
  .streak { display: inline-flex; align-items: center; gap: 4px; color: var(--night-lamp); }

  /* 시작 메뉴: 줄마다 이름과 개수. ▶ 커서는 하나뿐이고 고른 줄로 옮겨 다닌다 */
  .ts-menu { position: relative; padding-left: 26px; }
  .ts-menu ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--night-line); }
  .ts-item { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; min-height: 52px; padding: 14px 0; border-bottom: 1px solid var(--night-line); color: var(--night-muted); transition: color var(--dur); }
  .ts-item.on, .ts-item:focus-visible { color: var(--night-text); }
  .ts-item:focus-visible { outline: none; }
  .ts-label { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
  .ts-meta { font-size: 12px; letter-spacing: 0.04em; color: var(--night-muted); }
  .ts-item.on .ts-meta { color: var(--night-lamp); }
  .ts-cursor { position: absolute; left: 0; top: 0; margin-top: -0.6em; font-size: 14px; line-height: 1.2; color: var(--night-lamp); pointer-events: none; }
  :global(.js-fx) .ts-cursor, :global(.js-fx) .ts-item { opacity: 0; }

  @media (max-width: 899px) {
    .stage { -webkit-mask-image: none; mask-image: none; }
  }
  /* 폰에서는 장면을 키워 가운데(모니터 · JINY · 게임 화면)만 보이게 자른다 */
  @media (max-width: 599px) {
    .stage { width: 165%; min-width: 0; margin-left: -52%; }
    .ts-label { font-size: 18px; }
  }

  /* ── 기록 목록 ── */
  .feed { padding-top: 56px; padding-bottom: 72px; }
  @media (min-width: 1024px) { .feed { padding-top: 80px; padding-bottom: 96px; } }
  .feed-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 24px; margin-bottom: 8px; }
  .feed-title { margin: 0; font-size: clamp(30px, 3.4vw, 44px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .count { font-size: 0.5em; font-weight: 400; color: var(--muted-foreground); vertical-align: 0.5em; }
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding-bottom: 14px; }
  .chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .chips::-webkit-scrollbar { display: none; }
  .sort { position: relative; display: inline-flex; align-items: center; }
  .sort select { appearance: none; height: 40px; padding: 0 32px 0 12px; border: 1px solid var(--input); border-radius: var(--radius-md); background: var(--background); color: var(--foreground); font: 400 14px var(--font-sans); cursor: pointer; }
  .sort select option { background: var(--popover); color: var(--popover-foreground); }
  .sort :global(.icon) { position: absolute; right: 10px; pointer-events: none; color: var(--muted-foreground); }

  .empty { margin: 32px 0; text-align: center; color: var(--muted-foreground); }
  .more { display: flex; justify-content: center; margin-top: 36px; }
</style>
