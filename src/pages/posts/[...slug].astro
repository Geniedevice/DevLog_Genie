---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import Thumbnail from '../../components/Thumbnail.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postUrl, tagUrl, url, formatDate, readingMinutes, relatedTo, type Post } from '../../lib/posts';
import { categoryStyle } from '../../lib/categories';
import { SITE } from '../../site.config';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // 목록이 최신순이라 배열상 뒤쪽이 "이전 글"
      newer: posts[i - 1],
      older: posts[i + 1],
      series: post.data.series ? posts.filter((p) => p.data.series === post.data.series).reverse() : [],
      related: relatedTo(post, posts),
    },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post; series: Post[]; related: Post[] }
const { post, newer, older, series, related } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, category, tags, cover } = post.data;
const style = categoryStyle(category);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const og = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---
<BaseLayout title={title} description={description} type="article" image={og}>
  <div class="progress" aria-hidden="true"><div class="bar" data-progress></div></div>

  <article class="post">
    <header class="post-header">
      <a class="chip state cat" href={url(`?category=${encodeURIComponent(category)}#posts`)}><span class="msr">{style.icon}</span>{category}</a>
      <h1 class="title">{title}</h1>
      <p class="body-l desc">{description}</p>
      <div class="byline">
        <svg class="avatar" viewBox="0 0 48 48" aria-hidden="true"><use href="#logo-shape" /></svg>
        <div>
          <p class="title-s">{SITE.author}</p>
          <p class="body-s meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            {updated && <span> · {formatDate(updated)} 수정</span>}
            <span> · {readingMinutes(post.body)}분 분량</span>
          </p>
        </div>
      </div>
    </header>

    <div class="cover">
      <Thumbnail post={post} eager sizes="(min-width: 1136px) 1072px, 100vw" />
    </div>

    <div class="layout">
      <div class="main-col">
        {series.length > 1 && (
          <nav class="series" aria-label="시리즈">
            <p class="title-s"><span class="msr">collections_bookmark</span>{post.data.series}<span class="label-m count">{series.findIndex((s) => s.id === post.id) + 1} / {series.length}</span></p>
            <ol class="body-m">
              {series.map((s) => (
                <li class:list={{ current: s.id === post.id }}>
                  {s.id === post.id ? <span>{s.data.title}</span> : <a href={postUrl(s)}>{s.data.title}</a>}
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="prose" data-prose>
          <Content />
        </div>

        {tags.length > 0 && (
          <ul class="tag-list" aria-label="태그">
            {tags.map((t) => <li><a class="chip state" href={tagUrl(t)}><span class="msr">tag</span>{t}</a></li>)}
          </ul>
        )}

        <aside class="author">
          <svg class="avatar-lg" viewBox="0 0 48 48" aria-hidden="true"><use href="#logo-shape" /></svg>
          <div class="author-text">
            <p class="title-m">{SITE.author}</p>
            <p class="body-m">Unreal Engine 게임 클라이언트 개발자. 구현을 넘어 동작 원리를 파고듭니다.</p>
            <div class="author-links">
              <a class="btn btn-tonal state" href={SITE.portfolio} target="_blank" rel="noopener"><span class="msr">work</span>포트폴리오</a>
              <a class="btn btn-text state" href={SITE.github} target="_blank" rel="noopener"><span class="msr">code</span>GitHub</a>
            </div>
          </div>
        </aside>

        {(older || newer) && (
          <nav class="adjacent" aria-label="이전·다음 글">
            {older ? (
              <a class="adj state" href={postUrl(older)}>
                <Thumbnail post={older} sizes="120px" class="mini" />
                <span class="adj-text">
                  <span class="label-m dir"><span class="msr">arrow_back</span>이전 글</span>
                  <span class="title-s">{older.data.title}</span>
                </span>
              </a>
            ) : <span />}
            {newer && (
              <a class="adj next state" href={postUrl(newer)}>
                <span class="adj-text">
                  <span class="label-m dir">다음 글<span class="msr">arrow_forward</span></span>
                  <span class="title-s">{newer.data.title}</span>
                </span>
                <Thumbnail post={newer} sizes="120px" class="mini" />
              </a>
            )}
          </nav>
        )}

        <Comments />
      </div>

      {toc.length > 0 && (
        <aside class="side">
          <Toc headings={toc} />
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 class="headline-s" id="related-title">함께 읽으면 좋은 글</h2>
        <div class="related-grid">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )}
  </article>

  <dialog class="lightbox" data-lightbox aria-label="이미지 크게 보기">
    <img alt="" data-lightbox-img />
    <button class="icon-btn state close" type="button" data-lightbox-close aria-label="닫기"><span class="msr">close</span></button>
  </dialog>
</BaseLayout>

<script>
  // 읽기 진행률
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;
  const onScroll = () => {
    const r = prose.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight * 0.6)));
    bar.style.transform = `scaleX(${p})`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 본문 이미지 클릭 → 크게 보기
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const big = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  prose.querySelectorAll('img').forEach((img) =>
    img.addEventListener('click', () => {
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      box.showModal();
    }),
  );
  box.addEventListener('click', () => box.close());

  // 코드 블록마다 언어 라벨과 복사 버튼
  const COPY = '<span class="msr">content_copy</span>';
  prose.querySelectorAll('pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre);

    const lang = pre.dataset.language;
    if (lang && lang !== 'plaintext') {
      const tag = document.createElement('span');
      tag.className = 'code-lang label-s';
      tag.textContent = lang;
      wrap.prepend(tag);
    }

    const btn = document.createElement('button');
    btn.className = 'copy icon-btn state';
    btn.type = 'button';
    btn.setAttribute('aria-label', '코드 복사');
    btn.innerHTML = COPY;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      btn.innerHTML = '<span class="msr">check</span>';
      setTimeout(() => (btn.innerHTML = COPY), 1500);
    });
    wrap.append(btn);
  });
</script>

<style>
  /* M3 linear progress indicator */
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 30; pointer-events: none; }
  .bar { height: 100%; background: var(--md-primary); transform: scaleX(0); transform-origin: left; border-radius: 0 2px 2px 0; }

  /* ── Header ── */
  .post-header { max-width: 800px; margin: 0 auto; padding: 32px 16px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; }
  @media (min-width: 840px) { .post-header { padding: 48px 32px 40px; } }
  .cat { background: var(--md-secondary-container); color: var(--md-on-secondary-container); border-color: transparent; margin-bottom: 20px; }
  .title { margin: 0 0 16px; font-size: clamp(30px, 4.6vw, 44px); line-height: 1.25; font-weight: 500; letter-spacing: -0.01em; text-wrap: balance; }
  .desc { margin: 0 0 28px; max-width: 640px; color: var(--md-on-surface-variant); text-wrap: pretty; }
  .byline { display: flex; align-items: center; gap: 12px; text-align: left; }
  .byline p { margin: 0; }
  .avatar { width: 40px; height: 40px; color: var(--md-primary); flex: none; }
  .meta { color: var(--md-on-surface-variant); }

  .cover { max-width: 1136px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 840px) { .cover { padding: 0 32px; } }
  .cover :global(.thumb) { border-radius: var(--md-shape-xl); box-shadow: 0 0 0 1px var(--md-outline-variant); }
  @media (max-width: 599px) { .cover :global(.thumb) { border-radius: var(--md-shape-lg); } }

  /* ── Body ── */
  .layout { display: grid; max-width: 1136px; margin: 0 auto; padding: 48px 16px 40px; gap: 56px; }
  @media (min-width: 840px) { .layout { padding: 56px 32px 48px; } }
  @media (min-width: 1200px) { .layout { grid-template-columns: minmax(0, 1fr) 220px; } }
  .main-col { min-width: 0; max-width: 720px; width: 100%; margin: 0 auto; }
  .side { display: none; }
  @media (min-width: 1200px) { .side { display: block; } }

  .series { padding: 16px 20px; margin-bottom: 40px; border-radius: var(--md-shape-lg); background: var(--md-surface-container); }
  .series p { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; }
  .series .msr { font-size: 20px; color: var(--md-primary); }
  .series .count { margin-left: auto; color: var(--md-on-surface-variant); }
  .series ol { margin: 0; padding-left: 22px; color: var(--md-on-surface-variant); }
  .series li { padding: 2px 0; }
  .series li.current { color: var(--md-on-surface); font-weight: 700; }
  .series a:hover { color: var(--md-primary); text-decoration: underline; }

  .tag-list { list-style: none; margin: 56px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }

  .author { display: flex; gap: 20px; margin-top: 40px; padding: 24px; border-radius: var(--md-shape-xl); background: var(--md-surface-container-low); }
  .avatar-lg { width: 64px; height: 64px; flex: none; color: var(--md-primary); }
  .author-text p { margin: 0 0 4px; }
  .author-text .body-m { color: var(--md-on-surface-variant); }
  .author-links { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 12px; }
  @media (max-width: 599px) { .author { flex-direction: column; gap: 12px; } }

  .adjacent { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
  .adj { display: flex; align-items: center; gap: 16px; padding: 12px; border-radius: var(--md-shape-lg); border: 1px solid var(--md-outline-variant); color: var(--md-on-surface); }
  .adj :global(.mini) { width: 104px; flex: none; border-radius: var(--md-shape-sm); }
  .adj-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .adj .title-s { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .dir { display: inline-flex; align-items: center; gap: 4px; color: var(--md-on-surface-variant); }
  .dir .msr { font-size: 16px; }
  .adj.next { grid-column: 2; justify-content: flex-end; text-align: right; }
  .adj.next .adj-text { align-items: flex-end; }
  @media (max-width: 599px) {
    .adjacent { grid-template-columns: 1fr; }
    .adj.next { grid-column: 1; }
    .adj :global(.mini) { width: 88px; }
  }

  /* ── Related ── */
  .related { max-width: 1136px; margin: 0 auto; padding: 24px 16px 64px; }
  @media (min-width: 840px) { .related { padding: 32px 32px 72px; } }
  .related h2 { margin: 0 0 24px; font-weight: 500; }
  .related-grid { display: grid; gap: 32px 24px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }

  /* ── Lightbox ── */
  .lightbox { max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; margin: 0; padding: 24px; border: 0; background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.85); }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 48px); border-radius: var(--md-shape-md); cursor: zoom-out; }
  .close { position: fixed; top: 16px; right: 16px; color: #fff; }
</style>
