---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import Thumbnail from '../../components/Thumbnail.astro';
import QuestPoster from '../../components/QuestPoster.astro';
import { getPosts, postUrl, tagUrl, url, formatDate, readingMinutes, relatedTo, type Post } from '../../lib/posts';
import { rankOf, expOf, questNo, RANK_LABEL } from '../../lib/quest';
import { categoryStyle } from '../../lib/categories';
import { SITE } from '../../site.config';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      all: posts,
      // 목록이 최신순이라 배열상 뒤쪽이 "이전 의뢰"
      newer: posts[i - 1],
      older: posts[i + 1],
      series: post.data.series ? posts.filter((p) => p.data.series === post.data.series).reverse() : [],
      related: relatedTo(post, posts),
    },
  }));
}

interface Props { post: Post; all: Post[]; newer?: Post; older?: Post; series: Post[]; related: Post[] }
const { post, all, newer, older, series, related } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, category, tags, cover, draft } = post.data;
const style = categoryStyle(category);
const rank = rankOf(post);
const no = questNo(post, all);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const og = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---
<BaseLayout title={title} description={description} type="article" image={og}>
  <div class="progress" aria-hidden="true"><div class="bar" data-progress></div></div>

  <article class="post">
    <header class="post-header">
      <nav aria-label="현재 위치">
        <ol class="breadcrumb">
          <li><a href={url()}>길드 홀</a></li>
          <li class="sep msr" aria-hidden="true">chevron_right</li>
          <li><a href={url('#board')}>토벌 게시판</a></li>
          <li class="sep msr" aria-hidden="true">chevron_right</li>
          <li aria-current="page">No.{no}</li>
        </ol>
      </nav>

      <div class="badges">
        <span class:list={['rank-badge', `rank-${rank}`]}><span class="shield">{rank}</span>{RANK_LABEL[rank]} 등급</span>
        <a class="badge badge-outline" href={url(`?category=${encodeURIComponent(category)}#board`)}><span class="msr">{style.icon}</span>{category}</a>
      </div>

      <h1 class="title" data-hero-title>{title}</h1>
      <p class="desc" data-reveal>{description}</p>

      <div class="byline" data-reveal>
        <svg class="avatar" viewBox="0 0 48 48" aria-hidden="true"><use href="#emblem" /></svg>
        <div class="who">
          <p class="name">{SITE.author}</p>
          <p class="meta">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            {updated && <> · {formatDate(updated)} 갱신</>}
            · {readingMinutes(post.body)}분 · <span class="exp">{expOf(post).toLocaleString('ko-KR')} EXP</span>
          </p>
        </div>
      </div>

      <span class:list={['stamp', { open: draft }]} data-post-stamp aria-hidden="true">{draft ? '모집 중' : '토벌 완료'}</span>
    </header>

    <div class="cover" data-reveal>
      <div class="gold-frame">
        <Thumbnail post={post} eager sizes="(min-width: 1180px) 1080px, 100vw" />
      </div>
    </div>

    <div class="layout">
      <div class="main-col">
        {series.length > 1 && (
          <nav class="series card" aria-label="연작 의뢰">
            <p class="series-title"><span class="msr">collections_bookmark</span>{post.data.series}<span class="count">{series.findIndex((s) => s.id === post.id) + 1} / {series.length}</span></p>
            <ol>
              {series.map((s) => (
                <li class:list={{ current: s.id === post.id }}>
                  {s.id === post.id ? <span>{s.data.title}</span> : <a href={postUrl(s)}>{s.data.title}</a>}
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="scroll">
          <div class="prose" data-prose>
            <Content />
          </div>
        </div>

        {tags.length > 0 && (
          <div class="tag-row" data-reveal>
            <span class="tag-label"><span class="msr">diamond</span>각인</span>
            <ul class="tag-list">
              {tags.map((t) => <li><a class="badge badge-outline" href={tagUrl(t)}>#{t}</a></li>)}
            </ul>
          </div>
        )}

        <aside class="member card" data-reveal>
          <svg class="member-emblem" viewBox="0 0 48 48" aria-hidden="true"><use href="#emblem" /></svg>
          <div class="member-body">
            <p class="eyebrow">Guild Member</p>
            <p class="member-name">{SITE.author}</p>
            <p class="member-desc">Unreal Engine 게임 클라이언트 개발자. 구현을 넘어 동작 원리를 파고듭니다.</p>
            <div class="member-links">
              <a class="btn btn-default btn-sm" href={SITE.portfolio} target="_blank" rel="noopener"><span class="msr">work</span>포트폴리오</a>
              <a class="btn btn-outline btn-sm" href={SITE.github} target="_blank" rel="noopener"><span class="msr">code</span>GitHub</a>
            </div>
          </div>
        </aside>

        {(older || newer) && (
          <nav class="adjacent" aria-label="이전·다음 의뢰" data-reveal-group>
            {older ? (
              <a class="adj card" href={postUrl(older)}>
                <Thumbnail post={older} sizes="120px" class="mini" />
                <span class="adj-text">
                  <span class="dir"><span class="msr">west</span>이전 의뢰</span>
                  <span class="adj-title">{older.data.title}</span>
                </span>
              </a>
            ) : <span />}
            {newer && (
              <a class="adj card next" href={postUrl(newer)}>
                <span class="adj-text">
                  <span class="dir">다음 의뢰<span class="msr">east</span></span>
                  <span class="adj-title">{newer.data.title}</span>
                </span>
                <Thumbnail post={newer} sizes="120px" class="mini" />
              </a>
            )}
          </nav>
        )}

        <Comments />
      </div>

      {toc.length > 0 && (
        <aside class="side">
          <Toc headings={toc} />
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 class="section-title" id="related-title"><span class="msr">link</span>연관 의뢰</h2>
        <div class="related-board wood" data-board>
          {related.map((p) => <QuestPoster post={p} all={all} />)}
        </div>
      </section>
    )}
  </article>

  <dialog class="lightbox" data-lightbox aria-label="이미지 크게 보기">
    <img alt="" data-lightbox-img />
    <button class="btn btn-ghost btn-icon close" type="button" aria-label="닫기"><span class="msr">close</span></button>
  </dialog>
</BaseLayout>

<script>
  import { titleIntro, stampIn, boardIntro, popIn } from '../../scripts/fx';

  titleIntro(document.querySelector('[data-hero-title]'), 100);
  stampIn(document.querySelector('[data-post-stamp]'), 900);
  boardIntro(document.querySelector('[data-board]'));

  // 읽기 진행률(HP 바처럼)
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;
  const onScroll = () => {
    const r = prose.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight * 0.6)));
    bar.style.transform = `scaleX(${p})`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 본문 이미지 클릭 → 크게 보기
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const big = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  prose.querySelectorAll('img').forEach((img) =>
    img.addEventListener('click', () => {
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      box.showModal();
      popIn(big);
    }),
  );
  box.addEventListener('click', () => box.close());

  // 코드 블록마다 언어 라벨과 복사 버튼
  const COPY = '<span class="msr">content_copy</span>';
  prose.querySelectorAll('pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre);

    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = pre.dataset.language;
    bar.innerHTML = `<span class="code-lang"><span class="msr">auto_stories</span>${lang && lang !== 'plaintext' ? lang : 'text'}</span>`;
    const btn = document.createElement('button');
    btn.className = 'copy btn btn-ghost btn-sm';
    btn.type = 'button';
    btn.setAttribute('aria-label', '코드 복사');
    btn.innerHTML = COPY;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      btn.innerHTML = '<span class="msr">check</span>';
      setTimeout(() => (btn.innerHTML = COPY), 1500);
    });
    bar.append(btn);
    wrap.prepend(bar);
  });
</script>

<style>
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 30; pointer-events: none; background: rgb(0 0 0 / 0.15); }
  .bar { height: 100%; background: linear-gradient(90deg, var(--seal), var(--gold-bright)); box-shadow: 0 0 10px var(--glow); transform: scaleX(0); transform-origin: left; }

  /* ── Header ── */
  .post-header { position: relative; max-width: 840px; margin: 0 auto; padding: 24px 16px 36px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  @media (min-width: 900px) { .post-header { padding: 32px 40px 44px; } }
  .badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 28px 0 18px; }
  .rank-badge { display: inline-flex; align-items: center; gap: 8px; height: 28px; padding: 0 12px 0 4px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--card); font: 700 12px/1 var(--font-serif); }
  .shield { display: grid; place-items: center; width: 20px; height: 22px; font: 700 12px/1 var(--font-display); color: #fff; clip-path: polygon(50% 100%, 0 72%, 0 0, 100% 0, 100% 72%); }
  .rank-S .shield { background: var(--rank-s); }
  .rank-A .shield { background: var(--rank-a); }
  .rank-B .shield { background: var(--rank-b); }
  .rank-C .shield { background: var(--rank-c); }

  .title { margin: 0 0 16px; font-size: clamp(30px, 4.8vw, 48px); line-height: 1.25; text-wrap: balance; }
  .desc { margin: 0 0 28px; max-width: 640px; font-size: 17px; color: var(--muted-foreground); text-wrap: pretty; }
  .byline { display: flex; align-items: center; gap: 12px; text-align: left; }
  .byline p { margin: 0; }
  .avatar { width: 40px; height: 40px; flex: none; }
  .name { font: 700 15px/1.3 var(--font-serif); }
  .meta { font-size: 13px; color: var(--muted-foreground); }
  .exp { color: var(--gold); font-weight: 700; }

  .stamp {
    position: absolute;
    right: 8%;
    bottom: 18px;
    padding: 6px 14px;
    border: 4px double var(--seal);
    border-radius: 8px;
    color: var(--seal);
    font: 700 22px/1 var(--font-serif);
    letter-spacing: 0.12em;
    rotate: -12deg;
    opacity: 0.75;
    pointer-events: none;
  }
  .stamp.open { color: #4a7fd0; border-color: #4a7fd0; }
  @media (max-width: 699px) { .stamp { display: none; } }

  .cover { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 900px) { .cover { padding: 0 40px; } }

  /* ── Body ── */
  .layout { display: grid; max-width: 1180px; margin: 0 auto; padding: 44px 16px 40px; gap: 48px; }
  @media (min-width: 900px) { .layout { padding: 56px 40px 48px; } }
  @media (min-width: 1240px) { .layout { grid-template-columns: minmax(0, 1fr) 230px; } }
  .main-col { min-width: 0; max-width: 780px; width: 100%; margin: 0 auto; }
  .side { display: none; }
  @media (min-width: 1240px) { .side { display: block; } }

  /* 두루마리: 본문 판 */
  .scroll {
    position: relative;
    padding: clamp(24px, 4vw, 48px) clamp(18px, 4vw, 52px);
    border-radius: var(--radius-lg);
    background: var(--scroll-bg);
    color: var(--scroll-fg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md), inset 0 0 60px rgb(120 80 30 / 0.08);
  }
  .scroll::before,
  .scroll::after {
    content: '';
    position: absolute;
    left: -6px;
    right: -6px;
    height: 12px;
    border-radius: 6px;
    background: linear-gradient(180deg, var(--wood-light), var(--wood-dark));
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.4);
  }
  .scroll::before { top: -6px; }
  .scroll::after { bottom: -6px; }

  .series { padding: 16px 20px; margin-bottom: 32px; }
  .series-title { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; font: 700 15px/1.3 var(--font-serif); }
  .series-title .msr { color: var(--gold); }
  .count { margin-left: auto; font: 500 12px var(--font-mono); color: var(--muted-foreground); }
  .series ol { margin: 0; padding-left: 22px; color: var(--muted-foreground); font-size: 14px; }
  .series li { padding: 2px 0; }
  .series li.current { color: var(--foreground); font-weight: 700; }
  .series a:hover { color: var(--gold); }

  .tag-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 40px; }
  .tag-label { display: inline-flex; align-items: center; gap: 4px; font: 700 13px var(--font-serif); color: var(--muted-foreground); }
  .tag-label .msr { font-size: 16px; color: var(--gold); }
  .tag-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }

  .member { display: flex; gap: 20px; margin-top: 32px; padding: 22px; background: linear-gradient(135deg, color-mix(in srgb, var(--gold) 12%, var(--card)), var(--card)); border-color: color-mix(in srgb, var(--gold) 40%, var(--border)); }
  .member-emblem { width: 64px; height: 64px; flex: none; filter: drop-shadow(0 6px 14px var(--glow)); }
  .member-body p { margin: 0; }
  .member-name { margin-top: 6px !important; font: 700 18px/1.3 var(--font-serif); }
  .member-desc { margin-top: 4px !important; font-size: 14px; color: var(--muted-foreground); }
  .member-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  @media (max-width: 599px) { .member { flex-direction: column; gap: 12px; } }

  .adjacent { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
  .adj { display: flex; align-items: center; gap: 14px; padding: 12px; transition: border-color var(--dur), background var(--dur); }
  .adj:hover { border-color: var(--gold); background: var(--accent); }
  .adj :global(.mini) { width: 100px; flex: none; border-radius: var(--radius-sm); }
  .adj-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .adj-title { font: 700 14px/1.4 var(--font-serif); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .dir { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--muted-foreground); }
  .dir .msr { font-size: 16px; }
  .adj.next { grid-column: 2; justify-content: flex-end; text-align: right; }
  .adj.next .adj-text { align-items: flex-end; }
  @media (max-width: 599px) {
    .adjacent { grid-template-columns: 1fr; }
    .adj.next { grid-column: 1; }
    .adj :global(.mini) { width: 84px; }
  }

  /* ── Related ── */
  .related { max-width: 1180px; margin: 0 auto; padding: 16px 16px 72px; }
  @media (min-width: 900px) { .related { padding: 24px 40px 80px; } }
  .related .section-title { margin-bottom: 20px; }
  .related-board {
    display: grid;
    gap: 28px 24px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    padding: clamp(20px, 3vw, 36px);
    border: 8px solid var(--wood-dark);
    border-radius: var(--radius-xl);
    box-shadow: inset 0 0 40px rgb(0 0 0 / 0.5);
  }

  .lightbox { max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; margin: 0; padding: 24px; border: 0; background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(8 6 14 / 0.88); }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 48px); border-radius: var(--radius-md); box-shadow: 0 0 0 4px var(--gold), var(--shadow-lg); cursor: zoom-out; }
  .close { position: fixed; top: 16px; right: 16px; color: #fff; }
</style>
