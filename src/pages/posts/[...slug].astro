---
import Icon from '../../components/Icon.astro';
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import Thumbnail from '../../components/Thumbnail.astro';
import ReadCheck from '../../components/ReadCheck.astro';
import { getPosts, postUrl, tagUrl, url, formatDate, readingMinutes, relatedTo, type Post } from '../../lib/posts';
import { levelOf, xpOf } from '../../lib/quest';
import { SITE } from '../../site.config';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  const { level } = levelOf(posts);
  return posts.map((post, i) => {
    // 다음 기록: 태그·분류가 가까운 글 먼저, 나머지는 최신순으로 채운다
    const near = relatedTo(post, posts, 8);
    const upNext = [...near, ...posts.filter((p) => p.id !== post.id && !near.includes(p))].slice(0, 8);
    return {
      params: { slug: post.id },
      props: { post, level, newer: posts[i - 1], older: posts[i + 1], upNext, series: post.data.series ? posts.filter((p) => p.data.series === post.data.series).reverse() : [] },
    };
  });
}

interface Props { post: Post; level: number; newer?: Post; older?: Post; upNext: Post[]; series: Post[] }
const { post, level, newer, older, upNext, series } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, category, tags, cover } = post.data;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const og = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
const short = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' }).replace(/\s/g, '').replace(/\.$/, '');
---
<BaseLayout title={title} description={description} type="article" image={og}>
  <div class="progress" aria-hidden="true"><div class="bar" data-progress></div></div>
  <!-- 읽기 진행률 링: 몇 % 읽었고 몇 분 남았는지. 누르면 맨 위로 -->
  <button class="ring" type="button" data-ring data-minutes={readingMinutes(post.body)} aria-label="맨 위로">
    <svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="19" class="ring-track" /><circle cx="22" cy="22" r="19" class="ring-fill" data-ring-fill /></svg>
    <span class="ring-pct pixel-font" data-ring-pct>0%</span>
    <span class="ring-left" data-ring-left></span>
  </button>

  <div class="watch">
    <article class="primary">
      <nav aria-label="현재 위치" class="crumbs">
        <ol class="breadcrumb">
          <li><a href={url()}>개발 일지</a></li>
          <li class="sep" aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
          <li><a href={url(`?category=${encodeURIComponent(category)}`)}>{category}</a></li>
        </ol>
      </nav>

      <div class="player" data-reveal>
        <Thumbnail post={post} eager text={false} sizes="(min-width: 1400px) 900px, (min-width: 1024px) 65vw, 100vw" />
      </div>

      <h1 data-headline>{title}</h1>

      <div class="channel">
        <a class="owner" href={url('about/')}>
          <img class="avatar" src={url('images/jiny-avatar.webp')} alt="" width="42" height="42" />
          <span>
            <span class="name">{SITE.author}</span>
            <span class="role">Lv. {level} · Unreal Client Developer</span>
          </span>
        </a>
        <div class="actions">
          <button class="pill" type="button" data-bookmark={post.id} aria-pressed="false"><Icon name="bookmark" /><span data-bm-label>북마크</span></button>
          <button class="pill" type="button" data-share><Icon name="share-2" />공유</button>
        </div>
      </div>

      <div class="about-box" data-reveal>
        <p class="stats">
          <time datetime={date.toISOString()}>{short(date)}</time>
          {updated && <span>· {short(updated)} 수정</span>}
          <span>· {readingMinutes(post.body)}분 읽기</span>
          <span class="xp">· +{xpOf(post)} XP</span>
        </p>
        <p class="desc">{description}</p>
        {tags.length > 0 && <p class="tags">{tags.map((t) => <a href={tagUrl(t)}>#{t}</a>)}</p>}
      </div>

      {series.length > 1 && (
        <nav class="series" aria-label="연재">
          <p class="series-title"><Icon name="list-video" />{post.data.series}<span class="count">{series.findIndex((s) => s.id === post.id) + 1} / {series.length}</span></p>
          <ol>
            {series.map((s, i) => (
              <li class:list={{ current: s.id === post.id }}>
                <span class="n">{s.id === post.id ? '▶' : i + 1}</span>
                {s.id === post.id ? <span>{s.data.title}</span> : <a href={postUrl(s)}>{s.data.title}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )}

      {toc.length > 0 && (
        <details class="toc-inline">
          <summary><Icon name="list-tree" />목차</summary>
          <ul>{toc.map((h) => <li class:list={[`d${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </details>
      )}

      <div class="prose" data-prose>
        <Content />
      </div>

      <ReadCheck id={post.id} xp={xpOf(post)} />

      {(older || newer) && (
        <nav class="adjacent" aria-label="이전·다음 기록">
          {older ? (
            <a class="adj" href={postUrl(older)}>
              <span class="dir"><Icon name="arrow-left" />이전 기록</span>
              <span class="adj-title">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer && (
            <a class="adj next" href={postUrl(newer)}>
              <span class="dir">다음 기록<Icon name="arrow-right" /></span>
              <span class="adj-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}

      <Comments />
    </article>

    <aside class="secondary">
      {toc.length > 0 && <Toc headings={toc} />}
      {upNext.length > 0 && (
        <section aria-labelledby="upnext-title">
          <h2 class="upnext-title" id="upnext-title">다음 기록</h2>
          <ul class="upnext" data-reveal-group>
            {upNext.map((p) => (
              <li>
                <a class="mini" href={postUrl(p)}>
                  <Thumbnail post={p} text={false} duration sizes="168px" class="mini-thumb" />
                  <span class="mini-body">
                    <span class="mini-title">{p.data.title}</span>
                    <span class="mini-meta">{p.data.category}</span>
                    <span class="mini-meta">{short(p.data.date)} · {readingMinutes(p.body)}분 읽기</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="이미지 크게 보기">
    <img alt="" data-lightbox-img />
  </dialog>
</BaseLayout>

<script>
  import { headline, popIn, toast, revealEach } from '../../scripts/fx';
  import { wireBookmarks } from '../../scripts/bookmarks';
  import { icon } from '../../scripts/icons';

  headline(document.querySelector('[data-headline]'), 100);
  wireBookmarks();

  // 공유: 모바일은 시스템 공유 시트, 아니면 링크 복사
  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(location.href);
        toast('링크를 복사했어요', 'link');
      }
    } catch {
      /* 사용자가 공유 시트를 닫은 경우 */
    }
  });

  // 읽기 진행률
  const bar = document.querySelector<HTMLElement>('[data-progress]')!;
  const prose = document.querySelector<HTMLElement>('[data-prose]')!;
  const ring = document.querySelector<HTMLElement>('[data-ring]');
  const ringFill = document.querySelector<SVGCircleElement>('[data-ring-fill]');
  const ringPct = document.querySelector<HTMLElement>('[data-ring-pct]');
  const ringLeft = document.querySelector<HTMLElement>('[data-ring-left]');
  const minutes = Number(ring?.dataset.minutes ?? 1);
  ring?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  const onScroll = () => {
    const r = prose.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight * 0.6)));
    bar.style.transform = `scaleX(${p})`;
    // 링 둘레 = 2π·19 ≈ 119.4
    ringFill?.style.setProperty('stroke-dashoffset', String(119.4 * (1 - p)));
    if (ringPct) ringPct.textContent = `${Math.round(p * 100)}%`;
    if (ringLeft) ringLeft.textContent = p >= 0.99 ? '완독!' : `${Math.max(1, Math.ceil(minutes * (1 - p)))}분 남음`;
    ring?.classList.toggle('on', scrollY > 300);
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 스크롤 트리거: 본문 요소가 화면에 들어올 때 하나씩 떠오른다
  revealEach(prose.querySelectorAll(':scope > h2, :scope > h3, :scope > p > img, :scope > table, :scope > .callout, :scope > blockquote, :scope > details, :scope > pre'));

  // 본문 이미지 크게 보기
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const big = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  prose.querySelectorAll('img').forEach((img) =>
    img.addEventListener('click', () => {
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      box.showModal();
      popIn(big);
    }),
  );
  box.addEventListener('click', () => box.close());

  // 코드 블록: 언어 라벨 + 복사
  const COPY = icon('copy', 16);
  prose.querySelectorAll('pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre);
    const head = document.createElement('div');
    head.className = 'code-bar';
    const lang = pre.dataset.language;
    head.innerHTML = `<span class="dots"><i></i><i></i><i></i></span><span class="code-lang">${lang && lang !== 'plaintext' ? lang : 'text'}</span>`;
    const btn = document.createElement('button');
    btn.className = 'copy';
    btn.type = 'button';
    btn.setAttribute('aria-label', '코드 복사');
    btn.innerHTML = COPY;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      btn.innerHTML = icon('check', 16);
      setTimeout(() => (btn.innerHTML = COPY), 1500);
    });
    head.append(btn);
    wrap.prepend(head);
  });
</script>

<style>
  .ring { position: fixed; right: 20px; bottom: 24px; z-index: 30; display: grid; place-items: center; width: 58px; height: 58px; padding: 0; border: 0; border-radius: 50%; background: var(--card); box-shadow: 0 0 0 1px var(--border), var(--shadow-md); color: var(--foreground); cursor: pointer; opacity: 0; translate: 0 12px; pointer-events: none; transition: opacity 250ms, translate 250ms var(--ease-out); }
  .ring.on { opacity: 1; translate: 0 0; pointer-events: auto; }
  .ring svg { position: absolute; inset: 4px; rotate: -90deg; }
  .ring-track { fill: none; stroke: var(--muted); stroke-width: 3.5; }
  .ring-fill { fill: none; stroke: var(--mint); stroke-width: 3.5; stroke-linecap: round; stroke-dasharray: 119.4; stroke-dashoffset: 119.4; transition: stroke-dashoffset 120ms linear; }
  .ring-pct { position: relative; font-size: 11px; }
  .ring-left { position: absolute; right: 66px; white-space: nowrap; padding: 4px 9px; border-radius: 999px; background: var(--card); box-shadow: 0 0 0 1px var(--border); font-size: 12px; color: var(--muted-foreground); opacity: 0; transition: opacity 200ms; }
  .ring:hover .ring-left, .ring:focus-visible .ring-left { opacity: 1; }
  @media (max-width: 1023px) { .ring { right: 12px; bottom: calc(76px + env(safe-area-inset-bottom)); } }
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 40; pointer-events: none; }
  .bar { height: 100%; background: var(--brand); box-shadow: 0 0 10px var(--glow); transform: scaleX(0); transform-origin: left; }

  .watch { display: grid; gap: 32px; max-width: 1440px; margin: 0 auto; padding: 20px 16px 48px; }
  @media (min-width: 1024px) { .watch { padding: 28px 40px 64px; } }
  @media (min-width: 1200px) { .watch { grid-template-columns: minmax(0, 1fr) 360px; } }
  .primary { min-width: 0; }

  .crumbs { margin-bottom: 14px; }
  .player { border-radius: var(--radius-xl); overflow: hidden; box-shadow: 0 0 0 1px var(--border), var(--shadow-lg); }

  h1 { margin: 20px 0 14px; font-size: clamp(24px, 3vw, 32px); font-weight: 800; line-height: 1.3; letter-spacing: -0.03em; }

  .channel { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .owner { display: flex; align-items: center; gap: 12px; }
  .owner > span { display: flex; flex-direction: column; }
  .avatar { width: 42px; height: 42px; border-radius: 50%; box-shadow: 0 0 0 2px var(--brand); }
  .name { font-weight: 700; font-size: 15px; }
  .role { font-size: 12.5px; color: var(--muted-foreground); }
  .actions { display: flex; gap: 8px; }
  .pill { display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 16px; border: 0; border-radius: 999px; background: var(--secondary); color: var(--secondary-foreground); font: 600 14px/1 var(--font-sans); cursor: pointer; transition: background var(--dur); }
  .pill:hover { background: var(--accent); }
  .pill[aria-pressed='true'] { color: var(--brand); }

  .about-box { padding: 14px 16px; margin-bottom: 28px; border-radius: var(--radius-lg); background: var(--secondary); font-size: 14.5px; }
  .about-box p { margin: 0; }
  .stats { display: flex; flex-wrap: wrap; gap: 4px; font-weight: 700; }
  .stats .xp { color: var(--brand); }
  .desc { margin-top: 6px !important; line-height: 1.65; }
  .tags { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 8px !important; }
  .tags a { color: var(--brand); font-weight: 600; }
  .tags a:hover { text-decoration: underline; }

  .series { margin-bottom: 28px; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  .series-title { display: flex; align-items: center; gap: 8px; margin: 0; padding: 12px 16px; background: var(--secondary); font-weight: 700; }
  .series-title .icon { color: var(--brand); }
  .count { margin-left: auto; font: 500 12px var(--font-mono); color: var(--muted-foreground); }
  .series ol { list-style: none; margin: 0; padding: 6px; font-size: 14px; }
  .series li { display: flex; gap: 10px; padding: 8px 10px; border-radius: var(--radius-md); }
  .series li.current { background: var(--accent); font-weight: 700; }
  .series .n { width: 18px; color: var(--muted-foreground); text-align: center; }
  .series a:hover { color: var(--brand); }

  .toc-inline { margin-bottom: 24px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .toc-inline summary { display: flex; align-items: center; gap: 8px; font-weight: 700; cursor: pointer; }
  .toc-inline ul { list-style: none; margin: 10px 0 0; padding: 0; font-size: 14px; }
  .toc-inline li { padding: 4px 0; }
  .toc-inline .d3 { padding-left: 16px; }
  .toc-inline a { color: var(--muted-foreground); }
  @media (min-width: 1200px) { .toc-inline { display: none; } }

  .adjacent { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .adj { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); transition: border-color var(--dur), background var(--dur); }
  .adj:hover { border-color: var(--brand); background: var(--accent); }
  .dir { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; color: var(--muted-foreground); }
  .adj-title { font-weight: 700; line-height: 1.4; }
  .adj.next { grid-column: 2; text-align: right; align-items: flex-end; }
  @media (max-width: 599px) {
    .adjacent { grid-template-columns: 1fr; }
    .adj.next { grid-column: 1; }
  }

  /* ── 오른쪽 열 ── */
  .secondary { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  @media (min-width: 1200px) { .secondary > :global(.toc) { position: sticky; top: 24px; z-index: 1; } }
  @media (max-width: 1199px) { .secondary > :global(.toc) { display: none; } }
  .upnext-title { margin: 0 0 12px; font-size: 17px; font-weight: 700; }
  .upnext { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .mini { display: flex; gap: 10px; padding: 4px; border-radius: var(--radius-md); transition: background var(--dur); }
  .mini:hover { background: var(--accent); }
  .mini :global(.mini-thumb) { width: 168px; flex: none; border-radius: var(--radius-md); }
  .mini-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; padding-top: 2px; }
  .mini-title { font-size: 14px; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .mini-meta { font-size: 12.5px; color: var(--muted-foreground); }
  @media (max-width: 1199px) and (min-width: 640px) { .upnext { display: grid; grid-template-columns: 1fr 1fr; } }

  .lightbox { max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; margin: 0; padding: 24px; border: 0; background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(4 8 6 / 0.9); }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 48px); border-radius: var(--radius-md); cursor: zoom-out; }
</style>
