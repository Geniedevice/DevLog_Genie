---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Thumbnail from '../components/Thumbnail.astro';
import { getGames } from '../lib/games';
import { postUrl, readingMinutes } from '../lib/posts';
import { SITE } from '../site.config';

// 로블록스 게임 상세 화면처럼: 왼쪽 스크린샷 갤러리, 오른쪽 제목 · 제작자 · 큰 실행 버튼,
// 아래 소개 · 정보 줄 · 기록 목차, 맨 아래 다른 게임 타일. 타일을 고르면 위가 바뀐다.
// JS 가 없으면 게임 넷이 그냥 차례로 다 보인다(선택 UI 는 스크립트가 켤 때만).
const games = await getGames();

// 커버 말고 글 폴더에 있는 스크린샷(jpg)도 갤러리에. png 는 도식이라 뺀다.
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/content/posts/project-*/*.jpg', { eager: true });
const gallery = (id: string) =>
  Object.entries(shots)
    .filter(([path]) => path.includes(`/${id}/`) && !path.endsWith('/cover.jpg'))
    .map(([, m]) => m.default);

const items = await Promise.all(
  games.map(async (g) => ({
    g,
    shots: gallery(g.id),
    toc: (await render(g)).headings.filter((h) => h.depth === 2 && h.text !== '더 보기'),
  })),
);
const teamText = (n: number) => (n === 1 ? '개인' : `${n}인 팀`);
---
<BaseLayout title="프로젝트" active="projects" description="만든 게임 네 편 — EmberRoad, Gears of Deceit, Crawlescape, DESTINATION">
  <div class="page" data-stage-select>
    <header class="head">
      <h1>게임 프로젝트</h1>
      <p class="sub">직접 만든 게임 {games.length}편. <span class="keys"><kbd class="kbd">←</kbd><kbd class="kbd">→</kbd> 다른 게임 <kbd class="kbd">Enter</kbd> 기록 열기</span></p>
    </header>

    <div class="stages">
      {items.map(({ g, shots, toc }, i) => {
        const d = g.data.game;
        return (
          <section class="stage" data-stage={i} data-no={d.order} aria-labelledby={`stage-${i}`}>
            <div class="top">
              <div class="media">
                <div class="view">
                  <div class="shot" data-shot={0}><Thumbnail post={g} text={false} eager={i === 0} sizes="(min-width: 1000px) 60vw, 100vw" /></div>
                  {shots.map((s, k) => (
                    <div class="shot" data-shot={k + 1} hidden>
                      <Image src={s} alt={`${d.title} 스크린샷 ${k + 1}`} widths={[720, 1080, 1536].filter((w) => w <= s.width)} sizes="(min-width: 1000px) 60vw, 100vw" loading="lazy" />
                    </div>
                  ))}
                </div>
                {shots.length > 0 && (
                  <div class="strip" aria-label="스크린샷">
                    <button type="button" class="pick" aria-pressed="true" data-show={0} aria-label="1번째 이미지"><Thumbnail post={g} text={false} sizes="120px" /></button>
                    {shots.map((s, k) => (
                      <button type="button" class="pick" aria-pressed="false" data-show={k + 1} aria-label={`${k + 2}번째 이미지`}>
                        <Image src={s} alt="" widths={[240]} sizes="120px" loading="lazy" />
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <div class="panel">
                <h2 id={`stage-${i}`}>{d.title}</h2>
                <p class="by">By <a href={SITE.github} target="_blank" rel="noopener">@Geniedevice</a></p>
                <span class="badge badge-outline genre">{d.genre}</span>
                <a class="play" href={postUrl(g)} data-play><Icon name="play" size={30} stroke={2} fill /><span class="sr-only">{d.title} 기록 읽기</span></a>
                <div class="links">
                  <a href={d.portfolio} target="_blank" rel="noopener"><Icon name="briefcase" size={20} />포트폴리오</a>
                  {d.video && <a href={d.video} target="_blank" rel="noopener"><Icon name="clapperboard" size={20} />영상</a>}
                  {d.repo && <a href={d.repo} target="_blank" rel="noopener"><Icon name="code" size={20} />GitHub</a>}
                </div>
              </div>
            </div>

            <div class="about">
              <h3>소개</h3>
              <p class="tagline">{d.tagline}</p>
              <p class="desc">{g.data.description}</p>
              <p class="role"><strong>담당</strong> {d.role}</p>
              <ul class="stack">{d.stack.map((s) => <li class="badge badge-secondary">{s}</li>)}</ul>
            </div>

            <dl class="facts">
              <div><dt>팀 인원</dt><dd>{teamText(d.team)}</dd></div>
              <div><dt>기간</dt><dd>{d.period}</dd></div>
              <div><dt>엔진</dt><dd>{d.engine}</dd></div>
              <div><dt>기술</dt><dd>{d.stack.length}종</dd></div>
              <div><dt>분량</dt><dd>{readingMinutes(g.body)}분</dd></div>
            </dl>

            {toc.length > 0 && (
              <div class="log">
                <h3>개발 기록</h3>
                <ol>
                  {toc.map((h) => (
                    <li><a href={`${postUrl(g)}#${h.slug}`}><span>{h.text}</span><Icon name="chevron-right" size={16} /></a></li>
                  ))}
                </ol>
              </div>
            )}
          </section>
        );
      })}
    </div>

    <section class="more" aria-labelledby="more-title">
      <h3 id="more-title">게임 고르기</h3>
      <div class="tiles" role="tablist" aria-label="게임 선택">
        {games.map((g, i) => (
          <button class="tile" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pick={i}>
            <span class="tile-art"><Thumbnail post={g} text={false} sizes="240px" /></span>
            <span class="name">{g.data.game.title}</span>
            <span class="meta"><Icon name="users" size={14} />{teamText(g.data.game.team)}<Icon name="calendar" size={14} />{g.data.game.period.split(/[ –]/)[0]}</span>
          </button>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { animate, stagger } from 'animejs';
  import { reduced } from '../scripts/fx';
  import { sfx } from '../scripts/sfx';

  const root = document.querySelector<HTMLElement>('[data-stage-select]');
  if (root) {
    const stages = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
    const tiles = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    root.classList.add('enhanced');
    let current = -1;

    function select(i: number, withSound = true) {
      i = (i + stages.length) % stages.length;
      if (i === current) return;
      current = i;
      tiles.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      stages.forEach((s, k) => (s.hidden = k !== i));
      if (withSound) sfx('select');
      history.replaceState(null, '', `?stage=${stages[i].dataset.no}`);
      if (reduced() || !withSound) return;
      animate(stages[i].querySelectorAll('.view, .panel > *, .about, .facts, .log'), { opacity: [0, 1], translateY: [12, 0], duration: 450, delay: stagger(35), ease: 'outExpo' });
    }

    // 갤러리: 아래 작은 그림을 누르면 큰 화면이 바뀐다
    stages.forEach((stage) => {
      const views = [...stage.querySelectorAll<HTMLElement>('[data-shot]')];
      const picks = [...stage.querySelectorAll<HTMLButtonElement>('[data-show]')];
      picks.forEach((p) =>
        p.addEventListener('click', () => {
          const n = p.dataset.show;
          views.forEach((v) => (v.hidden = v.dataset.shot !== n));
          picks.forEach((q) => q.setAttribute('aria-pressed', String(q === p)));
          if (!reduced()) animate(stage.querySelector(`[data-shot="${n}"]`)!, { opacity: [0.3, 1], duration: 300, ease: 'outQuad' });
        }),
      );
    });

    tiles.forEach((t, i) => t.addEventListener('click', () => { select(i); stages[i].scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' }); }));
    addEventListener('keydown', (e) => {
      if ((e.target as Element).closest?.('input, textarea, select, dialog[open]')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); select(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); select(current - 1); }
      else if (e.key === 'Enter' && !(e.target as Element).closest?.('a, button')) { sfx('jump'); stages[current].querySelector<HTMLAnchorElement>('[data-play]')?.click(); }
    });

    // ?stage= 는 위치가 아니라 스테이지 번호(order)라, 정렬이 바뀌어도 링크가 같은 게임을 가리킨다
    const want = stages.findIndex((s) => s.dataset.no === new URLSearchParams(location.search).get('stage'));
    select(Math.max(want, 0), false);
  }
</script>

<style>
  .page { max-width: 1280px; margin: 0 auto; padding: 32px 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 40px 40px 80px; } }
  .head { margin-bottom: 26px; }
  h1 { margin: 0; font-size: clamp(30px, 4vw, 44px); font-weight: 900; letter-spacing: -0.02em; }
  .sub { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 8px 0 0; color: var(--muted-foreground); }
  .keys { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; }
  h3 { margin: 0 0 12px; font-size: 20px; font-weight: 800; }

  .stages { display: grid; gap: 56px; }
  .stage { display: grid; gap: 32px; scroll-margin-top: 24px; }
  :global(.enhanced) .stage[hidden] { display: none; }

  /* ── 위: 갤러리 + 실행 패널 ── */
  .top { display: grid; gap: 24px; align-items: start; }
  @media (min-width: 1000px) { .top { grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr); gap: 32px; } }
  .view { border-radius: var(--radius-lg); overflow: hidden; background: var(--muted); }
  .shot :global(img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .shot[hidden] { display: none; }
  .strip { display: none; gap: 8px; margin-top: 10px; overflow-x: auto; }
  :global(.enhanced) .strip { display: flex; }
  .pick { flex: 0 0 104px; padding: 0; border: 2px solid transparent; border-radius: var(--radius-sm); overflow: hidden; background: none; cursor: pointer; opacity: 0.6; transition: opacity var(--dur), border-color var(--dur); }
  .pick:hover { opacity: 0.9; }
  .pick[aria-pressed='true'] { opacity: 1; border-color: var(--foreground); }
  .pick :global(img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }

  .panel { display: flex; flex-direction: column; align-items: flex-start; }
  .panel h2 { margin: 0; font-size: clamp(28px, 3.2vw, 40px); font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; }
  .by { margin: 8px 0 0; font-size: 15px; color: var(--muted-foreground); }
  .by a { color: var(--foreground); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .genre { margin-top: 14px; }
  .play {
    display: grid;
    place-items: center;
    width: 100%;
    height: 64px;
    margin-top: 24px;
    border-radius: var(--radius-lg);
    background: var(--amber);
    color: var(--night);
    transition: filter var(--dur), transform var(--dur) var(--ease-out);
  }
  .play:hover { filter: brightness(1.08); }
  .play:active { transform: scale(0.98); }
  .links { display: flex; justify-content: space-around; width: 100%; margin-top: 14px; }
  .links a { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 12px; border-radius: var(--radius-md); font-size: 13px; color: var(--muted-foreground); text-decoration: none; }
  .links a:hover { background: var(--accent); color: var(--accent-foreground); }

  /* ── 소개 ── */
  .about > p { margin: 0; max-width: 72ch; }
  .tagline { font-size: 17px; font-weight: 700; }
  .desc { margin-top: 8px !important; color: var(--muted-foreground); }
  .role { margin-top: 14px !important; font-size: 14px; }
  .role strong { margin-right: 6px; color: var(--muted-foreground); font-weight: 600; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; padding: 0; }

  /* 로블록스의 Active · Visits · Server Size 줄: 작은 이름 위, 큰 값 아래 */
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); margin: 0; padding: 18px 0; border-block: 1px solid var(--border); }
  .facts div { padding: 4px 16px; text-align: center; }
  .facts div + div { border-left: 1px solid var(--border); }
  .facts dt { font-size: 13px; color: var(--muted-foreground); }
  .facts dd { margin: 6px 0 0; font-size: 17px; font-weight: 800; }
  @media (max-width: 639px) {
    .facts { grid-template-columns: repeat(2, 1fr); row-gap: 14px; }
    .facts div { text-align: left; padding: 0; }
    .facts div + div { border-left: 0; }
  }

  .log ol { list-style: none; display: grid; gap: 6px; margin: 0; padding: 0; }
  .log a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--card); color: var(--foreground); text-decoration: none; transition: border-color var(--dur), background var(--dur); }
  .log a:hover { border-color: var(--brand); background: var(--accent); }
  .log a :global(.icon) { flex: none; color: var(--muted-foreground); }

  /* ── 게임 고르기 타일 ── */
  .more { display: none; margin-top: 56px; }
  :global(.enhanced) .more { display: block; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(180px, 40vw), 1fr)); gap: 16px; }
  .tile { display: flex; flex-direction: column; gap: 4px; padding: 0; border: 0; background: none; color: var(--foreground); font: inherit; text-align: left; cursor: pointer; }
  .tile-art { display: block; border-radius: var(--radius-lg); overflow: hidden; outline: 3px solid transparent; outline-offset: 2px; transition: outline-color var(--dur); }
  .tile:hover .tile-art { outline-color: var(--border); }
  .tile[aria-selected='true'] .tile-art { outline-color: var(--brand); }
  .tile .name { margin-top: 6px; font-weight: 800; font-size: 15px; }
  .tile .meta { display: flex; align-items: center; gap: 4px; font-size: 12px; color: var(--muted-foreground); }
  .tile .meta :global(.icon:nth-of-type(2)) { margin-left: 8px; }
</style>
