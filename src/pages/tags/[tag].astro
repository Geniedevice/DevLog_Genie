---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPosts, tagCounts, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} active="tags">
  <div class="page">
    <a class="btn btn-text state back" href={url('tags/')}><span class="msr">arrow_back</span>모든 태그</a>
    <PageHeader title={`#${tag}`} subtitle={`${posts.length}편의 글`} icon="tag" />
    <ul class="list">
      {posts.map((p) => <PostListItem post={p} />)}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: 960px; margin: 0 auto; padding: 16px 16px 64px; }
  @media (min-width: 840px) { .page { padding: 16px 28px 64px; } }
  .back { margin-left: -12px; }
  .list { list-style: none; margin: 0 -16px; padding: 0; }
</style>
