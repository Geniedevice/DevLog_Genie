---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPosts, tagCounts, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} active="tags">
  <div class="page">
    <a class="btn btn-ghost btn-sm back" href={url('tags/')}><Icon name="arrow-left" />모든 태그</a>
    <PageHeader eyebrow="Tag" title={`#${tag}`} subtitle={`이 태그가 붙은 기록 ${posts.length}개`} />
    <ul class="list" data-reveal-group>
      {posts.map((p) => <PostListItem post={p} />)}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 24px 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 28px 40px 72px; } }
  .back { margin-left: -8px; }
  .list { list-style: none; margin: 0 -8px; padding: 0; display: grid; gap: 8px; }
</style>
