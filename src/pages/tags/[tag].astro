---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPosts, tagCounts, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} active="tags">
  <div class="page">
    <a class="btn btn-ghost btn-sm back" href={url('tags/')}><span class="msr">west</span>모든 각인</a>
    <PageHeader title={`#${tag}`} eyebrow="Rune" subtitle={`이 각인이 새겨진 의뢰 ${posts.length}건`} icon="diamond" />
    <ul class="list" data-reveal-group>
      {posts.map((p) => <PostListItem post={p} />)}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: 1000px; margin: 0 auto; padding: 8px 16px 72px; }
  @media (min-width: 900px) { .page { padding: 8px 40px 72px; } }
  .back { margin-left: -8px; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
</style>
