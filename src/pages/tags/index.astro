---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts, tagCounts, tagUrl } from '../../lib/posts';

const tags = tagCounts(await getPosts());
---
<BaseLayout title="태그" active="tags">
  <div class="page">
    <PageHeader eyebrow="Tags" title="태그" subtitle={`기록에 붙은 태그 ${tags.length}개`} />
    <ul class="cloud" data-reveal-group>
      {tags.map(([t, n]) => (
        <li><a class="tag" href={tagUrl(t)}><span class="hash">#</span>{t}<span class="n">{n}</span></a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 0 16px 72px; }
  @media (min-width: 1024px) { .page { padding: 0 40px 72px; } }
  .cloud { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .tag { display: inline-flex; align-items: center; gap: 4px; height: 40px; padding: 0 8px 0 14px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); font-weight: 600; transition: border-color var(--dur), background var(--dur), translate var(--dur); }
  .tag:hover { border-color: var(--brand); background: var(--accent); translate: 0 -2px; }
  .hash { color: var(--brand); }
  .n { display: inline-grid; place-items: center; min-width: 24px; height: 24px; margin-left: 6px; padding: 0 6px; border-radius: 999px; background: var(--secondary); color: var(--muted-foreground); font-size: 12px; }
</style>
